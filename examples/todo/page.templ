package main

import (
	"strconv"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/ui"
)

// Page is the view: a function of the state, rendered again after every
// event.
templ Page(a *App) {
	{{ surf.Autofocus(ctx, "draft") }}
	<main class="flex flex-col gap-4 p-4 max-w-md">
		<header class="flex items-center justify-between">
			<h1 class="text-lg font-semibold">Tasks</h1>
			@ui.Badge(ui.BadgeProps{Variant: ui.Secondary, Attrs: templ.Attributes{"id": "left"}}) {
				{ a.LeftText() }
			}
		</header>
		// A form's Submit hears Enter in its field and its submit button.
		<form class="flex gap-2" { surf.On(ctx, "add", surf.Submit(a.Add))... }>
			@ui.Input(ui.InputProps{
				Value:       a.Draft,
				Placeholder: "What needs doing?",
				Attrs:       surf.On(ctx, "draft", surf.Input(a.SetDraft)),
			})
			@ui.Button(ui.ButtonProps{Attrs: templ.Attributes{"type": "submit"}}) {
				@ui.Icon("plus", "")
				Add
			}
		</form>
		@ui.Tabs(ui.TabsProps{ID: "filter", Tabs: a.Tabs(), Value: a.Filter, OnChange: a.SetFilter}) {
			@taskList(a)
		}
		<footer class="flex items-center justify-between">
			<p class="text-sm text-muted-foreground">
				{ strconv.Itoa(a.DoneCount()) } done
			</p>
			@ui.Button(ui.ButtonProps{
				Variant:  ui.Outline,
				Size:     ui.Small,
				Disabled: a.DoneCount() == 0,
				Attrs:    surf.On(ctx, "clear", surf.Click(a.ClearDone)),
			}) {
				Clear done
			}
		</footer>
	</main>
}

templ taskList(a *App) {
	if tasks := a.Shown(); len(tasks) == 0 {
		@ui.Empty(ui.EmptyProps{}) {
			<header>
				<h3>Nothing here</h3>
				<p>No { a.Filter } tasks.</p>
			</header>
		}
	} else {
		@ui.ItemGroup(ui.ItemGroupProps{}) {
			for _, t := range tasks {
				@taskRow(a, t)
			}
		}
	}
}

templ taskRow(a *App, t Task) {
	@ui.Item(ui.ItemProps{Size: ui.XSmall}) {
		<section>
			@ui.Label(ui.LabelProps{Class: done(t)}) {
				@ui.Checkbox(ui.CheckboxProps{
					Checked: t.Done,
					Attrs:   surf.On(ctx, "task-"+strconv.Itoa(t.ID), surf.Check(func(c bool) { a.SetDone(t.ID, c) })),
				})
				{ t.Title }
			}
		</section>
		<aside>
			@ui.Button(ui.ButtonProps{
				Variant:  ui.Ghost,
				Size:     ui.Small,
				IconOnly: true,
				Attrs:    labelled(surf.On(ctx, "del-"+strconv.Itoa(t.ID), surf.Click(func() { a.Delete(t.ID) })), "Delete "+t.Title),
			}) {
				@ui.Icon("x", "")
			}
		</aside>
	}
}
