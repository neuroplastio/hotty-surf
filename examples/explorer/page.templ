package main

import (
	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/ui"
)

// Page is the view: a function of the state, rendered again after every
// event.
templ Page(a *App) {
	<main class="flex flex-col gap-3 p-4" { surf.On(ctx, "page", surf.Key(a.Shortcut))... }>
		<header class="flex items-center justify-between gap-3">
			@ui.Breadcrumb(ui.BreadcrumbProps{Items: a.trail(ctx)})
			@ui.InputGroup(ui.InputGroupProps{Class: "w-64"}) {
				@ui.Input(ui.InputProps{
					Type:        "search",
					Value:       a.Filter,
					Placeholder: "Filter",
					Attrs:       surf.On(ctx, "filter", surf.Input(a.SetFilter)),
				})
				@ui.InputGroupAddon(ui.InputGroupAddonProps{}) {
					@ui.Icon("search", "")
				}
			}
		</header>
		if rows := a.rows(); len(rows) > 0 {
			@ui.Table(ui.TableProps{}) {
				<thead>
					<tr>
						<th>
							@sortButton(a, "name", "Name")
						</th>
						<th class="col-size">
							@sortButton(a, "size", "Size")
						</th>
						<th class="col-date">
							@sortButton(a, "date", "Modified")
						</th>
						<th class="col-menu"><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					for _, e := range rows {
						<tr id={ "row-" + idOf(e) }>
							<td>
								if e.Dir {
									@ui.Button(ui.ButtonProps{
										Variant: ui.Ghost,
										Size:    ui.Small,
										Attrs:   surf.On(ctx, "open-"+idOf(e), surf.Click(func() { a.Open(e.Name) })),
									}) {
										@ui.Icon("folder", "")
										{ e.Name }
									}
								} else {
									<span class="flex items-center gap-2 px-3">
										@fileIcon()
										{ e.Name }
									</span>
								}
							</td>
							<td class="text-muted-foreground">{ sizeText(e) }</td>
							<td class="text-muted-foreground">{ e.Modified.Format("2006-01-02 15:04") }</td>
							<td>
								@ui.DropdownMenu(a.menu(e.ID), ui.DropdownMenuProps{
									ID:      "menu-" + idOf(e),
									Trigger: menuTrigger(e.Name),
									Items:   a.actions(e),
									Align:   "end",
								})
							</td>
						</tr>
					}
				</tbody>
			}
		} else {
			@ui.Empty(ui.EmptyProps{}) {
				<header>
					<figure>
						@ui.Icon("folder", "")
					</figure>
					<h3>Nothing here</h3>
					if a.Filter != "" {
						<p>No name in this folder holds “{ a.Filter }”.</p>
					} else {
						<p>This folder is empty.</p>
					}
				</header>
			}
		}
		@ui.Dialog(ui.DialogProps{
			ID:          "rename",
			Open:        a.renaming != 0,
			Title:       "Rename " + a.name(a.renaming),
			Description: "Its new name, in this folder.",
			OnClose:     a.Close,
		}) {
			<form class="flex flex-col gap-3" { surf.On(ctx, "rename-form", surf.Submit(a.Rename))... }>
				@ui.Input(ui.InputProps{
					Value:   a.draft,
					Invalid: a.renameErr != "",
					Attrs:   surf.On(ctx, "new-name", surf.Input(a.SetDraft)),
				})
				if a.renameErr != "" {
					<p class="text-sm text-destructive">{ a.renameErr }</p>
				}
				<footer>
					@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "rename-cancel", surf.Click(a.Close))}) {
						Cancel
					}
					@ui.Button(ui.ButtonProps{Attrs: templ.Attributes{"type": "submit"}}) {
						Rename
					}
				</footer>
			</form>
		}
		@ui.Dialog(ui.DialogProps{
			ID:          "delete",
			Open:        a.deleting != 0,
			Title:       "Delete " + a.name(a.deleting) + "?",
			Description: deleteNote(a.entry(a.deleting)),
			OnClose:     a.Close,
		}) {
			<footer>
				@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "delete-cancel", surf.Click(a.Close))}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{Variant: ui.Destructive, Attrs: surf.On(ctx, "delete-confirm", surf.Click(a.Delete))}) {
					Delete
				}
			</footer>
		}
		@ui.Dialog(ui.DialogProps{
			ID:          "copy",
			Open:        a.copying != 0,
			Title:       "Path of " + a.name(a.copying),
			Description: "Select it and copy it with your terminal's copy keys.",
			OnClose:     a.Close,
		}) {
			@ui.Input(ui.InputProps{
				Value: a.path(a.copying),
				Attrs: readonly(surf.On(ctx, "path")),
			})
			<footer>
				@ui.Button(ui.ButtonProps{Attrs: surf.On(ctx, "copy-done", surf.Click(a.Close))}) {
					Done
				}
			</footer>
		}
		@ui.Toaster(&a.toasts)
	</main>
}

templ sortButton(a *App, key, label string) {
	@ui.Button(ui.ButtonProps{
		Variant: ui.Ghost,
		Size:    ui.Small,
		Attrs:   surf.On(ctx, "sort-"+key, surf.Click(func() { a.SortBy(key) })),
	}) {
		{ label }
		if a.Sort == key && a.Desc {
			@ui.Icon("arrow-down", "")
		} else if a.Sort == key {
			@ui.Icon("arrow-up", "")
		}
	}
}

templ menuTrigger(name string) {
	@ui.Icon("ellipsis", "")
	<span class="sr-only">Actions for { name }</span>
}

// fileIcon is Lucide's file, which the kit's icons lack (ISC licence,
// lucide.dev).
templ fileIcon() {
	<svg class="file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
		<path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
	</svg>
}
