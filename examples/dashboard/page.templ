package main

import (
	"math"
	"strconv"

	"neuroplast.io/hotty-surf/ui"
)

// Page is the view: a function of the state, rendered again after every
// event. The range's tabs hold the whole dashboard as their panel.
templ Page(a *App) {
	<main class="flex flex-col gap-3 p-3">
		<h1 class="text-lg font-semibold">Little Kiln</h1>
		@ui.Tabs(ui.TabsProps{ID: "range", Tabs: a.tabs(), Value: a.Range, OnChange: a.SetRange}) {
			<div class="flex flex-col gap-3">
				<div class="flex gap-3">
					for _, s := range a.stats() {
						@statCard(s, a.since())
					}
				</div>
				<div class="flex gap-3">
					@ui.Card(ui.CardProps{Size: ui.Small, Class: "wide"}) {
						<header>
							<h2>Revenue</h2>
							<p>{ a.extremes() }</p>
						</header>
						<section>
							@ui.Chart(ui.ChartProps{
								Type:   "line",
								Labels: a.r.Labels,
								Series: []ui.ChartSeries{{Label: "Revenue", Values: a.r.Revenue}},
								Attrs:  templ.Attributes{"aria-label": "Revenue over time", "id": "revenue"},
							})
						</section>
					}
					@ui.Card(ui.CardProps{Size: ui.Small, Class: "mid"}) {
						<header>
							<h2>Orders by channel</h2>
							<p>
								for i, c := range channels {
									if i > 0 {
										{ " · " }
									}
									{ c } { thousands(int(a.r.Channels[i])) }
								}
							</p>
						</header>
						<section>
							@ui.Chart(ui.ChartProps{
								Labels: channels,
								Series: []ui.ChartSeries{{Label: "Orders", Values: a.r.Channels}},
								Attrs:  templ.Attributes{"aria-label": "Orders by channel", "id": "channels"},
							})
						</section>
					}
					@ui.Card(ui.CardProps{Size: ui.Small, Class: "wide"}) {
						<header><h2>Top products</h2></header>
						<section>
							@ui.Table(ui.TableProps{Attrs: templ.Attributes{"id": "products"}}) {
								<thead>
									<tr><th>Product</th><th>Sold</th><th>Revenue</th><th>Stock</th></tr>
								</thead>
								<tbody>
									for _, p := range a.r.Products {
										<tr>
											<td>{ p.Name }</td>
											<td>{ thousands(p.Sold) }</td>
											<td>{ dollars(p.Revenue) }</td>
											<td>
												<div class="flex items-center gap-2">
													@ui.Progress(ui.ProgressProps{
														Value: math.Round(float64(p.Stock) / float64(p.Capacity) * 100),
														Class: "stock",
														Attrs: templ.Attributes{"aria-label": p.Name + " stock"},
													})
													<span class="text-xs text-muted-foreground">{ strconv.Itoa(p.Stock) } left</span>
												</div>
											</td>
										</tr>
									}
								</tbody>
							}
						</section>
					}
				</div>
			</div>
		}
	</main>
}

// statCard is one number at the top, and how it changed.
templ statCard(s stat, since string) {
	@ui.Card(ui.CardProps{Size: ui.Small, Class: "flex-1"}) {
		<header>
			<p>{ s.Label }</p>
			<h2 class="text-xl">{ s.Value }</h2>
		</header>
		<section class="flex items-center gap-2">
			if s.Up {
				@ui.Badge(ui.BadgeProps{Variant: ui.Secondary}) {
					@ui.Icon("arrow-up", "")
					{ s.Change }
				}
			} else {
				@ui.Badge(ui.BadgeProps{Variant: ui.Destructive}) {
					@ui.Icon("arrow-down", "")
					{ s.Change }
				}
			}
			<span class="text-xs text-muted-foreground">{ since }</span>
		</section>
	}
}
