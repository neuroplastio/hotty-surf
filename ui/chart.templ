package ui

templ chart(p ChartProps) {
	{{ checkEnum(ctx, "Chart", "Kind", p.Kind, chartKinds) }}
	{{ checkChart(ctx, p) }}
	{{ checkAttrs(ctx, "Chart", p.Attrs, "class", "data-slot") }}
	<div data-slot="chart" class={ join("grid gap-2", p.Class) } { p.Attrs... }>
		<div class="chart">
			<svg class="size-full" viewBox="0 0 640 360" role="img" aria-label={ p.Label }>
				@chartPlot(p)
			</svg>
		</div>
		if p.Kind != "pie" && len(p.Labels) > 0 {
			<div class="flex text-xs text-muted-foreground" aria-hidden="true">
				for _, l := range p.Labels {
					<span class="flex-1 text-center">{ l }</span>
				}
			</div>
		}
		if p.Legend {
			<div class="chart-legend">
				for _, k := range chartKeys(p) {
					<span class="chart-legend-item">
						<span class="chart-legend-indicator" style={ k.Style }></span>
						{ k.Label }
					</span>
				}
			</div>
		}
	</div>
}
