package ui

templ chart(p ChartProps) {
	{{ checkEnum(ctx, "Chart", "Type", p.Type, chartTypes) }}
	{{ checkChart(ctx, p) }}
	{{ checkAttrs(ctx, "Chart", p.Attrs, "class", "data-slot", "role") }}
	<div data-slot="chart" role="figure" class={ join("grid gap-2", p.Class) } { p.Attrs... }>
		<div class="chart" style={ chartRatio(p) }>
			<svg class="size-full" viewBox={ chartBox(p) } aria-hidden="true">
				@chartPlot(p)
			</svg>
		</div>
		if p.Type != "pie" && len(p.Labels) > 0 {
			<div class="flex text-xs text-muted-foreground" style="min-width: 0; overflow: hidden;" aria-hidden="true">
				for _, l := range p.Labels {
					<span class="flex-1 text-center" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{ l }</span>
				}
			</div>
		}
		if p.Legend || p.Type == "pie" {
			<div class="chart-legend">
				for _, k := range chartKeys(p) {
					<span class="chart-legend-item">
						<span class="chart-legend-indicator" style={ k.Style }></span>
						{ k.Label }
					</span>
				}
			</div>
		}
	</div>
}
