// Package uiselect is hotty-surf's self-contained Select component, with
// explicit renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package uiselect

import (
	"context"
	_ "embed"
	"fmt"
	"slices"
	"strconv"
	"strings"
	"unicode/utf8"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/internal/rt"
	"neuroplast.io/hotty-surf/ui"
)

//go:embed chevron.svg
var chevronSVG string

//go:embed select.css
var css string

// Register registers select's assets with r.
func Register(r *ui.Registry) { r.CSS("select", css) }

// Align places the dropdown popover along its trigger.
type Align string

const (
	AlignStart  Align = "" // default (start)
	AlignCenter Align = "center"
	AlignEnd    Align = "end"
)

// Item is an option in a Select. Consecutive items with the same Group are
// shown under its heading with separators between groups. Values must be
// unique; labels may repeat.
type Item struct {
	Value    string
	Label    string
	Group    string
	Disabled bool
}

// State is what a Select remembers between renders: whether its list is open
// and which enabled item is highlighted. The zero value is closed.
type State struct {
	open    bool
	active  int
	focus   bool
	focusAt uint64
}

// Props configures a Select component.
type Props struct {
	ID             string
	Items          []Item
	Value          string
	Multiple       bool
	Values         []string
	CloseOnSelect  bool
	Align          Align
	Placeholder    string
	Disabled       bool
	Keys           ui.KeyMap
	OnChange       func(value string)
	OnValuesChange func(values []string)
	Class          string
}

// View dispatches to Hotty or TUI according to ui.ModeOf(ctx).
templ View(st *State, p Props) {
	switch ui.ModeOf(ctx) {
	case ui.ModeHotty:
		@Hotty(st, p)
	default:
		@TUI(st, p)
	}
}

// Hotty renders Basecoat's custom select dropdown for a hotty host.
templ Hotty(st *State, p Props) {
	@selectBox(newSelectView(ctx, st, p), false)
}

// TUI renders the select for cells.Screen, styled like a TUI outline button
// with a single dropdown chevron.
templ TUI(st *State, p Props) {
	@selectBox(newSelectView(ctx, st, p), true)
}

templ selectBox(v *selectView, tui bool) {
	{{ v.join(ctx) }}
	<div
		class={ ui.JoinClass("select", v.p.Class) }
		data-select-initialized="true"
		if tui {
			data-mode="tui"
		}
		{ ui.MergeAttrs(
			v.rootAttrs(ctx),
			ui.OptAttr("data-placeholder", v.p.Placeholder),
			ui.OptAttr("data-close-on-select", v.p.Multiple && v.p.CloseOnSelect),
		)... }
	>
		<button
			type="button"
			if tui {
				class="btn"
				data-variant="secondary"
				data-mode="tui"
				data-min-w={ strconv.Itoa(v.maxLabelWidth()) }
			} else {
				style={ v.hottyTriggerStyle() }
			}
			aria-haspopup="listbox"
			aria-expanded={ bstr(v.st.open) }
			aria-controls={ v.id + "-listbox" }
			if i := v.activeOpt(); i >= 0 {
				aria-activedescendant={ v.opts[i].id }
			}
			disabled?={ v.p.Disabled }
			{ ui.ScopeAttrs(ctx, ui.KitOn(ctx, v.id+"-trigger", surf.Click(v.toggle), surf.Key(v.key, v.triggerKeys()...)))... }
		>
			{{ label, muted := v.label() }}
			<span class={ "truncate", templ.KV("text-muted-foreground", muted) }>{ label }</span>
			if !tui {
				@templ.Raw(chevronSVG)
			}
		</button>
		<div
			id={ v.id + "-popover" }
			data-popover
			if tui {
				data-mode="tui"
			}
			aria-hidden={ bstr(!v.st.open) }
			{ ui.OptAttr("data-align", v.p.Align)... }
		>
			<div
				role="listbox"
				aria-orientation="vertical"
				if v.p.Multiple {
					aria-multiselectable="true"
				}
				aria-labelledby={ v.id + "-trigger" }
				id={ v.id + "-listbox" }
			>
				for _, e := range v.entries {
					switch e.kind {
						case entryOpt:
							@selectOption(v, e.opt)
						case entryGroup:
							<div role="group" aria-labelledby={ e.labelID }>
								<div role="heading" id={ e.labelID } if tui { class="text-muted-foreground" }>{ e.group }</div>
								for _, i := range e.opts {
									@selectOption(v, i)
								}
							</div>
						case entrySeparator:
							<hr role="separator"/>
					}
				}
			</div>
		</div>
		<input type="hidden" name={ v.id + "-value" } value={ v.value() }/>
		if v.refocus() {
			{{ surf.Autofocus(ctx, v.id+"-trigger") }}
		}
	</div>
}

templ selectOption(v *selectView, i int) {
	{{ o := v.opts[i] }}
	<div
		role="option"
		data-value={ o.value }
		{ ui.MergeAttrs(
			ui.OptAttr("aria-selected", v.selected(i)),
			ui.OptAttr("aria-disabled", o.disabled),
		)... }
		if i == v.activeOpt() {
			class="active"
		}
		if o.disabled {
			id={ o.id }
		} else {
			{ surf.On(ctx, o.id, surf.Click(func() { v.choose(i) }), surf.Hover(v.hover(i)))... }
		}
	>{ o.label }</div>
}

type entryKind uint8

const (
	entryOpt entryKind = iota
	entryGroup
	entrySeparator
)

type listEntry struct {
	kind    entryKind
	opt     int
	group   string
	labelID string
	opts    []int
}

type listOpt struct {
	id       string
	value    string
	label    string
	disabled bool
}

type selectView struct {
	st      *State
	p       Props
	id      string
	entries []listEntry
	opts    []listOpt
	enabled []int
	chosen  int
	keys    ui.ResolvedKeys
	n       uint64
	popups  *ui.Popup
}

func newSelectView(ctx context.Context, st *State, p Props) *selectView {
	id := p.ID
	if id == "" {
		id = "select"
	}
	keys := ui.ResolveKeys(ctx, p.Keys, ui.ActOpen, ui.ActDown, ui.ActUp, ui.ActFirst, ui.ActLast, ui.ActConfirm, ui.ActCancel)
	v := &selectView{st: st, p: p, id: id, chosen: -1, keys: keys}
	v.entries, v.opts = grouped(v.id+"-items", p.Items)
	for i, o := range v.opts {
		if v.chosen < 0 && v.selected(i) {
			v.chosen = i
		}
		if o.disabled {
			continue
		}
		v.enabled = append(v.enabled, i)
	}
	if !st.open || st.active >= len(v.enabled) {
		st.active = -1
	}
	if p.Disabled {
		st.open, st.active = false, -1
	}
	return v
}

func grouped(prefix string, items []Item) ([]listEntry, []listOpt) {
	var (
		entries []listEntry
		opts    []listOpt
	)
	for i := 0; i < len(items); {
		g := items[i].Group
		if len(entries) > 0 && (g != "" || entries[len(entries)-1].kind == entryGroup) {
			entries = append(entries, listEntry{kind: entrySeparator})
		}
		at := prefix + "-" + strconv.Itoa(len(entries)+1)
		if g == "" {
			it := items[i]
			opts = append(opts, listOpt{id: at, value: it.Value, label: it.Label, disabled: it.Disabled})
			entries = append(entries, listEntry{kind: entryOpt, opt: len(opts) - 1})
			i++
			continue
		}
		e := listEntry{kind: entryGroup, group: g, labelID: "group-label-" + at}
		for m := 1; i < len(items) && items[i].Group == g; i, m = i+1, m+1 {
			it := items[i]
			opts = append(opts, listOpt{id: at + "-" + strconv.Itoa(m), value: it.Value, label: it.Label, disabled: it.Disabled})
			e.opts = append(e.opts, len(opts)-1)
		}
		entries = append(entries, e)
	}
	return entries, opts
}

func (v *selectView) join(ctx context.Context) string {
	values := map[string]bool{}
	for _, item := range v.p.Items {
		if values[item.Value] {
			rt.Fault(ctx, fmt.Sprintf("uiselect.View: duplicate item value %q", item.Value))
		}
		values[item.Value] = true
	}
	selected := v.p.Values
	if !v.p.Multiple {
		if v.p.Value != "" {
			selected = []string{v.p.Value}
		} else {
			selected = nil
		}
	}
	seen := map[string]bool{}
	for _, value := range selected {
		if !values[value] || seen[value] {
			rt.Fault(ctx, fmt.Sprintf("uiselect.View: selected value %q is absent or repeated", value))
		}
		seen[value] = true
	}
	if f := rt.From(ctx); f != nil {
		v.n = f.N()
	}
	v.popups = ui.Popups(ctx)
	v.popups.Track(ctx, v.st, v.id, v.st.open, v.shut)
	return ""
}

func (v *selectView) shut() { v.st.open, v.st.active = false, -1 }

func (v *selectView) triggerKeys() []string {
	if v.st.open {
		return v.keys.Declare(ui.ActDown, ui.ActUp, ui.ActFirst, ui.ActLast, ui.ActConfirm, ui.ActCancel)
	}
	return v.keys.Declare(ui.ActOpen, ui.ActDown, ui.ActUp, ui.ActFirst, ui.ActLast)
}

func (v *selectView) pos(i int) int {
	for k, j := range v.enabled {
		if j == i {
			return k
		}
	}
	return -1
}

func (v *selectView) activeOpt() int {
	if !v.st.open || v.st.active < 0 {
		return -1
	}
	return v.enabled[v.st.active]
}

func (v *selectView) label() (string, bool) {
	if v.p.Multiple {
		var labels []string
		for i := range v.opts {
			if v.selected(i) {
				labels = append(labels, v.opts[i].label)
			}
		}
		if len(labels) > 0 {
			return strings.Join(labels, ", "), false
		}
		return v.p.Placeholder, v.p.Placeholder != ""
	}
	if v.chosen >= 0 {
		return v.opts[v.chosen].label, false
	}
	return v.p.Placeholder, v.p.Placeholder != ""
}

func (v *selectView) value() string {
	if v.p.Multiple {
		var b strings.Builder
		b.WriteByte('[')
		first := true
		for i := range v.opts {
			if v.selected(i) {
				if !first {
					b.WriteByte(',')
				}
				b.WriteString(strconv.Quote(v.opts[i].value))
				first = false
			}
		}
		b.WriteByte(']')
		return b.String()
	}
	if v.chosen >= 0 {
		return v.opts[v.chosen].value
	}
	return ""
}

func (v *selectView) selected(i int) bool {
	if v.p.Multiple {
		return slices.Contains(v.p.Values, v.opts[i].value)
	}
	return v.p.Value != "" && v.opts[i].value == v.p.Value
}

func (v *selectView) open() {
	v.st.open = true
	v.st.active = v.pos(v.chosen)
	v.popups.Opened(v.st, v.shut)
}

func (v *selectView) close(focus bool) {
	if !v.st.open {
		return
	}
	if focus {
		v.ask()
	}
	v.st.open, v.st.active = false, -1
	v.popups.Closed(v.st)
}

func (v *selectView) toggle() {
	if v.st.open {
		v.close(true)
	} else {
		v.open()
	}
}

func (v *selectView) outside() { v.close(false) }

func (v *selectView) rootAttrs(ctx context.Context) templ.Attributes {
	if !v.st.open {
		return templ.Attributes{"id": v.id}
	}
	return surf.On(ctx, v.id, surf.Outside(v.outside))
}

func (v *selectView) choose(i int) {
	o := v.opts[i]
	if v.p.Multiple {
		values := make([]string, 0)
		for j := range v.opts {
			selected := v.selected(j)
			if j == i {
				selected = !selected
			}
			if selected {
				values = append(values, v.opts[j].value)
			}
		}
		if v.p.OnValuesChange != nil {
			v.p.OnValuesChange(values)
		}
		if v.p.CloseOnSelect {
			v.close(true)
		} else {
			v.st.active = v.pos(i)
			v.ask()
		}
		return
	}
	if v.p.OnChange != nil {
		if v.p.Placeholder != "" && o.value == "" {
			v.p.OnChange("")
		} else if v.value() != o.value {
			v.p.OnChange(o.value)
		}
	}
	v.close(true)
	v.ask()
}

func (v *selectView) ask() { v.st.focus, v.st.focusAt = true, v.n+1 }

func (v *selectView) key(k string) bool {
	act, ok := v.keys.Match(k)
	if !ok {
		return false
	}
	if !v.st.open {
		if act == ui.ActConfirm || act == ui.ActCancel {
			return false
		}
		v.open()
		return true
	}
	switch act {
	case ui.ActCancel:
		v.close(true)
		return true
	case ui.ActConfirm:
		if i := v.activeOpt(); i >= 0 {
			v.choose(i)
		}
		return true
	case ui.ActOpen:
		return true
	}
	n := len(v.enabled)
	if n == 0 {
		return true
	}
	cur := v.st.active
	next := cur
	switch act {
	case ui.ActDown:
		if cur < n-1 {
			next = cur + 1
		}
	case ui.ActUp:
		next = max(cur-1, 0)
	case ui.ActFirst:
		next = 0
	case ui.ActLast:
		next = n - 1
	}
	v.st.active = next
	return true
}

func (v *selectView) hover(i int) func(bool) {
	return func(over bool) {
		if over && v.st.open {
			v.st.active = v.pos(i)
		}
	}
}

func (v *selectView) refocus() bool {
	ok := v.st.focus && (v.st.focusAt == 0 || v.st.focusAt == v.n)
	v.st.focus = false
	return ok
}

func (v *selectView) maxLabelWidth() int {
	w := utf8.RuneCountInString(v.p.Placeholder)
	for _, o := range v.opts {
		if n := utf8.RuneCountInString(o.label); n > w {
			w = n
		}
	}
	return w
}

func (v *selectView) hottyTriggerStyle() string {
	w := v.maxLabelWidth()
	if w <= 0 {
		return ""
	}
	return fmt.Sprintf("min-width: calc(%dch + 2.75rem);", w)
}

func bstr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
