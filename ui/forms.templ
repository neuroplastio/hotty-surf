package ui

import "strings"

// fieldSeparator writes the separator, with its children (rendered) in a
// span, or none: an empty span would cut a gap in the line.
templ fieldSeparator(p FieldSeparatorProps, word string) {
	{{ checkAttrs(ctx, "FieldSeparator", p.Attrs, "class", "data-slot") }}
	<div data-slot="field-separator" class={ join("field-separator", p.Class) } { p.Attrs... }>
		<hr role="separator"/>
		if strings.TrimSpace(word) != "" {
			<span>
				@templ.Raw(word)
			</span>
		}
	</div>
}
