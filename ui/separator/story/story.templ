// Package story provides the storybook showcase for ui/separator.
package story

import (
	"neuroplast.io/hotty-surf/internal/story"
	"neuroplast.io/hotty-surf/ui/separator"
)

// Props is the editable state for the Separator storybook controls.
type Props struct {
	Orientation string `enum:"horizontal,vertical"`
}

// Register adds separator's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "separator/default",
		Doc:          "A horizontal or vertical separator",
		Consolidated: true,
		Score:        4,
		BookOnly:     true,
		View:         func() templ.Component { return showcase(&Props{Orientation: "vertical"}) },
		Props: func() (any, templ.Component) {
			p := &Props{Orientation: "vertical"}
			return p, showcase(p)
		},
	})
}

templ showcase(p *Props) {
	<div class="flex flex-col gap-4 p-4">
		<div class="flex flex-col gap-2 w-60 text-sm">
			<span class="text-xs text-muted-foreground">Horizontal</span>
			<span>Blog</span>
			@separator.View(separator.Props{Orientation: separator.Horizontal, Decorative: true})
			<span>Docs</span>
			@separator.View(separator.Props{Orientation: separator.Horizontal, Decorative: true})
			<span>Source</span>
		</div>
		<div class="flex flex-col gap-2 text-sm">
			<span class="text-xs text-muted-foreground">Vertical</span>
			<div class="flex h-6 items-center gap-3">
				<span>Blog</span>
				@separator.View(separator.Props{Orientation: separator.Vertical, Decorative: true})
				<span>Docs</span>
				@separator.View(separator.Props{Orientation: separator.Vertical, Decorative: true})
				<span>Source</span>
			</div>
		</div>
	</div>
}
