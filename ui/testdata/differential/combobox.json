{
 "component": "combobox",
 "macro": "combobox",
 "scripts": [
  "combobox.js"
 ],
 "events": [
  "change"
 ],
 "ready": "[data-combobox-initialized]",
 "drop": [
  "div@data-combobox-initialized",
  "div@data-basecoat-component",
  "input#fruit-input@value",
  "button#fruit-chip-0@id",
  "button#fruit-chip-1@id"
 ],
 "why": "Basecoat marks initialization, and the surface writes the live input value while the browser holds it as a property. The surface names each chip button for its handlers; the script does not.",
 "cases": [
  {
   "name": "search-and-select",
   "args": {
    "id": "fruit",
    "name": "fruit-value",
    "placeholder": "Choose fruit",
    "input_attrs": {
     "id": "fruit-input"
    }
   },
   "caller": "<div role=\"option\" id=\"fruit-items-1\" data-value=\"a\">Apple</div><div role=\"option\" id=\"fruit-items-2\" data-value=\"b\">Banana</div><div role=\"option\" id=\"fruit-items-3\" data-value=\"c\">Cherry</div>",
   "root": "#fruit",
   "steps": [
    {
     "click": "fruit-input"
    },
    {
     "type": "ba"
    },
    {
     "key": "arrow_down"
    },
    {
     "key": "enter"
    }
   ]
  },
  {
   "name": "multiple",
   "args": {
    "id": "fruit",
    "name": "fruit-value",
    "placeholder": "Choose fruit",
    "input_attrs": {
     "id": "fruit-input"
    },
    "multiple": true
   },
   "caller": "<div role=\"option\" id=\"fruit-items-1\" data-value=\"a\">Apple</div><div role=\"option\" id=\"fruit-items-2\" data-value=\"b\">Banana</div><div role=\"option\" id=\"fruit-items-3\" data-value=\"c\">Cherry</div>",
   "root": "#fruit",
   "steps": [
    {
     "click": "fruit-input"
    },
    {
     "key": "arrow_down"
    },
    {
     "key": "enter"
    },
    {
     "key": "arrow_down"
    },
    {
     "key": "enter"
    },
    {
     "key": "backspace"
    }
   ]
  }
 ]
}
