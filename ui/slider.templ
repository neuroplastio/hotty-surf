package ui

templ slider(v sliderView) {
 {{ v.init(ctx) }}
 <div class={ join("hotty-slider",v.p.Class) } data-hotty-slider="" { v.track(ctx)... }>
  <span class="hotty-slider-rail"></span>
  <span class="hotty-slider-fill" style={ sliderStyle(v.percent(v.lo),v.percent(v.hi)-v.percent(v.lo)) }></span>
  for i := 0; i <= v.count(); i++ {
   {{ lo := max(0.0,(float64(i)-0.5)/float64(v.count()))*100 }}
   {{ hi := min(1.0,(float64(i)+0.5)/float64(v.count()))*100 }}
   <span class="hotty-slider-notch" style={ sliderStyle(lo,hi-lo) } { v.notch(ctx,i)... }></span>
  }
  if v.ranged {
   @sliderThumb(&v,0,v.lo,v.p.Min,v.hi,v.p.Label+", start")
  }
  @sliderThumb(&v,1,v.hi,v.lo,v.p.Max,v.endLabel())
 </div>
}

templ sliderThumb(v *sliderView, k int, value, low, high float64, label string) {
 <button type="button" class="hotty-slider-thumb" role="slider"
  aria-label={ label }
  aria-valuemin={ sliderNum(low) }
  aria-valuemax={ sliderNum(high) }
  aria-valuenow={ sliderNum(value) }
  if v.p.Disabled {
   disabled
  }
  style={ sliderLeft(v.percent(value)) }
  { v.thumb(ctx,k)... }></button>
}
