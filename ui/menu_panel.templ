package ui

// Menu's markup: a DropdownMenu's popover and items
// (dropdown-menu.html.jinja's, Basecoat 1.1.0, MIT; NOTICE.md), shown, with
// no button.

templ menuPanel(v *menuView) {
	{{ v.panelCheck(ctx) }}
	{{ v.panelFrame(ctx) }}
	<div class={ join("dropdown-menu menu-panel", v.p.Class) } id={ v.id }>
		<div id={ v.id + "-popover" } data-popover aria-hidden="false">
			<div
				role="menu"
				tabindex="0"
				if o := v.activeOpt(); o >= 0 {
					aria-activedescendant={ v.opts[o].id }
				}
				{ v.panelAttrs(ctx)... }
			>
				for _, e := range v.entries {
					switch e.kind {
						case entryOpt:
							@menuItem(v, e.opt)
						case entryGroup:
							<div role="group" aria-labelledby={ e.labelID }>
								<div role="heading" id={ e.labelID }>{ e.group }</div>
								for _, o := range e.opts {
									@menuItem(v, o)
								}
							</div>
						case entrySeparator:
							<hr role="separator"/>
					}
				}
			</div>
		</div>
	</div>
}
