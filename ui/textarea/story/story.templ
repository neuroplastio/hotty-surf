// Package story provides the storybook showcase for ui/textarea.
package story

import (
	"neuroplast.io/hotty-surf/internal/story"
	"neuroplast.io/hotty-surf/ui/textarea"
)

type state struct {
	text string
}

// Register adds textarea's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "textarea/default",
		Doc:          "Resizable textarea (both, vertical, none) and disabled state",
		Consolidated: true,
		Score:        4,
		View:         func() templ.Component { return showcase(&state{}) },
		Keys:         []string{"tab", "h", "i"},
		Want:         "message: hi",
	})
}

templ showcase(s *state) {
	<div class="flex flex-col gap-4 p-4">
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted-foreground">both + auto-grow (20–60 cols, 2–8 rows)</span>
			@textarea.View(textarea.Props{ID: "message", Value: s.text, Placeholder: "Type multiple lines to auto-grow up to 8 rows...", Rows: 3, MinCols: 20, MaxCols: 60, MinRows: 2, MaxRows: 8, AutoGrow: true, OnInput: func(v string) { s.text = v }})
			<p class="text-sm text-muted-foreground">message: { s.text }</p>
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted-foreground">vertical</span>
			@textarea.View(textarea.Props{ID: "ta-vertical", Placeholder: "Vertical resize only", Rows: 3, Resize: textarea.ResizeVertical})
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted-foreground">none</span>
			@textarea.View(textarea.Props{ID: "ta-none", Placeholder: "Fixed size", Rows: 2, Resize: textarea.ResizeNone})
		</div>
		<div class="flex flex-col gap-1">
			<span class="text-xs text-muted-foreground">disabled</span>
			@textarea.View(textarea.Props{ID: "ta-disabled", Placeholder: "Disabled textarea", Rows: 2, Disabled: true})
		</div>
	</div>
}
