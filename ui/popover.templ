package ui

// Popover's markup: popover.html.jinja's (Basecoat 1.1.0, MIT; NOTICE.md),
// written in templ as the macro renders it for the Props, with what
// popover.js sets on it from PopoverState.

import "neuroplast.io/hotty-surf"

templ popover(v *popoverView) {
	{{ v.start(ctx) }}
	<div class={ join("popover", v.p.Class) } data-popover-initialized="true" { v.rootAttrs(ctx)... }>
		<button
			type="button"
			aria-expanded={ bstr(v.st.open) }
			aria-controls={ v.id + "-popover" }
			class="btn"
			data-variant="outline"
			{ scopeAttrs(ctx, surf.On(ctx, v.id+"-trigger", surf.Click(v.toggle)))... }
		>
			if v.p.Trigger != nil {
				@plain(v.p.Trigger)
			}
		</button>
		<div
			id={ v.id + "-popover" }
			data-popover
			aria-hidden={ bstr(!v.st.open) }
			if v.p.Side != "" {
				data-side={ v.p.Side }
			}
			if v.p.Align != "" {
				data-align={ v.p.Align }
			}
		>
			{ children... }
		</div>
		if v.refocus() {
			{{ surf.Autofocus(ctx, v.id+"-trigger") }}
		}
	</div>
}
