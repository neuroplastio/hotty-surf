package ui

import (
	"strconv"

	"neuroplast.io/hotty-surf"
)

// Controls is a grid of labelled controls. It shows each of Controls
// using its Kind; an edit calls OnChange with its Name and new text
// value. The app stores that value and supplies it on the next render.
// OnChange is required when a control is edited. Unknown kinds render as
// text fields; a bool is checked exactly when its value is "true".
templ Controls(p ControlsProps) {
	<div class={ join("kit-controls grid grid-cols-[minmax(0,auto)_minmax(0,1fr)] items-center gap-x-3 gap-y-2 text-sm", p.Class) }>
		for _, c := range p.Controls {
			<label class="text-muted-foreground truncate font-mono text-xs" for={ controlID(p.ID, c.Name) }>{ c.Name }</label>
			@control(p.ID, c, p.OnChange)
		}
	</div>
}

templ control(id string, c Control, set func(name, value string)) {
	switch c.Kind {
		case "bool":
			<div>
				<input type="checkbox" role="switch" checked?={ c.Value == "true" } { surf.On(ctx, controlID(id, c.Name), surf.Check(func(v bool) { set(c.Name, strconv.FormatBool(v)) }))... }/>
			</div>
		case "enum":
			<select class="select h-8 w-full max-w-60 text-sm" { surf.On(ctx, controlID(id, c.Name), surf.Input(func(v string) { set(c.Name, v) }))... }>
				for _, o := range c.Options {
					<option value={ o } selected?={ o == c.Value }>{ o }</option>
				}
			</select>
		default:
			<input type="text" class="input h-8 w-full max-w-80 text-sm" value={ c.Value } { surf.On(ctx, controlID(id, c.Name), surf.Input(func(v string) { set(c.Name, v) }))... }/>
	}
}

// EventLog shows entries newest first with their time, kind and text.
// When there are entries it shows their count and, if OnClear is set,
// a Clear button. When there are none it shows Empty. It does not own
// or clear the input slice.
templ EventLog(p EventLogProps) {
	{{ id, entries, onClear, empty := p.ID, p.Entries, p.OnClear, p.Empty }}
	if len(entries) == 0 {
		<p class="text-muted-foreground text-sm italic">{ empty }</p>
	} else {
		<div class="kit-event-log-header mb-2 flex items-center">
			<span class="text-muted-foreground text-xs">{ plural(len(entries), "event", "events") }, the newest first</span>
			if onClear != nil {
				<button type="button" class="btn ml-auto" data-variant="ghost" data-size="xs" { surf.On(ctx, id+"-clear", surf.Click(onClear))... }>Clear</button>
			}
		</div>
		<ol class="flex flex-col gap-1 font-mono text-xs">
			for i := len(entries) - 1; i >= 0; i-- {
				<li class="flex gap-2">
					<span class="text-muted-foreground shrink-0">{ entries[i].At.Format("15:04:05.000") }</span>
					<span class={ join("shrink-0", logKindClass(entries[i].KindClass)) }>{ entries[i].Kind }</span>
					<span class="min-w-0 break-words">{ entries[i].Text }</span>
				</li>
			}
		</ol>
	}
}
