// Package story provides the storybook showcase for ui/label.
package story

import (
	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/internal/story"
	"neuroplast.io/hotty-surf/ui"
	"neuroplast.io/hotty-surf/ui/label"
	"neuroplast.io/hotty-surf/ui/tooltip"
)

type state struct {
	text string
}

// Register adds label's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "label/default",
		Doc:          "Labels paired with enabled and disabled inputs",
		Consolidated: true,
		Score:        5,
		View:         func() templ.Component { return showcase(&state{}) },
	})
}

templ showcase(s *state) {
	<div class="flex flex-col gap-4 p-4 max-w-sm">
		<div class="flex flex-col gap-2">
			<div class="flex items-center gap-2">
				@label.View(label.Props{For: "username"}) {
					Username
				}
				@tooltip.View(tooltip.Props{Text: "Lowercase letters, numbers, and hyphens only", Side: tooltip.Right}) {
					<span class="text-muted-foreground">
						@ui.Icon("circle-help", "size-4")
					</span>
				}
			</div>
			@ui.Input(ui.InputProps{Value: s.text, Attrs: surf.On(ctx, "username", surf.Input(func(v string) { s.text = v }))})
		</div>
		@ui.Field(ui.FieldProps{Disabled: true}) {
			@label.View(label.Props{For: "username-disabled"}) {
				Disabled username
			}
			@ui.Input(ui.InputProps{Value: "ada", Disabled: true, Attrs: surf.On(ctx, "username-disabled")})
		}
	</div>
}
