// Package label is hotty-surf's self-contained Label component, with explicit
// renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package label

import "neuroplast.io/hotty-surf/ui"

// Register registers label's assets with r.
func Register(r *ui.Registry) {}

// Props configures a Label component.
type Props struct {
	For   string
	Attrs templ.Attributes
	Class string
}

// View dispatches to Hotty or TUI according to ui.ModeOf(ctx).
templ View(p Props) {
	switch ui.ModeOf(ctx) {
	case ui.ModeHotty:
		@Hotty(p) {
			{ children... }
		}
	default:
		@TUI(p) {
			{ children... }
		}
	}
}

// Hotty renders Basecoat's <label> for a hotty host.
templ Hotty(p Props) {
	<label
		data-slot="label"
		class={ ui.JoinClass("label", p.Class) }
		{ ui.MergeAttrs(ui.OptAttr("for", p.For), p.Attrs)... }
	>
		{ children... }
	</label>
}

// TUI renders the label for cells.Screen.
templ TUI(p Props) {
	<label
		data-slot="label"
		data-mode="tui"
		class={ ui.JoinClass("label", p.Class) }
		{ ui.MergeAttrs(ui.OptAttr("for", p.For), p.Attrs)... }
	>
		{ children... }
	</label>
}
