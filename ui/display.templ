package ui

import "strconv"

templ breadcrumb(p BreadcrumbProps) {
	{{ checkAttrs(ctx, "Breadcrumb", p.Attrs, "class", "data-slot", "aria-label") }}
	<nav aria-label="breadcrumb" data-slot="breadcrumb" class={ join("breadcrumb", p.Class) } { p.Attrs... }>
		<ol>
			for i, it := range p.Items {
				if i > 0 {
					<li role="presentation" aria-hidden="true">
						@Icon("chevron-right", "")
					</li>
				}
				<li>
					if i == len(p.Items)-1 {
						<span aria-current="page" { it.Attrs... }>{ it.Label }</span>
					} else if linked(it.Attrs) {
						<a
							role="link"
							if stop(it.Attrs) {
								tabindex="0"
							}
							{ it.Attrs... }
						>{ it.Label }</a>
					} else {
						<span { it.Attrs... }>{ it.Label }</span>
					}
				</li>
			}
		</ol>
	</nav>
}

templ progress(p ProgressProps) {
	{{ checkProgress(ctx, p) }}
	{{ checkAttrs(ctx, "Progress", p.Attrs, "class", "data-slot", "role", "aria-valuemin", "aria-valuemax", "aria-valuenow=Value") }}
	<div
		data-slot="progress"
		role="progressbar"
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow={ strconv.FormatFloat(p.Value, 'f', -1, 64) }
		class={ join("progress", p.Class) }
		{ p.Attrs... }
	>
		<span style={ progressWidth(p.Value) }></span>
	</div>
}

templ table(p TableProps) {
	{{ checkAttrs(ctx, "Table", p.Attrs, "class", "data-slot") }}
	<div data-slot="table-container" class="table-container">
		<table data-slot="table" class={ join("table", p.Class) } { p.Attrs... }>
			{ children... }
		</table>
	</div>
}

templ item(p ItemProps) {
	{{ checkVariant(ctx, "Item", p.Variant, itemVariants) }}
	{{ checkSize(ctx, "Item", p.Size, itemSizes) }}
	{{ checkItem(ctx, p) }}
	{{ checkAttrs(ctx, "Item", p.Attrs, "class", "data-slot", "data-variant=Variant", "data-size=Size") }}
	if linked(p.Attrs) {
		<a
			data-slot="item"
			if v := itemVariant(p); v != "" {
				data-variant={ v }
			}
			if p.Size != "" {
				data-size={ string(p.Size) }
			}
			if stop(p.Attrs) {
				tabindex="0"
			}
			class={ join("item", p.Class) }
			{ p.Attrs... }
		>
			{ children... }
		</a>
	} else {
		<div
			data-slot="item"
			if v := itemVariant(p); v != "" {
				data-variant={ v }
			}
			if p.Size != "" {
				data-size={ string(p.Size) }
			}
			class={ join("item", p.Class) }
			{ p.Attrs... }
		>
			{ children... }
		</div>
	}
}
