// Package button is hotty-surf's self-contained Button component, with
// explicit renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI
// until implemented explicitly).
package button

import (
	"context"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/ui"
)

// Class is the button's root CSS class.
const Class = "btn"

// Register registers button's assets with r.
func Register(r *ui.Registry) {}

// Props are a Button's attributes. Its zero value is a medium Primary button.
type Props struct {
	// ID is an optional element id. When omitted and OnClick is set,
	// surf.On allocates a render-order unique id automatically.
	ID string
	// Variant is ui.Primary, ui.Secondary, ui.Outline, ui.Ghost,
	// ui.Destructive, or ui.Link.
	Variant ui.Variant
	// Size is ui.Medium (default), ui.XSmall, ui.Small, or ui.Large.
	Size ui.Size
	// IconOnly makes the button a compact icon button.
	IconOnly bool
	// Label sets aria-label (recommended for IconOnly buttons).
	Label    string
	Disabled bool
	// OnClick is called when the button is activated (click, Enter, Space).
	OnClick func()
	// Attrs are additional attributes (e.g. type="submit", title, or extra
	// surf.On handlers).
	Attrs templ.Attributes
	// Class adds extra CSS classes after Class.
	Class string
}

// View dispatches to Hotty or TUI according to ui.ModeOf(ctx).
// Modes without an explicit renderer (ModeANSI, ModePlain) fall back to TUI.
templ View(p Props) {
	switch ui.ModeOf(ctx) {
	case ui.ModeHotty:
		@Hotty(p) {
			{ children... }
		}
	default:
		@TUI(p) {
			{ children... }
		}
	}
}

// Hotty renders Basecoat's button markup for a hotty host.
templ Hotty(p Props) {
	{{ attrs := resolveAttrs(ctx, p, true) }}
	<button
		data-slot="button"
		if _, ok := attrs["type"]; !ok {
			type="button"
		}
		disabled?={ p.Disabled }
		if p.Variant != "" {
			data-variant={ string(p.Variant) }
		}
		if s := dataSize(p); s != "" {
			data-size={ s }
		}
		class={ ui.JoinClass(Class, p.Class) }
		{ attrs... }
	>
		{ children... }
	</button>
}

// TUI renders the interactive character-grid button for a cells.Screen host:
//   - xs: compact 1-row pill/outline
//   - sm / default: 1-row pill/outline with 1-cell padding
//   - lg / icon-lg: 3-row filled block or rounded box, bold weight
templ TUI(p Props) {
	{{ attrs := resolveAttrs(ctx, p, true) }}
	<button
		data-slot="button"
		data-mode="tui"
		if _, ok := attrs["type"]; !ok {
			type="button"
		}
		disabled?={ p.Disabled }
		if p.Variant != "" {
			data-variant={ string(p.Variant) }
		}
		if s := dataSize(p); s != "" {
			data-size={ s }
		}
		class={ ui.JoinClass(Class, p.Class) }
		{ attrs... }
	>
		{ children... }
	</button>
}

func resolveAttrs(ctx context.Context, p Props, interactive bool) templ.Attributes {
	var on templ.Attributes
	if interactive {
		if p.OnClick != nil {
			on = surf.On(ctx, p.ID, surf.Click(p.OnClick))
		} else if p.ID != "" {
			on = surf.On(ctx, p.ID)
		} else if !p.Disabled && p.Attrs["id"] == nil {
			on = surf.On(ctx, "")
		}
	}
	var aria templ.Attributes
	if p.Label != "" {
		aria = templ.Attributes{"aria-label": p.Label}
	}
	return ui.ScopeNativeAttrs(ctx, ui.MergeAttrs(on, p.Attrs, aria), "button")
}

func dataSize(p Props) string {
	if !p.IconOnly {
		return string(p.Size)
	}
	if p.Size == "" {
		return "icon"
	}
	return "icon-" + string(p.Size)
}
