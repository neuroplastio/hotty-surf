package ui

// Dialog's markup: dialog.html.jinja's (Basecoat 1.1.0, MIT; NOTICE.md),
// written in templ as the macro renders it open, with no trigger: the app
// opens it. The macro's inline onclick (showModal, close) is Go here.

import "neuroplast.io/hotty-surf"

templ dialog(p DialogProps, children templ.Component) {
	{{ d := newDialogView(ctx, p) }}
	if p.Open {
		{{ body, err := d.body(ctx, children) }}
		if err != nil {
			{{ return err }}
		}
		<dialog
			class={ join("dialog", p.Class) }
			if p.Title != "" {
				aria-labelledby={ d.id + "-title" }
			}
			if p.Description != "" {
				aria-describedby={ d.id + "-description" }
			}
			open
			{ surf.On(ctx, d.id, surf.Key(d.key))... }
		>
			<div { surf.On(ctx, d.id+"-content", surf.Focus(d.focus), surf.Outside(d.outside))... }>
				if p.Title != "" || p.Description != "" {
					<header>
						if p.Title != "" {
							<h2 id={ d.id + "-title" }>{ p.Title }</h2>
						}
						if p.Description != "" {
							<p id={ d.id + "-description" }>{ p.Description }</p>
						}
					</header>
				}
				@templ.Raw(body)
				<button type="button" class="btn" data-variant="ghost" data-size="icon-sm" aria-label="Close dialog" { surf.On(ctx, d.id+"-close", surf.Click(d.dismiss))... }>
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
				</button>
			</div>
		</dialog>
	}
}
