package ui

// Toaster's markup: toast.html.jinja's toaster and toast macros (Basecoat
// 1.1.0, MIT; NOTICE.md), written in templ as they render a ToasterState's
// toasts, with toast.js's aria-hidden on a toast that is going.

import (
	"strconv"

	"neuroplast.io/hotty-surf"
)

templ toaster(st *ToasterState) {
	{{ st.start(ctx) }}
	<div class="toaster" data-toaster-initialized="true" { surf.On(ctx, "toaster", surf.Hover(st.hover))... }>
		for _, t := range st.toasts {
			@toast(st, t)
		}
	</div>
}

// toast is the toast macro. A toast that stays (a negative Duration) has
// the macro's cancel button, Dismiss, which closes it as toast.js closes a
// toast on a click on its footer's button.
templ toast(st *ToasterState, t *shownToast) {
	{{ checkToast(ctx, t) }}
	<div
		id={ t.id() }
		class="toast"
		role={ t.role() }
		aria-atomic="true"
		aria-hidden={ bstr(t.hidden) }
		data-category={ t.category() }
		if d := t.duration(); d != "" {
			data-duration={ d }
		}
		if t.Focused {
			data-focused
		}
		if t.Total > 0 {
			data-bar
		}
		data-toast-initialized="true"
	>
		if t.Total > 0 {
			<div id={ t.barID() } class={ "toast-bar", templ.KV("still", t.Focused) } style={ t.barStyle() } aria-hidden="true"></div>
		}
		<div
			class="toast-content"
			if t.OnPress != nil {
				{ surf.On(ctx, t.id()+"-body", surf.Click(func() { st.press(t) }))... }
			}
		>
			if svg, ok := toastIcons[t.category()]; ok {
				@templ.Raw(svg)
			}
			<section>
				if t.Title != "" {
					<h2>{ t.Title }</h2>
				}
				if t.Description != "" {
					<p>{ t.Description }</p>
				}
			</section>
			if len(t.Actions) > 0 || t.dismiss() {
				<footer>
					for i := range t.Actions {
						@toastButton(st, t, i)
					}
					if t.dismiss() {
						<button type="button" class="btn" data-variant="outline" data-size="sm" data-toast-cancel disabled?={ t.hidden } { scopeNativeAttrs(ctx, surf.On(ctx, t.id()+"-dismiss", surf.Click(func() { st.choose(t, nil) })), "button")... }>Dismiss</button>
					}
				</footer>
			}
		</div>
	</div>
}

// toastButton is the macro's action button, or its cancel for an Outline
// action.
templ toastButton(st *ToasterState, t *shownToast, i int) {
	{{ a := &t.Actions[i] }}
	<button
		type="button"
		class="btn"
		if a.Variant != Primary {
			data-variant={ string(a.Variant) }
		}
		data-size="sm"
		if a.Variant == Outline {
			data-toast-cancel
		} else {
			data-toast-action
		}
		disabled?={ t.hidden }
		{ scopeNativeAttrs(ctx, surf.On(ctx, t.id()+"-actions-"+strconv.Itoa(i+1), surf.Click(func() { st.choose(t, a) })), "button")... }
	>{ a.Label }</button>
}
