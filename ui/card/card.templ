// Package card is hotty-surf's self-contained Card component, with explicit
// renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package card

import "neuroplast.io/hotty-surf/ui"

// Register registers card's assets with r.
func Register(r *ui.Registry) {}

// Props configures a Card component.
type Props struct {
	Size  ui.Size
	Attrs templ.Attributes
	Class string
}

// View dispatches to Hotty or TUI according to ui.ModeOf(ctx).
templ View(p Props) {
	switch ui.ModeOf(ctx) {
	case ui.ModeHotty:
		@Hotty(p) {
			{ children... }
		}
	default:
		@TUI(p) {
			{ children... }
		}
	}
}

// Hotty renders Basecoat's card for a hotty host.
templ Hotty(p Props) {
	<div
		data-slot="card"
		class={ ui.JoinClass("card", p.Class) }
		{ ui.MergeAttrs(ui.OptAttr("data-size", p.Size), p.Attrs)... }
	>
		{ children... }
	</div>
}

// TUI renders the card for cells.Screen.
templ TUI(p Props) {
	<div
		data-slot="card"
		data-mode="tui"
		class={ ui.JoinClass("card", p.Class) }
		{ ui.MergeAttrs(ui.OptAttr("data-size", p.Size), p.Attrs)... }
	>
		{ children... }
	</div>
}
