// Package story provides the storybook showcase for ui/badge.
package story

import (
	"neuroplast.io/hotty-surf/internal/story"
	"neuroplast.io/hotty-surf/ui"
	"neuroplast.io/hotty-surf/ui/badge"
)

// Props is the editable state for the Badge storybook controls.
type Props struct {
	Variant string `enum:"default,secondary,destructive,outline,ghost,link"`
	Label   string
}

var allVariants = []ui.Variant{ui.Primary, ui.Secondary, ui.Destructive, ui.Outline, ui.Ghost, ui.Link}

func variantName(v ui.Variant) string {
	if v == ui.Primary {
		return "primary"
	}
	return string(v)
}

func toVariant(v string) ui.Variant {
	if v == "default" || v == "primary" {
		return ui.Primary
	}
	return ui.Variant(v)
}

// Register adds badge's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "badge/default",
		Doc:          "All badge variants plus custom warning style",
		Consolidated: true,
		Score:        4,
		View:         func() templ.Component { return showcase() },
		Props: func() (any, templ.Component) {
			p := &Props{Variant: "default", Label: "Badge"}
			return p, editable(p)
		},
	})
}

templ editable(p *Props) {
	<div class="flex flex-col gap-4 p-4">
		<div>
			@badge.View(badge.Props{Variant: toVariant(p.Variant)}) { { p.Label } }
		</div>
		@showcase()
	</div>
}

templ showcase() {
	<div class="flex flex-col gap-3">
		<div class="flex flex-row flex-wrap gap-2">
			for _, v := range allVariants {
				@badge.View(badge.Props{Variant: v}) {
					{ variantName(v) }
				}
			}
		</div>
		<div class="flex flex-row flex-wrap items-center gap-2">
			@badge.View(badge.Props{Variant: ui.Outline, Class: "border-amber-500/50 text-amber-600 dark:text-amber-400"}) {
				@ui.Icon("triangle-alert", "")
				Low stock
			}
			<span class="text-sm text-muted-foreground">3 left</span>
		</div>
	</div>
}
