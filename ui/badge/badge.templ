// Package badge is hotty-surf's self-contained Badge component, with explicit
// renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package badge

import "neuroplast.io/hotty-surf/ui"

// Register registers badge's assets with r.
func Register(r *ui.Registry) {}

// Props configures a Badge component.
type Props struct {
	Variant ui.Variant
	Attrs   templ.Attributes
	Class   string
}

// View dispatches to Hotty or TUI according to ui.ModeOf(ctx).
templ View(p Props) {
	switch ui.ModeOf(ctx) {
	case ui.ModeHotty:
		@Hotty(p) {
			{ children... }
		}
	default:
		@TUI(p) {
			{ children... }
		}
	}
}

// Hotty renders Basecoat's badge for a hotty host.
templ Hotty(p Props) {
	<span
		data-slot="badge"
		class={ ui.JoinClass("badge", p.Class) }
		{ ui.MergeAttrs(ui.OptAttr("data-variant", p.Variant), p.Attrs)... }
	>
		{ children... }
	</span>
}

// TUI renders the badge for cells.Screen.
templ TUI(p Props) {
	<span
		data-slot="badge"
		data-mode="tui"
		class={ ui.JoinClass("badge", p.Class) }
		{ ui.MergeAttrs(ui.OptAttr("data-variant", p.Variant), p.Attrs)... }
	>
		{ children... }
	</span>
}
