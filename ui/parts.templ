package ui

// The icons and keys: the markup their exported functions (ui.go) return.

import (
	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/internal/keycap"
)

templ icon(name, class string) {
	{{ checkIcon(ctx, name) }}
	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={ join("lucide lucide-"+lucideClass(name), class) }>
		@templ.Raw(icons[name])
	</svg>
}




templ kbd(keys string) {
	<kbd data-slot="kbd" class="kbd">{ keycap.Text(surf.Platform(ctx), keys) }</kbd>
}
