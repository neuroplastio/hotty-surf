package ui

// The components made from Basecoat's CSS alone, and the icons and keys:
// the markup their exported functions (css.go, ui.go) return.

import (
	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/internal/keycap"
)

templ icon(name, class string) {
	{{ checkIcon(ctx, name) }}
	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={ join("lucide lucide-"+lucideClass(name), class) }>
		@templ.Raw(icons[name])
	</svg>
}

templ button(p ButtonProps) {
	{{ checkVariant(ctx, "Button", p.Variant, buttonVariants) }}
	{{ checkSize(ctx, "Button", p.Size) }}
	<button
		data-slot="button"
		type="button"
		disabled?={ p.Disabled }
		if p.Variant != "" {
			data-variant={ string(p.Variant) }
		}
		if s := buttonSize(p); s != "" {
			data-size={ s }
		}
		class={ join("btn", p.Class) }
		{ p.Attrs... }
	>
		{ children... }
	</button>
}

templ badge(p BadgeProps) {
	{{ checkVariant(ctx, "Badge", p.Variant, badgeVariants) }}
	<span
		data-slot="badge"
		if p.Variant != "" {
			data-variant={ string(p.Variant) }
		}
		class={ join("badge", p.Class) }
		{ p.Attrs... }
	>{ children... }</span>
}

templ card(p CardProps) {
	<div data-slot="card" class={ join("card", p.Class) } { p.Attrs... }>
		{ children... }
	</div>
}

templ kbd(keys string) {
	<kbd data-slot="kbd" class="kbd">{ keycap.Text(surf.Platform(ctx), keys) }</kbd>
}
