// Package avatar is hotty-surf's self-contained Avatar component, with explicit
// renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package avatar

import (
	_ "embed"
	"fmt"
	"hash/fnv"

	"neuroplast.io/hotty-surf/ui"
)

//go:embed avatar.css
var css string

// Register registers avatar's assets with r.
func Register(r *ui.Registry) { r.CSS("avatar", css) }

// Hue tints an avatar's surface & foreground consistently across Hotty and TUI.
type Hue string

const (
	HueDefault Hue = ""
	HueAmber   Hue = "amber"
	HueCoral   Hue = "chart-1"
	HueTeal    Hue = "chart-2"
	HueBlue    Hue = "chart-3"
	HueGold    Hue = "chart-4"
	HueViolet  Hue = "chart-5"
)

// Props configures an Avatar component.
type Props struct {
	// Src is an optional image URL or data URI. In Hotty mode it renders an
	// <img>; in TUI mode it uses the Kitty graphics protocol when supported,
	// falling back to children/initials otherwise.
	Src    string
	Alt    string
	Size   ui.Size
	Hue    Hue
	// Online renders a status indicator dot on the avatar.
	Online bool
	Attrs  templ.Attributes
	Class  string
}

// GroupProps configures an overlapping Avatar group.
type GroupProps struct {
	Attrs templ.Attributes
	Class string
}

// View dispatches to Hotty or TUI according to ui.ModeOf(ctx).
templ View(p Props) {
	switch ui.ModeOf(ctx) {
	case ui.ModeHotty:
		@Hotty(p) {
			{ children... }
		}
	default:
		@TUI(p) {
			{ children... }
		}
	}
}

// Hotty renders Basecoat's avatar with optional image, Hue tint, and status badge.
templ Hotty(p Props) {
	<span
		data-slot="avatar"
		class={ ui.JoinClass("avatar", p.Class) }
		{ ui.MergeAttrs(
			ui.OptAttr("data-size", p.Size),
			ui.OptAttr("data-hue", p.Hue),
			p.Attrs,
		)... }
	>
		if p.Src != "" {
			<img { imgSrcAttr(p.Src)... } alt={ p.Alt }/>
		} else {
			{ children... }
		}
		if p.Online {
			<span class="avatar-badge" style="background-color: var(--chart-2);"></span>
		}
	</span>
}

// TUI renders an inline Kitty-graphics image when Src is set and Kitty is
// supported in ModeTUI, otherwise a tinted pill avatar (e.g. " GH ") with an
// optional ● status dot.
templ TUI(p Props) {
	if p.Src != "" && ui.ModeOf(ctx) == ui.ModeTUI && ui.SupportsKitty(ctx) {
		<span
			id={ avatarImgID(p) }
			data-slot="avatar"
			data-mode="tui"
			data-avatar-img={ p.Src }
			if p.Online {
				data-online="true"
			}
			class={ ui.JoinClass("avatar", p.Class) }
			{ ui.MergeAttrs(
				ui.OptAttr("data-size", p.Size),
				ui.OptAttr("data-hue", p.Hue),
				p.Attrs,
			)... }
		></span>
	} else {
		<span
			data-slot="avatar"
			data-mode="tui"
			class={ ui.JoinClass("avatar font-semibold", tuiHueClass(p.Hue), p.Class) }
			{ ui.MergeAttrs(
				ui.OptAttr("data-size", p.Size),
				ui.OptAttr("data-hue", p.Hue),
				p.Attrs,
			)... }
		>
			<span> </span>
			{ children... }
			if p.Online {
				<span style="color: var(--chart-2);">●</span>
			}
			<span> </span>
		</span>
	}
}

// Group renders overlapping avatars (spaced nicely in TUI).
templ Group(p GroupProps) {
	if ui.ModeOf(ctx) == ui.ModeHotty {
		<div data-slot="avatar-group" class={ ui.JoinClass("avatar-group", p.Class) } { p.Attrs... }>
			{ children... }
		</div>
	} else {
		<div data-slot="avatar-group" data-mode="tui" class={ ui.JoinClass("flex items-center", p.Class) } { p.Attrs... }>
			{ children... }
		</div>
	}
}

func imgSrcAttr(src string) templ.Attributes {
	return templ.Attributes{"src": templ.SafeURL(src)}
}

func avatarImgID(p Props) string {
	h := fnv.New32a()
	_, _ = h.Write([]byte(p.Src))
	_, _ = h.Write([]byte(p.Alt))
	_, _ = h.Write([]byte(p.Size))
	_, _ = h.Write([]byte(p.Hue))
	return fmt.Sprintf("avatar-img-%x", h.Sum32())
}

func tuiHueClass(h Hue) string {
	switch h {
	case HueAmber:
		return "bg-amber-500/20 text-amber-600 dark:text-amber-400"
	case HueCoral:
		return "bg-chart-1/20 text-chart-1"
	case HueTeal:
		return "bg-chart-2/20 text-chart-2"
	case HueBlue:
		return "bg-chart-3/20 text-chart-3"
	case HueGold:
		return "bg-chart-4/20 text-chart-4"
	case HueViolet:
		return "bg-chart-5/20 text-chart-5"
	default:
		return "bg-secondary text-secondary-foreground"
	}
}
