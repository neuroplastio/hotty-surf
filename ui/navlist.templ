package ui

import "neuroplast.io/hotty-surf"

// FilterInput renders the filter field with the additional classes in class.
// Arrows and Page Up/Down move the list; Enter is forwarded to the app.
// Home and End follow the field's editing keymap.
templ (l *NavList) FilterInput(class string) {
	{{ linkText() }}
	<input
		type="text"
		class={ join("input", class) }
		placeholder={ l.Placeholder }
		aria-label={ l.FilterLabel }
		value={ l.Filter }
		{ surf.On(ctx, l.FilterID(), surf.Input(l.setFilter), surf.Key(l.Keys, navFilterKeys...), surf.Focus(func(in bool) { if in { l.in = "filter" } else { l.in = "" } }))... }
	/>
}

// List renders the matching groups in a navigation element with the
// additional classes in class. Items are buttons; the current one is
// marked and takes Tab. Arrows, Page Up/Down, Home and End move it.
templ (l *NavList) List(class string) {
	{{ l.track(ctx) }}
	{{ groups := l.shownGroups() }}
	<nav aria-label={ l.Label } class={ join("nav-list", class) }>
		for _, g := range groups {
			if g.Name != "" {
				<div class="nav-group text-muted-foreground px-2 pt-3 pb-1 text-xs font-medium">{ g.Name }</div>
			}
			for _, it := range g.Items {
				@l.item(it)
			}
		}
		if len(groups) == 0 && l.Empty != "" {
			<p class="text-muted-foreground px-2 py-3 text-sm">{ l.Empty }</p>
		}
	</nav>
}

templ (l *NavList) item(it NavItem) {
	<button
		type="button"
		tabindex={ roving(it.ID == l.Current) }
		aria-current={ bstr(it.ID == l.Current) }
		class={ join("nav-item flex w-full items-center rounded-md px-2 py-1 text-left text-sm", navItemClass(it.ID == l.Current)) }
		{ surf.On(ctx, l.ItemID(it.ID), surf.Click(func() { l.selectItem(it.ID) }), surf.Key(l.Keys, navItemKeys...), surf.Focus(func(in bool) { if in { l.in = "list" } else { l.in = "" } }))... }
	>
		<span class="truncate flex-1">{ it.Label }</span>
		if it.Dot != "" {
			<span class={ "nav-dot", "nav-dot-" + it.Dot } aria-hidden="true"></span>
		}
	</button>
}
