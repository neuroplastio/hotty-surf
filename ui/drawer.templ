package ui

import "neuroplast.io/hotty-surf"

// Drawer is the drawer.js dialog structure: the app supplies the content.
templ drawer(st *DrawerState, p DrawerProps, children templ.Component) {
 {{ checkEnum(ctx, "Drawer", "Side", p.Side, []string{"", "bottom", "top", "left", "right"}) }}
 {{ st.sync(ctx, p.Open) }}
 {{ d := newDialogView(ctx, st.dialogProps(p)) }}
 if st.shown {
  {{ body, err := d.body(ctx,children) }}
  if err != nil {
   {{ return err }}
  }
  <dialog class={ join("drawer",p.Class) } open data-drawer-initialized="true"
   if p.Side != "" { data-side={ p.Side } }
   if st.closing { data-closing="true" }
   { kitOn(ctx,d.id,surf.Key(d.key))... }>
   <div { surf.On(ctx,d.id+"-content",surf.Focus(d.focus),surf.Outside(d.outside))... }>@templ.Raw(body)</div>
  </dialog>
 }
}
