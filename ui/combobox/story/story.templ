// Package story provides the storybook showcase for ui/combobox.
package story

import (
	"strings"

	"neuroplast.io/hotty-surf/internal/story"
	"neuroplast.io/hotty-surf/ui/combobox"
)

type state struct {
	box      combobox.State
	boxClear combobox.State
	boxMulti combobox.State
	value    string
	clearVal string
	values   []string
}

var fruitItems = []combobox.Item{
	{Value: "a", Label: "Apple"},
	{Value: "b", Label: "Banana"},
	{Value: "c", Label: "Cherry", Group: "More"},
	{Value: "d", Label: "Date", Group: "More", Disabled: true},
}

func fruitValue(v string) string {
	if v == "" {
		return "none"
	}
	return v
}

// Register adds combobox's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "combobox/default",
		Doc:          "Searchable single (grouped), clearable, and multiple-chip comboboxes",
		Consolidated: true,
		Score:        4,
		View:         func() templ.Component { return showcase(&state{clearVal: "a"}) },
		Keys:         []string{"tab", "b", "a", "arrow_down", "enter"},
		Want:         "fruit: b",
	})
}

templ showcase(s *state) {
	<div class="p-4 flex flex-col gap-4">
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted-foreground">Default (grouped + disabled)</span>
			@combobox.View(&s.box, combobox.Props{ID: "fruit", Placeholder: "Choose fruit", Value: s.value, Items: fruitItems, OnChange: func(v string) { s.value = v }})
			<p class="text-sm text-muted-foreground">fruit: { fruitValue(s.value) }</p>
		</div>
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted-foreground">Clearable</span>
			@combobox.View(&s.boxClear, combobox.Props{ID: "fruit-clear", Placeholder: "Choose fruit", Clear: true, Value: s.clearVal, Items: fruitItems, OnChange: func(v string) { s.clearVal = v }})
			<p class="text-sm text-muted-foreground">clear: { fruitValue(s.clearVal) }</p>
		</div>
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted-foreground">Multiple (chips)</span>
			@combobox.View(&s.boxMulti, combobox.Props{ID: "fruit-multi", Placeholder: "Choose fruits", Multiple: true, Values: s.values, Items: fruitItems, OnValuesChange: func(v []string) { s.values = v }})
			<p class="text-sm text-muted-foreground">fruits: { strings.Join(s.values, ", ") }</p>
		</div>
	</div>
}
