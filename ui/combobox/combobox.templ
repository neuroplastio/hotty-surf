// Package combobox is hotty-surf's self-contained Combobox component, with
// explicit renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package combobox

import (
	"context"
	_ "embed"
	"fmt"
	"slices"
	"strconv"
	"strings"
	"unicode"
	"unicode/utf8"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/internal/rt"
	"neuroplast.io/hotty-surf/ui"
)

//go:embed chevron.svg
var chevronSVG string

//go:embed close.svg
var closeSVG string

//go:embed combobox.css
var css string

// Register registers combobox's assets with r.
func Register(r *ui.Registry) { r.CSS("combobox", css) }

// Item is an option in a Combobox. Consecutive items with the same Group share
// a heading with separators between groups. Values must be unique; labels may
// repeat. Keywords are extra search terms separated by spaces or commas.
type Item struct {
	Value    string
	Label    string
	Group    string
	Disabled bool
	Keywords string
}

// State holds the search text, open state, and highlighted item between renders.
// The zero value is closed with an empty search.
type State struct {
	open            bool
	text            string
	query           string
	editing         bool
	lastValue       string
	seenValue       bool
	clearedByInput  bool
	changedByChoice bool
	active          int
	moved           bool
	focus           bool
	focusAt         uint64
}

// Props configures a Combobox component.
type Props struct {
	ID             string
	Items          []Item
	Value          string
	Values         []string
	Multiple       bool
	Placeholder    string
	Disabled       bool
	Clear          bool
	AutoHighlight  bool
	CloseOnSelect  bool
	Keys           ui.KeyMap
	OnChange       func(string)
	OnValuesChange func([]string)
	InputAttrs     templ.Attributes
	Class          string
}

// View dispatches to Hotty or TUI according to ui.ModeOf(ctx).
templ View(st *State, p Props) {
	switch ui.ModeOf(ctx) {
	case ui.ModeHotty:
		@Hotty(st, p)
	default:
		@TUI(st, p)
	}
}

// Hotty renders Basecoat's searchable combobox for a hotty host.
templ Hotty(st *State, p Props) {
	@comboboxBox(newComboboxView(ctx, st, p), false)
}

// TUI renders the searchable combobox for cells.Screen.
templ TUI(st *State, p Props) {
	@comboboxBox(newComboboxView(ctx, st, p), true)
}

templ comboboxBox(v *comboboxView, tui bool) {
	{{ v.join(ctx) }}
	<div
		class={ ui.JoinClass("combobox", v.p.Class) }
		data-combobox-initialized="true"
		if tui {
			data-mode="tui"
		}
		{ ui.MergeAttrs(
			v.rootAttrs(ctx),
			ui.OptAttr("data-close-on-select", v.p.Multiple && v.p.CloseOnSelect),
			ui.OptAttr("data-auto-highlight", v.p.AutoHighlight),
		)... }
	>
		if v.p.Multiple {
			<div class="combobox-chips">
				for i, value := range v.p.Values {
					<span class="combobox-chip" data-value={ value }>
						<span>{ v.label(value) }</span>
						<button
							type="button"
							class="combobox-chip-remove btn"
							data-variant="ghost"
							data-size="icon-xs"
							aria-label={ "Remove " + v.label(value) }
							disabled?={ v.p.Disabled }
							{ ui.ScopeNativeAttrs(ctx, surf.On(ctx, v.chipID(i), surf.Click(v.removeClick(value))), "button")... }
						>
							if tui {
								×
							} else {
								@templ.Raw(closeSVG)
							}
						</button>
					</span>
				}
				@comboboxInput(v, tui)
			</div>
		} else if v.p.Clear {
			<div class="input-group">
				@comboboxInput(v, tui)
				<span role="group" data-align="inline-end">
					<button
						type="button"
						data-clear
						aria-label="Clear selection"
						hidden?={ v.p.Value == "" && v.st.text == "" }
						disabled?={ v.p.Disabled }
						{ ui.ScopeNativeAttrs(ctx, surf.On(ctx, v.id+"-clear", surf.Click(v.clear)), "button")... }
					>
						if tui {
							×
						} else {
							@templ.Raw(closeSVG)
						}
					</button>
					<button
						type="button"
						class="btn"
						data-variant="ghost"
						data-size="icon-xs"
						aria-label="Open suggestions"
						aria-haspopup="listbox"
						aria-expanded={ bstr(v.st.open) }
						aria-controls={ v.id + "-listbox" }
						disabled?={ v.p.Disabled }
						{ ui.ScopeNativeAttrs(ctx, surf.On(ctx, v.id+"-trigger", surf.Click(v.toggle)), "button")... }
					>
						if !tui {
							@templ.Raw(chevronSVG)
						}
					</button>
				</span>
			</div>
		} else {
			@comboboxInput(v, tui)
			if !tui {
				<span class="combobox-trigger-icon" aria-hidden="true">
					@templ.Raw(chevronSVG)
				</span>
			}
		}
		<div
			id={ v.id + "-popover" }
			data-popover
			if tui {
				data-mode="tui"
			}
			aria-hidden={ bstr(!v.st.open) }
			data-empty={ bstr(len(v.visible) == 0) }
		>
			<div
				role="listbox"
				id={ v.id + "-listbox" }
				aria-orientation="vertical"
				if v.p.Multiple {
					aria-multiselectable="true"
				}
			>
				{{ visible := v.visibleEntries() }}
				if len(visible) == 0 {
					<div class="combobox-empty text-muted-foreground px-1" data-value="">No results found</div>
				} else {
					for _, e := range visible {
						switch e.kind {
							case entryOpt:
								@comboboxOption(v, e.opt)
							case entryGroup:
								<div role="group" aria-labelledby={ e.labelID }>
									<div role="heading" id={ e.labelID } if tui { class="text-muted-foreground" }>{ e.group }</div>
									for _, i := range e.opts {
										@comboboxOption(v, i)
									}
								</div>
							case entrySeparator:
								<hr role="separator"/>
						}
					}
				}
			</div>
		</div>
		<input type="hidden" name={ v.id + "-value" } value={ v.hiddenValue() }/>
		if v.refocus() {
			{{ surf.Autofocus(ctx, v.id+"-input") }}
		}
	</div>
}

templ comboboxInput(v *comboboxView, tui bool) {
	<input
		type="text"
		role="combobox"
		if tui {
			data-mode="tui"
			data-min-w={ strconv.Itoa(v.maxLabelWidth()) }
		}
		placeholder={ v.p.Placeholder }
		autocomplete="off"
		autocorrect="off"
		spellcheck="false"
		aria-autocomplete="list"
		aria-expanded={ bstr(v.st.open) }
		aria-controls={ v.id + "-listbox" }
		value={ v.fieldValue() }
		disabled?={ v.p.Disabled }
		if i := v.active(); i >= 0 {
			aria-activedescendant={ v.opts[i].id }
		}
		{ v.inputAttrs(ctx)... }
	/>
}

templ comboboxOption(v *comboboxView, i int) {
	{{ o := v.opts[i] }}
	<div
		role="option"
		data-value={ o.value }
		aria-hidden={ bstr(!v.shown[i]) }
		{ ui.MergeAttrs(
			ui.OptAttr("data-keywords", v.p.Items[i].Keywords),
			ui.OptAttr("aria-selected", v.selected(o.value)),
			ui.OptAttr("aria-disabled", o.disabled),
		)... }
		if i == v.active() {
			class="active"
		}
		if o.disabled {
			id={ o.id }
		} else {
			{ surf.On(ctx, o.id, surf.Click(v.selectClick(i)), surf.Hover(v.hover(i)))... }
		}
	>{ o.label }</div>
}

type entryKind uint8

const (
	entryOpt entryKind = iota
	entryGroup
	entrySeparator
)

type listEntry struct {
	kind    entryKind
	opt     int
	group   string
	labelID string
	opts    []int
}

type listOpt struct {
	id       string
	value    string
	label    string
	disabled bool
}

type comboboxView struct {
	st      *State
	p       Props
	id      string
	entries []listEntry
	opts    []listOpt
	shown   []bool
	visible []int
	keys    ui.ResolvedKeys
	n       uint64
	popups  *ui.Popup
}

func newComboboxView(ctx context.Context, st *State, p Props) *comboboxView {
	if !p.Multiple && st.seenValue && p.Value != st.lastValue && !(st.clearedByInput && p.Value == "") && !st.changedByChoice {
		st.text, st.query, st.editing = "", "", false
	}
	st.lastValue, st.seenValue, st.clearedByInput, st.changedByChoice = p.Value, true, false, false
	id := p.ID
	if id == "" {
		id = "combobox"
	}
	keys := ui.ResolveTextKeys(ctx, p.Keys, ui.ActDown, ui.ActUp, ui.ActFirst, ui.ActLast, ui.ActConfirm, ui.ActCancel)
	v := &comboboxView{st: st, p: p, id: id, keys: keys}
	v.entries, v.opts = grouped(v.id+"-items", p.Items)
	if p.Disabled {
		st.open = false
		st.moved = false
	}
	search := strings.ToLower(strings.TrimSpace(v.st.query))
	v.shown = make([]bool, len(v.opts))
	for i, o := range v.opts {
		v.shown[i] = search == "" || strings.Contains(strings.ToLower(strings.TrimSpace(o.label)), search)
		if !v.shown[i] {
			for _, word := range strings.FieldsFunc(strings.ToLower(p.Items[i].Keywords), func(r rune) bool { return r == ',' || unicode.IsSpace(r) }) {
				if strings.Contains(word, search) {
					v.shown[i] = true
					break
				}
			}
		}
		if v.shown[i] && !o.disabled {
			v.visible = append(v.visible, i)
		}
	}
	if st.moved && !slices.Contains(v.visible, st.active) {
		st.moved = false
	}
	return v
}

func grouped(prefix string, items []Item) ([]listEntry, []listOpt) {
	var (
		entries []listEntry
		opts    []listOpt
	)
	for i := 0; i < len(items); {
		g := items[i].Group
		if len(entries) > 0 && (g != "" || entries[len(entries)-1].kind == entryGroup) {
			entries = append(entries, listEntry{kind: entrySeparator})
		}
		at := prefix + "-" + strconv.Itoa(len(entries)+1)
		if g == "" {
			it := items[i]
			opts = append(opts, listOpt{id: at, value: it.Value, label: it.Label, disabled: it.Disabled})
			entries = append(entries, listEntry{kind: entryOpt, opt: len(opts) - 1})
			i++
			continue
		}
		e := listEntry{kind: entryGroup, group: g, labelID: "group-label-" + at}
		for m := 1; i < len(items) && items[i].Group == g; i, m = i+1, m+1 {
			it := items[i]
			opts = append(opts, listOpt{id: at + "-" + strconv.Itoa(m), value: it.Value, label: it.Label, disabled: it.Disabled})
			e.opts = append(e.opts, len(opts)-1)
		}
		entries = append(entries, e)
	}
	return entries, opts
}

func (v *comboboxView) inputAttrs(ctx context.Context) templ.Attributes {
	owned := []string{"id", "class", "type", "value", "placeholder", "disabled", "role", "autocomplete", "autocorrect", "spellcheck", "aria-autocomplete", "aria-expanded", "aria-controls", "aria-activedescendant", "data-on"}
	a := make(templ.Attributes, len(v.p.InputAttrs)+4)
	for k, value := range v.p.InputAttrs {
		key := strings.ToLower(k)
		if strings.HasPrefix(key, "on") || strings.HasPrefix(key, "data-hotty-") || slices.Contains(owned, key) {
			rt.Fault(ctx, fmt.Sprintf("combobox.View: InputAttrs cannot set %q", k))
			continue
		}
		a[k] = value
	}
	handlers := []surf.Handler{surf.Input(v.input), surf.Focus(v.focus), surf.Click(v.open), surf.Key(v.key, v.fieldKeys()...)}
	if !v.p.Disabled {
		if b, ok := ui.BindKeys(ctx, v.p.Keys); ok {
			handlers = append(handlers, b)
		}
	}
	for k, value := range ui.ScopeCompoundAttrs(ctx, ui.KitOn(ctx, v.id+"-input", handlers...)) {
		a[k] = value
	}
	return a
}

func (v *comboboxView) join(ctx context.Context) string {
	seen := map[string]bool{}
	for _, item := range v.p.Items {
		if seen[item.Value] {
			rt.Fault(ctx, fmt.Sprintf("combobox.View: duplicate item value %q", item.Value))
		}
		seen[item.Value] = true
	}
	if f := rt.From(ctx); f != nil {
		v.n = f.N()
	}
	v.popups = ui.Popups(ctx)
	v.popups.Track(ctx, v.st, v.id, v.st.open, v.shut)
	return ""
}

func (v *comboboxView) shut() { v.st.open = false; v.st.moved = false }

func (v *comboboxView) selected(value string) bool {
	if v.p.Multiple {
		return slices.Contains(v.p.Values, value)
	}
	return value != "" && v.p.Value == value
}

func (v *comboboxView) fieldValue() string {
	if v.p.Multiple || v.st.editing {
		return v.st.text
	}
	for _, o := range v.opts {
		if o.value != "" && o.value == v.p.Value {
			return o.label
		}
	}
	return ""
}

func (v *comboboxView) active() int {
	if !v.st.open {
		return -1
	}
	if v.st.moved && slices.Contains(v.visible, v.st.active) {
		return v.st.active
	}
	if v.p.AutoHighlight && len(v.visible) > 0 {
		return v.visible[0]
	}
	return -1
}

func (v *comboboxView) open() {
	if v.p.Disabled || v.st.open {
		return
	}
	v.st.open = true
	if v.p.Multiple || v.st.editing {
		v.st.query = v.st.text
	} else {
		v.st.query = ""
	}
	v.st.moved = false
	v.popups.Opened(v.st, v.shut)
}

func (v *comboboxView) close(focus bool) {
	if !v.st.open {
		return
	}
	v.shut()
	v.popups.Closed(v.st)
	if focus {
		v.ask()
	}
}

func (v *comboboxView) ask() { v.st.focus = true; v.st.focusAt = v.n + 1 }

func (v *comboboxView) refocus() bool {
	ok := v.st.focus && (v.st.focusAt == 0 || v.st.focusAt == v.n)
	v.st.focus = false
	return ok
}

func (v *comboboxView) focus(in bool) {
	if in {
		v.open()
	}
}

func (v *comboboxView) input(text string) {
	v.st.text = text
	v.st.query = text
	v.st.editing = true
	v.st.moved = false
	v.open()
	if !v.p.Multiple && v.p.Value != "" && v.p.OnChange != nil {
		v.st.clearedByInput = true
		v.p.OnChange("")
	}
}

func (v *comboboxView) outside() { v.close(false) }

func (v *comboboxView) rootAttrs(ctx context.Context) templ.Attributes {
	if v.st.open {
		return ui.KitOn(ctx, v.id, surf.Outside(v.outside), surf.Key(v.key))
	}
	return ui.KitOn(ctx, v.id, surf.Key(v.key))
}

func (v *comboboxView) choose(i int) {
	if i < 0 || i >= len(v.opts) || v.opts[i].disabled {
		return
	}
	o := v.opts[i]
	if v.p.Multiple {
		values := slices.Clone(v.p.Values)
		if j := slices.Index(values, o.value); j >= 0 {
			values = slices.Delete(values, j, j+1)
		} else {
			values = append(values, o.value)
		}
		if v.p.OnValuesChange != nil {
			v.p.OnValuesChange(values)
		}
		v.st.text = ""
		v.st.query = ""
		v.st.editing = true
		if v.p.CloseOnSelect {
			v.close(true)
		} else {
			v.ask()
		}
		return
	}
	if v.p.OnChange != nil && v.p.Value != o.value {
		v.st.changedByChoice = true
		v.p.OnChange(o.value)
	}
	v.st.text = ""
	v.st.editing = false
	v.close(true)
	v.ask()
}

func (v *comboboxView) clear() {
	if v.p.Multiple {
		if v.p.OnValuesChange != nil {
			v.p.OnValuesChange(nil)
		}
	} else if v.p.OnChange != nil {
		v.p.OnChange("")
	}
	v.st.text = ""
	v.st.query = ""
	v.st.editing = true
	v.st.moved = false
	v.ask()
}

func (v *comboboxView) remove(value string) {
	if i := slices.Index(v.p.Values, value); i >= 0 {
		values := slices.Clone(v.p.Values)
		values = slices.Delete(values, i, i+1)
		if v.p.OnValuesChange != nil {
			v.p.OnValuesChange(values)
		}
		v.ask()
	}
}

func (v *comboboxView) hover(i int) func(bool) {
	return func(over bool) {
		if over && v.st.open && slices.Contains(v.visible, i) {
			v.st.active = i
			v.st.moved = true
		}
	}
}

func (v *comboboxView) key(k string) bool {
	if k == "backspace" && v.p.Multiple && v.st.text == "" && len(v.p.Values) > 0 {
		v.remove(v.p.Values[len(v.p.Values)-1])
		return true
	}
	act, ok := v.keys.Match(k)
	if !ok {
		return false
	}
	if act == ui.ActCancel && v.st.open {
		v.close(true)
		return true
	}
	if !v.st.open {
		switch act {
		case ui.ActDown, ui.ActUp, ui.ActFirst, ui.ActLast:
			v.open()
		default:
			return false
		}
	}
	if act == ui.ActConfirm {
		if i := v.active(); i >= 0 {
			v.choose(i)
		}
		return true
	}
	if len(v.visible) == 0 {
		return false
	}
	pos := slices.Index(v.visible, v.active())
	next := pos
	switch act {
	case ui.ActDown:
		next = min(pos+1, len(v.visible)-1)
	case ui.ActUp:
		next = max(pos-1, 0)
	case ui.ActFirst:
		next = 0
	case ui.ActLast:
		next = len(v.visible) - 1
	default:
		return false
	}
	v.st.active = v.visible[next]
	v.st.moved = true
	return true
}

func (v *comboboxView) fieldKeys() []string {
	keys := v.keys.Declare(ui.ActConfirm)
	if len(v.visible) > 0 {
		for _, k := range []string{"arrow_down", "arrow_up", "home", "end"} {
			if _, ok := v.keys.Match(k); ok && !slices.Contains(keys, k) {
				keys = append(keys, k)
			}
		}
		for _, k := range v.keys.Declare(ui.ActDown, ui.ActUp, ui.ActFirst, ui.ActLast) {
			if !slices.Contains(keys, k) {
				keys = append(keys, k)
			}
		}
	}
	if v.p.Multiple && v.st.text == "" && len(v.p.Values) > 0 {
		keys = append(keys, "backspace")
	}
	return keys
}

func (v *comboboxView) hiddenValue() string {
	if !v.p.Multiple {
		return v.p.Value
	}
	var b strings.Builder
	b.WriteByte('[')
	for i, value := range v.p.Values {
		if i > 0 {
			b.WriteByte(',')
		}
		b.WriteString(strconv.Quote(value))
	}
	b.WriteByte(']')
	return b.String()
}

func (v *comboboxView) label(value string) string {
	for _, item := range v.p.Items {
		if item.Value == value {
			return item.Label
		}
	}
	return value
}

func (v *comboboxView) removeClick(value string) func() { return func() { v.remove(value) } }
func (v *comboboxView) chipID(i int) string             { return v.id + "-chip-" + strconv.Itoa(i) }
func (v *comboboxView) selectClick(i int) func()        { return func() { v.choose(i) } }

func (v *comboboxView) toggle() {
	if v.st.open {
		v.close(false)
	} else {
		v.open()
		v.ask()
	}
}

func (v *comboboxView) visibleEntries() []listEntry {
	var out []listEntry
	pendingSep := false
	for _, e := range v.entries {
		switch e.kind {
		case entrySeparator:
			if len(out) > 0 {
				pendingSep = true
			}
		case entryOpt:
			if !v.shown[e.opt] {
				continue
			}
			if pendingSep {
				out = append(out, listEntry{kind: entrySeparator})
				pendingSep = false
			}
			out = append(out, e)
		case entryGroup:
			var opts []int
			for _, i := range e.opts {
				if v.shown[i] {
					opts = append(opts, i)
				}
			}
			if len(opts) == 0 {
				continue
			}
			if pendingSep {
				out = append(out, listEntry{kind: entrySeparator})
				pendingSep = false
			}
			g := e
			g.opts = opts
			out = append(out, g)
		}
	}
	return out
}

func (v *comboboxView) maxLabelWidth() int {
	w := utf8.RuneCountInString(v.p.Placeholder)
	for _, o := range v.opts {
		if n := utf8.RuneCountInString(o.label); n > w {
			w = n
		}
	}
	return w
}

func bstr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
