package book

import (
	"neuroplast.io/hotty-surf"
	code "neuroplast.io/hotty-surf/internal/book/highlight"
	storybook "neuroplast.io/hotty-surf/internal/book/model"
	"neuroplast.io/hotty-surf/ui"
)

// View is the storybook's list, live preview, and inspection tabs.
templ View(a *App) {
	<div id="book" class={ "book flex", templ.KV("dark", a.model.Dark), templ.KV("light", !a.model.Dark) } { surf.On(ctx, "book-shell", surf.Key(a.bookKey))... }>
		{{ from, sts, below := a.window() }}
		<aside class="book-list flex flex-col">
			<div class="book-brand flex items-center gap-2">
				<span class="font-semibold">hotty storybook</span>
				<span class="text-sm text-muted-foreground">{ itoa(len(a.all)) }</span>
				@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Size: ui.XSmall, Attrs: surf.On(ctx, "book-theme", surf.Click(a.model.ToggleTheme))}) {
					if a.model.Dark {
						Light
					} else {
						Dark
					}
				}
			</div>
			<div class="book-filter">
				@ui.Input(ui.InputProps{Value: a.model.Filter, Placeholder: "Filter stories  ( / )", Attrs: surf.On(ctx, "book-filter", surf.Input(a.filter), surf.Key(a.bookKey))})
			</div>
			if from > 0 {
				<p class="text-sm text-muted-foreground">↑ { itoa(from) } more</p>
			}
			<ul role="listbox" aria-label="Stories" tabindex="0"
				if i := a.index(); i >= 0 {
					aria-activedescendant={ optionID(i) }
				}
				{ surf.On(ctx, "book-list", surf.Key(a.ListKey), surf.Focus(a.ListFocus))... }>
				if len(sts) == 0 {
					<li class="book-group" role="presentation">No story matches.</li>
				}
				for i, st := range sts {
					if heading := a.groupHeading(from+i, from); heading != "" {
						<li class="book-group" role="presentation">{ heading }</li>
					}
					<li role="option" aria-selected={ bstr(st.ID == a.ID) } class={ "book-item", templ.KV("book-chosen", st.ID == a.ID) } { surf.On(ctx, optionID(a.storyIndex(st.ID)), surf.Click(a.Pick(st.ID)))... }>{ a.storyLabel(st.ID) }</li>
				}
			</ul>
			if below > 0 {
				<p class="text-sm text-muted-foreground">↓ { itoa(below) } more</p>
			}
			<p class="book-hints text-muted-foreground">↑↓ story · / filter · Enter preview · n pane · Esc list · t theme</p>
		</aside>
		if a.cur != nil {
			<main class="book-main flex flex-col">
				<header class="book-header flex items-center gap-2">
					<span class="book-crumb text-muted-foreground">{ a.model.Sel.Group }</span>
					<span class="font-semibold">{ a.model.Sel.Name }</span>
					<span class="text-sm text-muted-foreground">{ a.cur.st.Doc }</span>
					@ui.Button(ui.ButtonProps{Variant: ui.Outline, Size: ui.XSmall, Class: "book-reset", Attrs: noTab(surf.On(ctx, "book-reset", surf.Click(a.resetStory)))}) { Reset }
				</header>
				if k := keysLine(a.cur.st); k != "" {
					<p class="book-keys text-sm text-muted-foreground">{ k }</p>
				}
				<div class="book-previews flex gap-4">
					<section class="book-html" aria-label="Preview" data-hotty-modal-root tabindex="-1" { surf.On(ctx, "book-preview", surf.Focus(func(bool) {}))... }>
						@a.cur.view
					</section>
					<section id="book-cells" class="book-cells hidden flex-col gap-2" aria-label="the story in cells">
						{{ ls := a.lines() }}
						{{ inert := a.inert(ctx) }}
						{{ tab := a.cur.controls && !inert }}
						<span class="book-edge text-sm text-muted-foreground"
							if tab { tabindex="0" }
							{ surf.On(ctx, "book-pane-before", surf.Focus(a.Edge(true)))... }>in cells</span>
						<div class="book-pane"
							if tab { tabindex="0" }
							{ surf.On(ctx, "book-pane", surf.Key(a.PaneKey), surf.Focus(a.PaneFocus), surf.Outside(a.PaneOutside))... }>
							for _, l := range ls {
								<div class="book-line">
									for _, sg := range l {
										<span class={ sg.class }>{ sg.text }</span>
									}
								</div>
							}
						</div>
						<span if tab { tabindex="0" } { surf.On(ctx, "book-pane-after", surf.Focus(a.Edge(false)))... }></span>
						if e := a.paneErr(); e != "" {
							<p class="text-sm text-destructive">{ e }</p>
						}
					</section>
				</div>
				@ui.Tabs(ui.TabsProps{ID: "book-tabs", Value: a.model.Tab, OnChange: a.model.SetTab, Tabs: []ui.Tab{{Value: storybook.TabSource, Label: "Source"}, {Value: storybook.TabProps, Label: "Props"}, {Value: storybook.TabEvents, Label: "Events"}, {Value: storybook.TabHTML, Label: "HTML"}}}) {
					<div class="book-panel" tabindex="-1" { surf.On(ctx, "book-panel", surf.Focus(func(bool) {}))... }>
						switch a.model.Tab {
							case storybook.TabSource:
								for _, src := range a.model.Sel.Sources() {
									<p class="text-sm text-muted-foreground">{ src.Title } · { src.Path }:{ itoa(src.Line) }</p>
									@code.View(src.Code, src.Lang, src.Line)
								}
							case storybook.TabProps:
								if a.model.Sel.Props() == nil {
									<p class="text-sm text-muted-foreground">No editable props for this story.</p>
								} else {
									for _, c := range a.model.Sel.Controls() {
										<label class="book-control">
											<span>{ c.Path }</span>
											if c.Kind == "bool" {
												<input type="checkbox" checked?={ c.Value == "true" } { surf.On(ctx, "book-control-"+c.Path, surf.Check(a.setBool(c.Path)))... }/>
											} else {
												@ui.Input(ui.InputProps{Value: c.Value, Attrs: surf.On(ctx, "book-control-"+c.Path, surf.Input(a.setProp(c.Path)))})
											}
										</label>
									}
									@code.View(storybook.Pretty(a.model.Sel.Props()), "go", 1)
								}
							case storybook.TabEvents:
								@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Size: ui.XSmall, Attrs: surf.On(ctx, "book-clear-events", surf.Click(a.clearEvents))}) { Clear }
								if len(a.model.Events(a.model.Sel)) == 0 {
									<p class="text-sm text-muted-foreground">Nothing yet: use the component, and what it does shows here.</p>
								}
								for _, e := range a.model.Events(a.model.Sel) {
									<p>{ e.Kind }: { e.Text }</p>
								}
							case storybook.TabHTML:
								@code.View(a.storyHTML(), "html", 1)
						}
					</div>
				}
			</main>
			if a.takeRefocus() {
				{{ surf.Autofocus(ctx, "book-pane") }}
			}
		}
		if target := a.focusRequest(ctx); target != "" {
			{{ surf.Autofocus(ctx, target) }}
		} else if a.takeToList() || a.startingList(ctx) {
			{{ surf.Autofocus(ctx, "book-list") }}
		}
		{{ a.keep(ctx) }}
	</div>
}
