// The book's view, ported from the spike's htmlbook: navigation, a live
// preview, and the source, props, events and HTML inspection tabs.
package book

import (
	"strconv"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/surfkey"
	storybook "neuroplast.io/hotty-surf/internal/book/model"
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/button"
	"neuroplast.io/hotty-surf/surfui/checkbox"
	"neuroplast.io/hotty-surf/surfui/code"
	"neuroplast.io/hotty-surf/surfui/eventlog"
	"neuroplast.io/hotty-surf/surfui/input"
	"neuroplast.io/hotty-surf/surfui/label"
	uiselect "neuroplast.io/hotty-surf/surfui/select"
	"neuroplast.io/hotty-surf/surfui/tabs"
	"neuroplast.io/hotty-surf/surfui/textarea"
)

templ View(a *App) {
	{{ a.sync() }}
	<div class={ "book flex", templ.KV("dark", a.model.Dark), templ.KV("light", !a.model.Dark) } { surf.On(ctx, "book", surf.Key(a.bookKey), surf.Bind(surfkey.CUAKeys()))... }>
		@sidebar(a)
		<main class="book-main flex flex-col">
			if a.cur != nil {
				@header(a)
				@preview(a)
				@tabs.View(tabs.Props{ID: "book-tabs", Label: "Story", Line: true, ListClass: "book-tabs-list", PanelClass: "book-tabs-panel overflow-auto max-h-[40vh]", Value: a.model.Tab, OnChange: a.model.SetTab, Tabs: []tabs.Tab{{Value: storybook.TabSource, Label: "Source"}, {Value: storybook.TabProps, Label: "Props"}, {Value: storybook.TabEvents, Label: "Events"}, {Value: storybook.TabHTML, Label: "HTML"}}}) {
					<div class="book-panel" tabindex="-1" { surf.On(ctx, "book-panel", surf.Focus(func(bool) {}))... }>
						switch a.model.Tab {
							case storybook.TabSource:
								@sources(a.model.Sel)
							case storybook.TabProps:
								@props(a)
							case storybook.TabEvents:
								@eventlog.View(eventlog.Props{ID: "book", Entries: a.entries(), OnClear: a.clearEvents, Empty: "Nothing yet: use the component, and what it does shows here."})
							case storybook.TabHTML:
								@htmlTab(a)
						}
					</div>
				}
			} else {
				<p class="text-muted-foreground">No stories.</p>
			}
		</main>
		if a.takeRefocus() {
			{{ surf.Refocus(ctx, "book-pane") }}
		}
		if target := a.focusRequest(ctx); target != "" {
			{{ surf.Autofocus(ctx, target) }}
		} else if a.takeToList() || a.startingList(ctx) {
			{{ a.nav.FocusList(ctx) }}
		}
		{{ a.keep(ctx) }}
	</div>
}

templ sidebar(a *App) {
	<aside class="book-list flex flex-col">
		<div class="book-brand flex items-center gap-2">
			<span class="font-semibold">hotty storybook</span>
			<span class="text-sm text-muted-foreground">{ strconv.Itoa(len(a.model.Stories)) }</span>
			{{ themeAttrs := surf.On(ctx, "book-theme", surf.Click(a.model.ToggleTheme)) }}
			{{ themeAttrs["title"] = "Theme (t)" }}
			@button.View(button.Props{Variant: surfui.Ghost, Size: surfui.XSmall, Attrs: themeAttrs}) {
				if a.model.Dark {
					Light
				} else {
					Dark
				}
			}
		</div>
		<div class="book-filter">
			@a.nav.FilterInput("book-filter-input")
		</div>
		@a.nav.List("book-nav max-h-[40vh] overflow-y-auto px-2 pb-2 md:max-h-none md:flex-1")
		<p class="book-hints text-muted-foreground">↑↓ story · / filter · Enter preview · n pane · r mode · Esc list · t theme</p>
	</aside>
}

templ header(a *App) {
	<div class="book-header flex items-center gap-2">
		<span class="book-crumb text-muted-foreground">{ a.model.Sel.Group }</span>
		<span class="font-semibold">{ a.model.Sel.Name }</span>
		if a.model.Sel.Doc != "" {
			<span class="book-doc text-muted-foreground">{ a.model.Sel.Doc }</span>
		}
		<div class="book-header-end flex items-center gap-2">
			@rating(a.model.Sel)
			{{ resetAttrs := noTab(surf.On(ctx, "book-reset", surf.Click(a.resetStory))) }}
			{{ resetAttrs["title"] = "Props back as the story has them; events cleared" }}
			@button.View(button.Props{Variant: surfui.Outline, Size: surfui.XSmall, Attrs: resetAttrs}) { Reset }
		</div>
	</div>
}

templ rating(s *storybook.Story) {
	if s.Dot != "red" {
		<span class="book-stars" title={ starTitle(s.Score) } aria-label={ starTitle(s.Score) }>
			for i := 1; i <= 5; i++ {
				if i <= s.Score {
					<span class="book-star-on">★</span>
				} else {
					<span class="book-star-off">☆</span>
				}
			}
		</span>
	}
}

func starTitle(score int) string {
	if score <= 0 {
		return "Unscored"
	}
	return strconv.Itoa(score) + "/5"
}

templ preview(a *App) {
	{{ a.model.Observe(a.model.Sel) }}
	<div class="book-preview-area flex flex-col">
		<nav class="book-renditions" role="tablist" aria-label="Mode">
			for _, m := range surfui.Modes {
				<button
					type="button"
					role="tab"
					tabindex="-1"
					aria-selected={ bstr(a.mode() == m) }
					{ surf.On(ctx, "book-render-"+m.String(), surf.Click(func() { a.setMode(m) }), surf.Key(a.modeKey))... }
				>{ m.String() }</button>
			}
		</nav>
		<section class="book-preview" aria-label="Preview" data-hotty-modal-root tabindex="-1" { surf.On(ctx, "book-preview", surf.Focus(func(bool) {}))... }>
			if a.mode() == surfui.ModeHotty {
				@a.cur.view
				{{ _ = a.inert(ctx) }}
			} else {
				@cellsPreview(a)
			}
		</section>
	</div>
}

templ paneRoot(c templ.Component) {
	<div { surf.On(ctx, "book-pane-cua", surf.Bind(surfkey.CUAKeys()))... }>
		@c
	</div>
}

templ cellsPreview(a *App) {
	<div id="book-cells" class="book-cells flex flex-col gap-2" aria-label={ "the story in " + a.mode().String() }>
		{{ pv := a.lines() }}
		{{ inert := a.inert(ctx) }}
		{{ tab := a.mode().Interactive() && a.cur.controls && !inert }}
		<span class="book-edge" aria-label="Enter cells preview" if tab { tabindex="0" } { surf.On(ctx, "book-pane-before", surf.Focus(a.Edge(true)))... }></span>
		<div class={ "book-pane", templ.KV("book-pane-gripping", a.gripping) } style={ pv.paneStyle() } data-steps={ a.paneSteps() } if tab { tabindex="0" } { surf.On(ctx, "book-pane", surf.Key(a.PaneKey, paneKeys...), surf.Focus(a.PaneFocus), surf.Outside(a.PaneOutside), surf.Drop(func(surf.DragEvent) {}))... }>
			for _, l := range pv.lines {
				<div class="book-line">
					for _, sg := range l {
						if sg.style != "" {
							<span class={ sg.class } style={ templ.SafeCSS(sg.style) }>{ sg.text }</span>
						} else {
							<span class={ sg.class }>{ sg.text }</span>
						}
					}
				</div>
			}
			for _, im := range pv.imgs {
				<div class="book-tui-img-wrap" style={ im.style() }>
					<img class="book-tui-img" { templ.Attributes{"src": templ.SafeURL(im.src)}... }/>
					if im.online {
						<span class="book-tui-img-dot"></span>
					}
				</div>
			}
			for _, hb := range pv.hits {
				if hb.isText && hb.disabled {
					<div
						class="book-hit book-hit-text book-hit-disabled"
						style={ hb.style() }
					></div>
				} else if hb.isText {
					<div
						class={ "book-hit book-hit-text", templ.KV("book-hit-focused", hb.focused) }
						style={ hb.style() }
						data-steps={ strconv.Itoa(hb.w) + " " + strconv.Itoa(hb.h) }
						{ surf.On(ctx, "hit-"+hb.id,
							surf.Drag(func(d surf.DragEvent) { a.PaneTextDrag(hb.col, hb.row, hb.w, hb.h, d) }),
							surf.Hover(func(in bool) { a.PaneHover(hb.col, hb.row, in) }),
						)... }
					></div>
				} else {
					<div
						class="book-hit"
						style={ hb.style() }
						{ surf.On(ctx, "hit-"+hb.id,
							surf.Click(func() { a.PaneClick(hb.col, hb.row) }),
							surf.Hover(func(in bool) { a.PaneHover(hb.col, hb.row, in) }),
						)... }
					></div>
				}
				if hb.hasGrip {
					<div
						class="book-grip"
						data-resize={ hb.resizeMode }
						style={ hb.gripStyle() }
						data-steps="1 1"
						{ surf.On(ctx, "grip-"+hb.id,
							surf.Drag(func(d surf.DragEvent) { a.PaneGripDrag(hb.gripCol, hb.gripRow, d) }),
						)... }
					>
						@templ.Raw(textarea.GripSVG)
					</div>
				}
			}
			if pv.caret.has {
				<div class={ "book-caret", templ.KV("book-caret-b", pv.caret.alt), templ.KV("book-caret-a", !pv.caret.alt) } style={ pv.caret.style() }></div>
			}
			if pv.focus.has {
				<div class="book-focus-ring" style={ pv.focus.style() }></div>
			}
		</div>
		<span if tab { tabindex="0" } { surf.On(ctx, "book-pane-after", surf.Focus(a.Edge(false)))... }></span>
		if e := a.paneErr(); e != "" {
			<p class="text-sm text-destructive">{ e }</p>
		}
	</div>
}

templ sources(s *storybook.Story) {
	for i, src := range s.Sources() {
		<div class={ "book-source-label", templ.KV("book-source-next", i > 0) }>
			<span class="font-semibold">{ src.Title }</span>
			<span class="text-muted-foreground">{ src.Path }:{ strconv.Itoa(src.Line) }</span>
		</div>
		@code.View(src.Code, src.Lang, src.Line)
	}
	if len(s.Sources()) == 0 {
		<p class="text-muted-foreground text-sm">No source: this build runs away from its source tree.</p>
	}
}

templ props(a *App) {
	if a.model.Sel.Props() == nil {
		<p class="text-sm text-muted-foreground">No editable props for this story.</p>
	} else {
		<div class="book-controls grid grid-cols-[minmax(0,auto)_minmax(0,1fr)] items-center gap-x-3 gap-y-2 text-sm">
			for _, c := range a.model.Sel.Controls() {
				{{ id := propControlID(c.Path) }}
				@label.View(label.Props{For: id, Class: "text-muted-foreground truncate font-mono text-xs"}) {
					{ c.Path }
				}
				@propControl(a, id, c)
			}
		</div>
		@code.View(storybook.Pretty(a.model.Sel.Props()), "go", 1)
	}
}

templ propControl(a *App, id string, c storybook.Control) {
	switch c.Kind {
		case "bool":
			<div>
				@checkbox.View(checkbox.Props{
					ID:       id,
					Checked:  c.Value == "true",
					OnChange: func(v bool) { a.model.Set(a.model.Sel, c.Path, strconv.FormatBool(v)) },
				})
			</div>
		case "enum":
			@uiselect.View(a.propSelect(c.Path), uiselect.Props{
				ID:       id,
				Items:    propSelectItems(c.Options),
				Value:    c.Value,
				OnChange: a.setProp(c.Path),
			})
		default:
			@input.View(input.Props{
				ID:      id,
				Type:    "text",
				Value:   c.Value,
				Class:   "h-8 w-full max-w-80 text-sm",
				OnInput: a.setProp(c.Path),
			})
	}
}

templ htmlTab(a *App) {
	<p class="text-muted-foreground mb-2 text-xs">The component's HTML as it renders it, formatted; an icon's svg is shortened to its class. The runtime adds an id to each element that has none before it goes to the host.</p>
	@code.View(a.storyHTML(), "html", 1)
}
