package main

import (
	_ "embed"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/ui"
)

//go:embed style/app.css
var appCSS string

// CSS is the app's own stylesheet (style/app.css), which hotty-surf run
// swaps in as the file is saved. The kit's is linked, not carried
// (ui.Sheet): sent once rather than in every document.
var CSS = appCSS

// Surface is the app's surface: Page styled by the kit's sheet, then CSS.
func Surface(a *App) *surf.Surface {
	s := surf.New("APPNAME", Page(a), CSS)
	s.Link(ui.Sheet())
	return s
}
