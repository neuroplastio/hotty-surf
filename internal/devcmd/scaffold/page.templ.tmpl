package main

import (
	"strconv"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/ui"
	"neuroplast.io/hotty-surf/ui/button"
)

// Page is the view: a function of the state, rendered again after every
// event.
templ Page(a *App) {
	<main class="flex flex-col gap-4 p-4">
		<h1 class="text-lg font-semibold">APPNAME</h1>
		<p class="text-sm text-muted-foreground">Count: { strconv.Itoa(a.Count) }</p>
		// A form's Submit hears Enter in its field and its submit button.
		<form class="flex gap-2" { surf.On(ctx, "add", surf.Submit(a.Add))... }>
			@ui.Input(ui.InputProps{
				Value:       a.By,
				Placeholder: "1",
				Attrs:       surf.On(ctx, "by", surf.Input(a.SetBy)),
			})
			@button.View(button.Props{Attrs: templ.Attributes{"type": "submit"}}) {
				Add
			}
			@button.View(button.Props{ID: "reset", Variant: ui.Outline, OnClick: a.Reset}) {
				Reset
			}
		</form>
	</main>
}
