package stories

import (
	"strconv"
	"time"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/ui"
	"neuroplast.io/hotty-surf/ui/code"
)

// NavDemo holds the retained navigation list used by a story.
type NavDemo struct { Nav ui.NavList }

// ControlsDemo holds the controls used by a story.
type ControlsDemo struct { Controls []ui.Control }

// LogDemo holds an event log's entries and whether it can be cleared.
type LogDemo struct {
	Entries []ui.LogEntry
	Clearable bool
}

func bookNav(filter string) ui.NavList {
	return ui.NavList{ID: "demo", Label: "Settings", Placeholder: "Filter  ( type here )", FilterLabel: "Filter settings", Empty: "Nothing matches.", Current: "profile", Filter: filter,
		Groups: []ui.NavGroup{
			{Name: "Account", Items: []ui.NavItem{{ID: "profile", Label: "Profile"}, {ID: "password", Label: "Password"}, {ID: "sessions", Label: "Sessions"}}},
			{Name: "Workspace", Items: []ui.NavItem{{ID: "members", Label: "Members"}, {ID: "billing", Label: "Billing"}, {ID: "danger", Label: "Danger zone"}}},
		}}
}

templ navDemo(p *NavDemo) {
	<div class="bg-sidebar text-sidebar-foreground flex w-64 flex-col rounded-md border p-2">
		@p.Nav.FilterInput("h-8 text-sm")
		@p.Nav.List("max-h-[40vh] overflow-y-auto pt-1")
	</div>
}

templ controlsDemo(p *ControlsDemo) {
	@ui.Controls(ui.ControlsProps{ID: "demo", Controls: p.Controls, Class: "max-w-md", OnChange: func(name, value string) {
		for i := range p.Controls {
			if p.Controls[i].Name == name { p.Controls[i].Value = value }
		}
	}})
}

func clearBookLog(p *LogDemo) func() {
	if !p.Clearable { return nil }
	return func() { p.Entries = nil }
}

templ logDemo(p *LogDemo) {
	<div class="flex w-full max-w-xl flex-col gap-3">
		<div>
			@ui.Button(ui.ButtonProps{Variant: ui.Outline, Size: ui.Small, Attrs: surf.On(ctx, "demo-add", surf.Click(func() {
				p.Entries = append(p.Entries, ui.LogEntry{At: time.Now(), Kind: "act", Text: "event " + strconv.Itoa(len(p.Entries)+1), KindClass: code.TokenClass("keyword")})
			}))}) { Add an event }
		</div>
		@ui.EventLog(ui.EventLogProps{ID: "demo", Entries: p.Entries, OnClear: clearBookLog(p), Empty: "Nothing yet: add an event."})
	</div>
}

func init() {
	for _, x := range []struct { id, filter string }{{"nav-list/default", ""}, {"nav-list/filtered", "an"}, {"nav-list/nothing-matches", "zzz"}} {
		x := x
		makeView := func() (any, templ.Component) { p := &NavDemo{Nav: bookNav(x.filter)}; return p, navDemo(p) }
		bookStories = append(bookStories, Story{ID: x.id, View: func() templ.Component { _, c := makeView(); return c }, Props: makeView})
	}
	for _, x := range []struct { id string; controls []ui.Control }{
		{"controls/default", []ui.Control{{Name: "Open", Kind: "bool", Value: "true"}, {Name: "Size", Kind: "enum", Value: "md", Options: []string{"sm", "md", "lg"}}, {Name: "Label", Kind: "string", Value: "Save"}, {Name: "Popup.Active", Kind: "int", Value: "-1"}}},
		{"controls/switches", []ui.Control{{Name: "Bold", Kind: "bool", Value: "false"}, {Name: "Italic", Kind: "bool", Value: "true"}}},
	} {
		x := x
		makeView := func() (any, templ.Component) { p := &ControlsDemo{Controls: append([]ui.Control(nil), x.controls...)}; return p, controlsDemo(p) }
		bookStories = append(bookStories, Story{ID: x.id, View: func() templ.Component { _, c := makeView(); return c }, Props: makeView})
	}
	at := time.Date(2026, 11, 16, 19, 8, 2, 285e6, time.Local)
	entries := []ui.LogEntry{{At: at, Kind: "state", Text: "Popup.Open: false → true", KindClass: "tok-string"}, {At: at.Add(330*time.Millisecond), Kind: "state", Text: "Popup.Active: -1 → 0", KindClass: "tok-string"}, {At: at.Add(572*time.Millisecond), Kind: "act", Text: "Profile", KindClass: "tok-keyword"}, {At: at.Add(574*time.Millisecond), Kind: "control", Text: "Size = large", KindClass: "tok-literal"}}
	for _, x := range []struct { id string; hasEntries, clearable bool }{{"event-log/default", true, true}, {"event-log/empty", false, true}, {"event-log/no-clear", true, false}} {
		x := x
		makeView := func() (any, templ.Component) {
			p := &LogDemo{Clearable: x.clearable}
			if x.hasEntries { p.Entries = append([]ui.LogEntry(nil), entries...) }
			return p, logDemo(p)
		}
		bookStories = append(bookStories, Story{ID: x.id, View: func() templ.Component { _, c := makeView(); return c }, Props: makeView})
	}
}
