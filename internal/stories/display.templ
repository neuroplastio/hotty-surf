package stories

import (
	"fmt"
	"slices"
	"strconv"
	"strings"

	"neuroplast.io/hotty-surf/ui"
	"neuroplast.io/hotty-surf/ui/button"
	"neuroplast.io/hotty-surf/ui/card"
	"neuroplast.io/hotty-surf/ui/textarea"
)

// The remaining legacy B2 display stories: Chart, Table, and Basecoat's
// scrollbar classes.

type displayState struct{}

// Table is the editable state of a sortable invoice table story.
type Table struct {
	Caption bool
	Sort    string `enum:"invoice,status,amount"`
}

// named is the aria-label that names a chart (kit rule K18).
func named(l string) templ.Attributes { return templ.Attributes{"aria-label": l} }

func logText() string {
	var b strings.Builder
	for i := range 20 {
		fmt.Fprintf(&b, "Line %d of the log\n", i+1)
	}
	return b.String()
}

func init() {
	show := func(f func(*displayState) templ.Component) func() templ.Component {
		return func() templ.Component { return f(&displayState{}) }
	}
	add(Story{ID: "chart/bar", Doc: "A bar chart of two series", View: show(chartBar)})
	add(Story{ID: "chart/line", Doc: "A line chart of two series", View: show(chartLine)})
	add(Story{ID: "chart/pie", Doc: "A pie of five slices, its labels beside their colours", View: show(chartPie)})
	add(Story{ID: "chart/legend", Doc: "Bar charts of two series and of one, with their legends", View: show(chartLegend)})
	add(Story{ID: "chart/wide", Doc: "A short, wide line chart of a month by day (Aspect 3), labelled every fifth day", View: show(chartWide)})
	add(Story{ID: "chart/narrow", Doc: "A bar chart in a narrow card: its long labels are cut, not widening it", View: show(chartNarrow)})
	add(Story{ID: "scrollbar/default", Doc: "A plain box of twenty lines that scrolls, with Basecoat's scrollbar class", View: show(scrollbarDefault)})
	add(Story{ID: "scrollbar/small", Doc: "A Textarea of twenty lines with the scrollbar-sm class", View: show(scrollbarSmall)})
	add(Story{ID: "table/default", Doc: "A table of invoices with a selected row, a footer and a caption", View: show(tableDefault), Props: func() (any, templ.Component) {
		p := &Table{Caption: true, Sort: "invoice"}
		return p, bookTable(p)
	}})
}

var (
	months  = []string{"Jan", "Feb", "Mar", "Apr", "May", "Jun"}
	visits  = []ui.ChartSeries{{Label: "Desktop", Values: []float64{186, 305, 237, 73, 209, 214}}, {Label: "Mobile", Values: []float64{80, 200, 120, 190, 130, 140}}}
	browser = ui.ChartProps{Type: "pie", Labels: []string{"Arc", "Firefox", "Safari", "Edge", "Other"},
		Series: []ui.ChartSeries{{Label: "Visitors", Values: []float64{275, 200, 187, 173, 90}}},
		Attrs:  named("Visitors by browser")}
)

templ chartBar(s *displayState) {
	<div class="p-4 max-w-md">
		@ui.Chart(ui.ChartProps{Labels: months, Series: visits, Attrs: named("Visitors by month")})
	</div>
}

templ chartLine(s *displayState) {
	<div class="p-4 max-w-md">
		@ui.Chart(ui.ChartProps{Type: "line", Labels: months, Series: visits, Attrs: named("Visitors by month")})
	</div>
}

templ chartPie(s *displayState) {
	<div class="p-4 max-w-sm">
		@ui.Chart(browser)
	</div>
}

templ chartLegend(s *displayState) {
	<div class="p-4 max-w-md grid gap-4">
		@ui.Chart(ui.ChartProps{Labels: months, Series: visits, Legend: true, Attrs: named("Visitors by month")})
		@ui.Chart(ui.ChartProps{Type: "bar", Labels: months, Series: visits[:1], Legend: true, Attrs: named("Desktop visitors by month")})
	</div>
}

// days are a month by day, labelled every fifth: "" writes no label.
var days, sales = func() ([]string, []float64) {
	var ls []string
	var vs []float64
	for d := 1; d <= 30; d++ {
		l := ""
		if d == 1 || d%5 == 0 {
			l = fmt.Sprint(d)
		}
		ls = append(ls, l)
		vs = append(vs, float64(40+(d*37)%55+d))
	}
	return ls, vs
}()

templ chartWide(s *displayState) {
	<div class="p-4">
		@ui.Chart(ui.ChartProps{Type: "line", Aspect: 3, Labels: days,
			Series: []ui.ChartSeries{{Label: "Orders", Values: sales}}, Attrs: named("Orders by day")})
	</div>
}

templ chartNarrow(s *displayState) {
	<div class="p-4" style="width: 16rem;">
		@card.View(card.Props{Size: ui.Small}) {
			<header>
				<h2>By channel</h2>
			</header>
			<section>
				@ui.Chart(ui.ChartProps{Labels: []string{"Shop", "Marketplace", "Wholesale", "Fairs"},
					Series: []ui.ChartSeries{{Label: "Orders", Values: []float64{412, 676, 233, 98}}}, Attrs: named("Orders by channel")})
			</section>
		}
	</div>
}

templ lines() {
	for i := range 20 {
		<p class="text-sm py-1">Line { strconv.Itoa(i + 1) } of the log</p>
	}
}

templ scrollbarDefault(s *displayState) {
	<div class="p-4 max-w-sm">
		<div class="scrollbar p-2" style="height: 12rem; overflow-y: auto;">
			@lines()
		</div>
	</div>
}

templ scrollbarSmall(s *displayState) {
	<div class="p-4 max-w-sm">
		@textarea.View(textarea.Props{Value: logText(), Class: "scrollbar-sm", Attrs: templ.Attributes{"style": "height: 12rem;"}})
	</div>
}

type invoice struct{ id, status, method, amount string }

var invoices = []invoice{
	{"INV001", "Paid", "Credit card", "$250.00"},
	{"INV002", "Pending", "Bank transfer", "$150.00"},
	{"INV003", "Unpaid", "Credit card", "$350.00"},
}

templ tableDefault(s *displayState) {
	<div class="p-4 max-w-md">
		@ui.Table(ui.TableProps{}) {
			<caption>Recent invoices.</caption>
			<thead>
				<tr><th>Invoice</th><th>Status</th><th>Method</th><th style="text-align: right;">Amount</th></tr>
			</thead>
			<tbody>
				for i, v := range invoices {
					<tr
						if i == 1 {
							data-state="selected"
						}
					>
						<td class="font-medium">{ v.id }</td>
						<td>{ v.status }</td>
						<td>{ v.method }</td>
						<td style="text-align: right;">{ v.amount }</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr><td colspan="3">Total</td><td style="text-align: right;">$750.00</td></tr>
			</tfoot>
		}
	</div>
}

var bookInvoices = []invoice{
	{"INV001", "Paid", "Credit card", "$250.00"},
	{"INV002", "Pending", "PayPal", "$150.00"},
	{"INV003", "Unpaid", "Bank transfer", "$350.00"},
	{"INV004", "Paid", "Credit card", "$450.00"},
	{"INV005", "Paid", "PayPal", "$550.00"},
}

func sortedInvoices(by string) []invoice {
	out := slices.Clone(bookInvoices)
	slices.SortStableFunc(out, func(a, b invoice) int {
		switch by {
		case "status": return strings.Compare(a.status, b.status)
		case "amount": return strings.Compare(a.amount, b.amount)
		default: return strings.Compare(a.id, b.id)
		}
	})
	return out
}

templ bookTable(p *Table) {
	@ui.Table(ui.TableProps{}) {
		if p.Caption {
			<caption>A list of your recent invoices.</caption>
		}
		<thead><tr>
			for _, col := range []string{"invoice", "status", "amount"} {
				<th>
					@button.View(button.Props{ID: "th-" + col, Variant: ui.Ghost, OnClick: func() { p.Sort = col }}) {
						{ col }
						if p.Sort == col {
							@ui.Icon("arrow-down", "size-3.5")
						}
					}
				</th>
			}
			<th>Method</th>
		</tr></thead>
		<tbody>
			for _, row := range sortedInvoices(p.Sort) {
				<tr><td>{ row.id }</td><td>{ row.status }</td><td>{ row.amount }</td><td>{ row.method }</td></tr>
			}
		</tbody>
	}
}
