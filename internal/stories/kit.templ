package stories

import (
	"strconv"
	"strings"
	"time"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/ui"
	"neuroplast.io/hotty-surf/ui/button"
)

// The stories of the components L1 made: Button, Badge, Card, Kbd, Select,
// DropdownMenu, Dialog, Tabs and Toaster.

type kitState struct {
	clicks int
	value  string
	values []string
	checked bool
	theme string
	ran    string
	open   bool
	sel    ui.SelectState
	menu   ui.DropdownMenuState
	toasts ui.ToasterState
}

// labelled names an icon-only button, which has no text of its own: its
// handlers' attributes, with its aria-label (kit rule K18).
func labelled(a templ.Attributes, name string) templ.Attributes {
	a["aria-label"] = name
	return a
}

// Button is the editable state of a button story.
type Button struct {
	Label string
	Variant string `enum:"primary,secondary,destructive,outline,ghost,link"`
	Size string `enum:"default,xs,sm,lg"`
	Disabled bool
	Icon bool
	Clicks int
}

// BadgeProps is the editable state of a badge story.
type BadgeProps struct {
	Variant string `enum:"default,secondary,destructive,outline,ghost,link"`
	Label string
}

// Card is the editable state of a card story.
type Card struct {
	Title string
	Description string
	Size string `enum:"default,sm"`
	Footer bool
}

// Tabs is the editable state of a tabs story.
type Tabs struct {
	Tab string `enum:"account,password,team"`
	Line bool
}

// Kbd is the editable state of a keyboard-shortcut story.
type Kbd struct { Keys string }

func (s *kitState) click()           { s.clicks++ }
func (s *kitState) choose(v string)  { s.value = v }
func (s *kitState) run(v string) func() { return func() { s.ran = v } }

func init() {
	kit := func(f func(*kitState) templ.Component, init func(*kitState)) func() templ.Component {
		return func() templ.Component {
			s := &kitState{}
			if init != nil {
				init(s)
			}
			return f(s)
		}
	}
	add(Story{ID: "button/default", Doc: "A primary button",
		View: kit(buttonDefault, nil), Props: func() (any, templ.Component) {
			p := &Button{Label: "Button", Variant: "primary", Size: "default"}
			return p, bookButton(p)
		}, Keys: []string{"tab", "enter", "space"}, Want: "clicks: 2"})
	add(Story{ID: "button/destructive", Doc: "A destructive button",
		View: kit(buttonDestructive, nil), Props: func() (any, templ.Component) {
			p := &Button{Label: "Delete", Variant: "destructive", Size: "default"}
			return p, bookButton(p)
		}, Keys: []string{"tab", "enter"}, Want: "clicks: 1"})
	add(Story{ID: "button/ghost-with-icon", Doc: "A ghost button with an icon, and an icon-only one",
		View: kit(buttonGhostWithIcon, nil), Props: func() (any, templ.Component) {
			p := &Button{Label: "New", Variant: "ghost", Size: "sm", Icon: true}
			return p, bookButton(p)
		}, Keys: []string{"tab", "tab", "enter"}, Want: "clicks: 1"})
	add(Story{ID: "button/disabled", Doc: "A disabled button, which Tab passes over",
		View: kit(buttonDisabled, nil), Props: func() (any, templ.Component) {
			p := &Button{Label: "Saving…", Variant: "primary", Size: "default", Disabled: true}
			return p, bookButton(p)
		}, Keys: []string{"tab", "enter"}, Want: "clicks: 0"})
	add(Story{ID: "button/every-variant-and-size", Doc: "Each variant, and each size with and without IconOnly",
		View: kit(buttonEvery, nil), Props: func() (any, templ.Component) {
			p := &Button{}
			return p, buttonEvery(&kitState{})
		}, Keys: []string{"tab", "enter"}, Want: "clicks: 1"})
	add(Story{ID: "badge/default", Doc: "A badge", View: kit(badgeDefault, nil), Props: func() (any, templ.Component) {
		p := &BadgeProps{Variant: "default", Label: "Badge"}
		return p, bookBadge(p)
	}})
	add(Story{ID: "badge/every-variant", Doc: "A badge of each variant", View: kit(badgeEvery, nil), Props: func() (any, templ.Component) {
		p := &BadgeProps{}
		return p, badgeEvery(&kitState{})
	}})
	add(Story{ID: "badge/warning", Doc: "A warning: Basecoat has no such variant, so an Outline badge in amber, by class", View: kit(badgeWarning, nil)})
	add(Story{ID: "card/default", Doc: "A card with a header, a section and a footer", View: kit(cardDefault, nil), Props: func() (any, templ.Component) {
		p := &Card{Title: "Sign up", Description: "Enter your email below.", Size: "default", Footer: true}
		return p, bookCard(p)
	}})
	add(Story{ID: "kbd/default", Doc: "Shortcuts as the host's platform writes them", View: kit(kbdDefault, nil), Props: func() (any, templ.Component) {
		p := &Kbd{Keys: "ctrl+k"}
		return p, bookKbd(p)
	}})
	add(Story{ID: "select/default", Doc: "A select with a placeholder",
		View: kit(selectDefault, nil), Keys: []string{"tab", "enter", "arrow_down", "arrow_down", "enter"}, Want: "size: m"})
	add(Story{ID: "select/multiple", Doc: "Select several sizes",
		View: kit(selectMultiple, nil), Keys: []string{"tab", "enter", "arrow_down", "enter", "arrow_down", "enter"}, Want: "sizes: s,m"})
	add(Story{ID: "select/end-aligned", Doc: "A select aligned to the right edge",
		View: kit(selectEndAligned, nil), Keys: []string{"tab", "enter", "arrow_down", "enter"}, Want: "size: s"})
	add(Story{ID: "select/grouped", Doc: "A select with groups and a disabled option",
		View: kit(selectGrouped, func(s *kitState) { s.value = "apple" }), Keys: []string{"tab", "enter", "arrow_down", "enter"}, Want: "fruit: banana"})
	add(Story{ID: "dropdown-menu/default", Doc: "A menu with an icon, a shortcut, a disabled item and a group",
		View: kit(menuDefault, nil), Keys: []string{"tab", "enter", "arrow_down", "enter"}, Want: "ran: profile"})
	add(Story{ID: "dropdown-menu/end-aligned", Doc: "A menu aligned to its trigger's end",
		View: kit(menuEndAligned, nil), Keys: []string{"tab", "enter", "arrow_down", "enter"}, Want: "ran: profile"})
	add(Story{ID: "dropdown-menu/checkbox-radio", Doc: "Checkbox and radio items in a menu",
		View: kit(menuChecks, nil), Keys: []string{"tab", "enter", "arrow_down", "enter"}, Want: "checked: on"})
	add(Story{ID: "dialog/default", Doc: "A dialog its button opens, with a field and a footer",
		View: kit(dialogDefault, nil), Keys: []string{"tab", "enter", "escape"}, Want: "open: off"})
	add(Story{ID: "dialog/open", Doc: "A dialog open from the start",
		View: kit(dialogOpen, func(s *kitState) { s.open = true }), Keys: []string{"tab", "enter"}, Want: "open: off"})
	add(Story{ID: "dialog/without-close-button", Doc: "A dialog without the corner close button",
		View: kit(dialogNoClose, nil), Keys: []string{"tab", "enter", "escape"}, Want: "open: off"})
	add(Story{ID: "tabs/default", Doc: "Three tabs, the shown one's panel below",
		View: kit(tabsDefault, func(s *kitState) { s.value = "account" }), Props: func() (any, templ.Component) {
			p := &Tabs{Tab: "account"}
			return p, bookTabs(p)
		}, Keys: []string{"tab", "arrow_right"}, Want: "tab: password"})
	add(Story{ID: "tabs/line", Doc: "Tabs in the line style", View: func() templ.Component {
		return bookTabs(&Tabs{Tab: "password", Line: true})
	}, Props: func() (any, templ.Component) {
		p := &Tabs{Tab: "password", Line: true}
		return p, bookTabs(p)
	}, Keys: []string{"tab", "arrow_right"}, Want: "Invite your team and pick what they can see."})
	add(Story{ID: "tabs/many", Doc: "More tabs than fit, one disabled",
		View: kit(tabsMany, func(s *kitState) { s.value = "t1" }), Keys: []string{"tab", "end"}, Want: "tab: t8"})
	add(Story{ID: "toast/default", Doc: "A button that shows a toast",
		View: kit(toastDefault, nil), Keys: []string{"tab", "enter"}, Want: "Event created"})
	add(Story{ID: "toast/categories", Doc: "A button for each category of toast",
		View: kit(toastCategories, nil), Keys: []string{"tab", "tab", "enter"}, Want: "Couldn't save"})
	add(Story{ID: "toast/action", Doc: "A toast with an undo action",
		View: kit(toastAction, nil), Keys: []string{"tab", "enter", "tab", "enter"}, Want: "action: undone"})
	add(Story{ID: "toast/owned", Doc: "A toast the app owns: focused by its keys, its countdown bar still, a corner x",
		View: kit(toastOwned, showOwnedToast), Keys: []string{"tab", "tab", "enter"}, Want: "ran: opened"})
}

templ count(s *kitState) {
	<p class="text-sm text-muted-foreground">clicks: { strconv.Itoa(s.clicks) }</p>
}

templ buttonDefault(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		<div>
			@button.View(button.Props{ID: "save", OnClick: s.click}) {
				Save
			}
		</div>
		@count(s)
	</div>
}

templ bookButton(p *Button) {
	<div class="flex flex-col gap-3">
		<div>
			@button.View(button.Props{ID: "save", Variant: bookVariant(p.Variant), Size: bookSize(p.Size), Disabled: p.Disabled, OnClick: func() { p.Clicks++ }}) {
				if p.Icon {
					@ui.Icon("circle-plus", "")
				}
				{ p.Label }
			}
		</div>
	</div>
}

func bookVariant(v string) ui.Variant {
	if v == "default" || v == "primary" { return ui.Primary }
	return ui.Variant(v)
}

func bookSize(v string) ui.Size {
	if v == "default" { return ui.Medium }
	return ui.Size(v)
}

templ bookBadge(p *BadgeProps) {
	<div class="p-4">
		@ui.Badge(ui.BadgeProps{Variant: bookVariant(p.Variant)}) { { p.Label } }
	</div>
}

templ bookCard(p *Card) {
	@ui.Card(ui.CardProps{Size: bookSize(p.Size), Class: "max-w-sm"}) {
		<header><h2>{ p.Title }</h2><p>{ p.Description }</p></header>
		<section>
			@ui.Label(ui.LabelProps{For: "card-email"}) { Email }
			@ui.Input(ui.InputProps{Type: "email", Placeholder: "m@example.com", Attrs: surf.On(ctx, "card-email")})
		</section>
		if p.Footer {
			<footer class="flex gap-2">
				@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "card-cancel", surf.Click(func() {}))}) { Cancel }
				@ui.Button(ui.ButtonProps{Attrs: surf.On(ctx, "card-ok", surf.Click(func() {}))}) { Sign up }
			</footer>
		}
	}
}

templ bookKbd(p *Kbd) {
	<p class="text-muted-foreground flex items-center gap-1 text-sm">
		Press
		@ui.Kbd(p.Keys)
		to open the palette.
	</p>
}

templ bookTabs(p *Tabs) {
	<div class="w-full max-w-md">
		@ui.Tabs(ui.TabsProps{ID: "story-tabs", Label: "Example", Line: p.Line, Value: p.Tab, ListClass: "w-full", Tabs: []ui.Tab{{Value: "account", Label: "account"}, {Value: "password", Label: "password"}, {Value: "team", Label: "team"}}, OnChange: func(v string) { p.Tab = v }}) {
			@ui.Card(ui.CardProps{}) {
				<section class="text-sm">{ bookTabText(p.Tab) }</section>
			}
		}
	</div>
}

// bookTabText is the spike's panel text for each tab.
func bookTabText(tab string) string {
	switch tab {
	case "account":
		return "Make changes to your account here. Click save when you're done."
	case "password":
		return "Change your password here. After saving, you'll be logged out."
	}
	return "Invite your team and pick what they can see."
}

templ buttonDestructive(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		<div>
			@button.View(button.Props{ID: "delete", Variant: ui.Destructive, OnClick: s.click}) {
				Delete
			}
		</div>
		@count(s)
	</div>
}

templ buttonGhostWithIcon(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		<div class="flex flex-row gap-2">
			@button.View(button.Props{ID: "new", Variant: ui.Ghost, OnClick: s.click}) {
				@ui.Icon("plus", "")
				New
			}
			@button.View(button.Props{ID: "settings", Variant: ui.Ghost, IconOnly: true, Label: "Settings", OnClick: s.click}) {
				@ui.Icon("settings-2", "")
			}
		</div>
		@count(s)
	</div>
}

templ buttonDisabled(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		<div>
			@button.View(button.Props{ID: "save", Disabled: true, OnClick: s.click}) {
				Save
			}
		</div>
		@count(s)
	</div>
}

var (
	allVariants = []ui.Variant{ui.Primary, ui.Secondary, ui.Destructive, ui.Outline, ui.Ghost, ui.Link}
	allSizes    = []ui.Size{ui.XSmall, ui.Small, ui.Medium, ui.Large}
)

func variantName(v ui.Variant) string {
	if v == ui.Primary {
		return "primary"
	}
	return string(v)
}

func sizeName(z ui.Size) string {
	if z == ui.Medium {
		return "medium"
	}
	return string(z)
}

templ buttonEvery(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		// As the spike's: a row of every variant for each size; then, for
		// IconOnly, an icon button of each size.
		for _, z := range allSizes {
			<div class="flex flex-row flex-wrap items-center gap-2">
				for _, v := range allVariants {
					@button.View(button.Props{Size: z, Variant: v, OnClick: s.click}) {
						{ variantName(v) }
					}
				}
			</div>
		}
		<div class="flex flex-row flex-wrap items-center gap-2">
			for _, z := range allSizes {
				@button.View(button.Props{Size: z, IconOnly: true, Variant: ui.Outline, Label: "Add (" + sizeName(z) + ")", OnClick: s.click}) {
					@ui.Icon("plus", "")
				}
			}
		</div>
		@count(s)
	</div>
}

templ badgeDefault(s *kitState) {
	<div class="p-4">
		@ui.Badge(ui.BadgeProps{}) {
			Badge
		}
	</div>
}

templ badgeEvery(s *kitState) {
	<div class="flex flex-row flex-wrap gap-2 p-4">
		for _, v := range allVariants {
			@ui.Badge(ui.BadgeProps{Variant: v}) {
				{ variantName(v) }
			}
		}
	</div>
}

templ badgeWarning(s *kitState) {
	<div class="flex flex-row flex-wrap items-center gap-2 p-4">
		@ui.Badge(ui.BadgeProps{Variant: ui.Outline, Class: "border-amber-500/50 text-amber-600 dark:text-amber-400"}) {
			@ui.Icon("triangle-alert", "")
			Low stock
		}
		<span class="text-sm text-muted-foreground">3 left</span>
	</div>
}

templ cardDefault(s *kitState) {
	<div class="p-4 max-w-sm">
		@ui.Card(ui.CardProps{}) {
			<header>
				<h2>Create project</h2>
				<p>Deploy your new project in one click.</p>
			</header>
			<section>
				@ui.Input(ui.InputProps{Value: s.value, Placeholder: "Name of your project", Attrs: surf.On(ctx, "name", surf.Input(s.choose))})
			</section>
			<footer class="flex flex-row justify-between">
				@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "cancel", surf.Click(s.click))}) {
					Cancel
				}
				@ui.Button(ui.ButtonProps{Attrs: surf.On(ctx, "deploy", surf.Click(s.click))}) {
					Deploy
				}
			</footer>
		}
	</div>
}

templ kbdDefault(s *kitState) {
	<div class="flex flex-row gap-2 p-4">
		@ui.Kbd("mod+k")
		@ui.Kbd("mod+shift+p")
		@ui.Kbd("escape")
	</div>
}

var sizeItems = []ui.SelectItem{
	{Value: "s", Label: "Small"},
	{Value: "m", Label: "Medium"},
	{Value: "l", Label: "Large"},
}

var fruitItems = []ui.SelectItem{
	{Value: "apple", Label: "Apple", Group: "Fruits"},
	{Value: "banana", Label: "Banana", Group: "Fruits"},
	{Value: "carrot", Label: "Carrot", Group: "Vegetables"},
	{Value: "leek", Label: "Leek", Group: "Vegetables", Disabled: true},
}

templ selectDefault(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		@ui.Select(&s.sel, ui.SelectProps{ID: "size", Items: sizeItems, Value: s.value, Placeholder: "Pick a size", OnChange: s.choose})
		<p class="text-sm text-muted-foreground">size: { s.value }</p>
	</div>
}

templ selectGrouped(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		@ui.Select(&s.sel, ui.SelectProps{ID: "fruit", Items: fruitItems, Value: s.value, OnChange: s.choose})
		<p class="text-sm text-muted-foreground">fruit: { s.value }</p>
	</div>
}

templ selectMultiple(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		@ui.Select(&s.sel, ui.SelectProps{ID:"sizes", Items:sizeItems, Multiple:true, Values:s.values, Placeholder:"Pick sizes", OnValuesChange:func(v []string){s.values=v}})
		<p>sizes: { strings.Join(s.values, ",") }</p>
	</div>
}

templ selectEndAligned(s *kitState) {
	<div class="p-4">
		<div class="flex flex-row justify-between">
			<span></span>
			@ui.Select(&s.sel, ui.SelectProps{ID:"edge", Items:sizeItems, Value:s.value, Placeholder:"Pick a size", Align:"end", OnChange:s.choose})
		</div>
		<p>size: { s.value }</p>
	</div>
}

func (s *kitState) menuItems() []ui.MenuItem {
	return []ui.MenuItem{
		{Label: "Profile", Icon: "settings-2", Keys: "mod+p", OnSelect: s.run("profile")},
		{Label: "Billing", Disabled: true, OnSelect: s.run("billing")},
		{Label: "Team", OnSelect: s.run("team")},
		{Label: "Delete", Group: "Danger", Variant: ui.Destructive, OnSelect: s.run("delete")},
	}
}

templ menuDefault(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		@ui.DropdownMenu(&s.menu, ui.DropdownMenuProps{ID: "account", Trigger: templ.Raw("Account"), Items: s.menuItems()})
		<p class="text-sm text-muted-foreground">ran: { s.ran }</p>
	</div>
}

templ menuEndAligned(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		<div class="flex flex-row justify-between">
			<span></span>
			@ui.DropdownMenu(&s.menu, ui.DropdownMenuProps{ID: "account", Trigger: templ.Raw("Account"), Items: s.menuItems(), Align: "end"})
		</div>
		<p class="text-sm text-muted-foreground">ran: { s.ran }</p>
	</div>
}

templ menuChecks(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		@ui.DropdownMenu(&s.menu, ui.DropdownMenuProps{ID:"choices", Trigger:templ.Raw("Choices"), Items:[]ui.MenuItem{
			{Label:"Show status", Role:"menuitemcheckbox", Checked:s.checked, OnCheckedChange:func(v bool){s.checked=v}},
			{Label:"Light", Group:"Theme", Role:"menuitemradio", Checked:s.theme=="light", OnCheckedChange:func(v bool){if v {s.theme="light"}}},
			{Label:"Dark", Group:"Theme", Role:"menuitemradio", Checked:s.theme=="dark", OnCheckedChange:func(v bool){if v {s.theme="dark"}}},
		}})
		<p>checked: { onoff(s.checked) }</p>
	</div>
}

templ dialogBody(s *kitState) {
	@ui.Dialog(ui.DialogProps{ID: "rename", Open: s.open, Title: "Rename", Description: "Give the project a new name.", OnClose: func() { s.open = false }}) {
		<section>
			@ui.Input(ui.InputProps{Value: s.value, Attrs: surf.On(ctx, "name", surf.Input(s.choose))})
		</section>
		<footer>
			@ui.Button(ui.ButtonProps{Attrs: surf.On(ctx, "save", surf.Click(func() { s.open = false }))}) {
				Save
			}
		</footer>
	}
	<p class="text-sm text-muted-foreground">open: { onoff(s.open) }</p>
}

templ dialogNoClose(s *kitState) {
	<div class="p-4">
		@ui.Button(ui.ButtonProps{Attrs:surf.On(ctx,"open-no-close",surf.Click(func(){s.open=true}))}) { Open }
		@ui.Dialog(ui.DialogProps{ID:"no-close", Open:s.open, Title:"Confirm", HideCloseButton:true, OnClose:func(){s.open=false}}) {
			<footer>@ui.Button(ui.ButtonProps{Attrs:surf.On(ctx,"done-no-close",surf.Click(func(){s.open=false}))}) { Done }</footer>
		}
		<p>open: { onoff(s.open) }</p>
	</div>
}

templ dialogDefault(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		<div>
			@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "open", surf.Click(func() { s.open = true }))}) {
				Rename
			}
		</div>
		@dialogBody(s)
	</div>
}

templ dialogOpen(s *kitState) {
	<div class="flex flex-col gap-3 p-4">
		@dialogBody(s)
	</div>
}

templ tabsDefault(s *kitState) {
	<div class="flex flex-col gap-3 p-4 max-w-md">
		@ui.Tabs(ui.TabsProps{ID: "settings", Value: s.value, OnChange: s.choose,
			Tabs: []ui.Tab{{Value: "account", Label: "Account"}, {Value: "password", Label: "Password"}, {Value: "team", Label: "Team"}}}) {
			<p>The { s.value } settings.</p>
		}
		<p class="text-sm text-muted-foreground">tab: { s.value }</p>
	</div>
}

func manyTabs() []ui.Tab {
	var ts []ui.Tab
	for i := 1; i <= 8; i++ {
		n := strconv.Itoa(i)
		ts = append(ts, ui.Tab{Value: "t" + n, Label: "Tab " + n, Disabled: i == 4})
	}
	return ts
}

templ tabsMany(s *kitState) {
	<div class="flex flex-col gap-3 p-4 max-w-md">
		@ui.Tabs(ui.TabsProps{ID: "many", Value: s.value, OnChange: s.choose, Tabs: manyTabs()}) {
			<p>Panel { s.value }.</p>
		}
		<p class="text-sm text-muted-foreground">tab: { s.value }</p>
	</div>
}

templ toastDefault(s *kitState) {
	<div class="p-4">
		@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "show", surf.Click(func() {
			s.toasts.Show(ui.Toast{Title: "Event created", Description: "Sunday, at nine."})
		}))}) {
			Show a toast
		}
		@ui.Toaster(&s.toasts, ui.ToasterProps{})
	</div>
}

templ toastAction(s *kitState) {
	<div class="p-4">
		@ui.Button(ui.ButtonProps{Attrs:surf.On(ctx,"show-action",surf.Click(func(){
			s.toasts.Show(ui.Toast{Title:"Event deleted",Duration:-1,Actions:[]ui.ToastAction{{Label:"Undo",OnSelect:func(){s.ran="undone"}}}})
		}))}) { Delete }
		<p>action: { s.ran }</p>
		@ui.Toaster(&s.toasts, ui.ToasterProps{})
	</div>
}

templ toastCategories(s *kitState) {
	<div class="flex flex-row gap-2 p-4">
		@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "success", surf.Click(func() {
			s.toasts.Show(ui.Toast{Title: "Saved", Category: "success"})
		}))}) {
			Success
		}
		@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "error", surf.Click(func() {
			s.toasts.Show(ui.Toast{Title: "Couldn't save", Category: "error"})
		}))}) {
			Error
		}
		@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "info", surf.Click(func() {
			s.toasts.Show(ui.Toast{Title: "A new version", Category: "info"})
		}))}) {
			Info
		}
		@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "warning", surf.Click(func() {
			s.toasts.Show(ui.Toast{Title: "Disk nearly full", Category: "warning"})
		}))}) {
			Warning
		}
		@ui.Toaster(&s.toasts, ui.ToasterProps{})
	</div>
}

// showOwnedToast shows toastOwned's toast from the start: focused, as the
// app's keys left it, so its bar stands still and its first button is
// ringed in a still render.
func showOwnedToast(s *kitState) {
	s.toasts.Show(ui.Toast{
		ID: "build", Title: "Build finished", Description: "hotty-surf, 2 warnings",
		Duration: -1, Focused: true, Countdown: time.Now().Add(8 * time.Second),
		Actions: []ui.ToastAction{
			{Label: "Open", OnSelect: func() { s.ran = "opened" }},
			{Label: "Later", Variant: ui.Outline, OnSelect: func() { s.ran = "later" }},
		},
		OnClick: func() { s.ran = "log" },
		OnClose: func() { s.ran = "closed"; s.toasts.Remove("build") },
	})
}

templ toastOwned(s *kitState) {
	<div class="p-4">
		<p>ran: { s.ran }</p>
		@ui.Toaster(&s.toasts, ui.ToasterProps{})
	</div>
}
