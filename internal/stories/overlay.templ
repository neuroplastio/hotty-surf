package stories

import (
	"strconv"
	"strings"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/ui"
	"neuroplast.io/hotty-surf/ui/button"
	"neuroplast.io/hotty-surf/ui/combobox"
	"neuroplast.io/hotty-surf/ui/tooltip"
)

// The stories of B3's overlays: Popover and Command. Their data is made
// up.

type overlayState struct {
	pop   ui.PopoverState
	sides [4]ui.PopoverState
	width string
	cmd   ui.CommandState
	ran   string
	open  bool
	box      combobox.State
	boxClear combobox.State
	boxMulti combobox.State
	value    string
	clearVal string
	values   []string
	drawer ui.DrawerState
	low, high float64
}

type bookPopoverProps struct {
	Trigger string
	Width string
	pop ui.PopoverState
}

type bookComboboxProps struct {
	Placeholder string
	Value string
	box    combobox.State
}

func fruitValue(v string) string {
	if v == "" { return "none" }
	return v
}

// commands are the stories' command list: a few loose, two groups.
func (s *overlayState) commands() []ui.MenuItem {
	run := func(v string) func() { return func() { s.ran = v } }
	return []ui.MenuItem{
		{Label: "New note", Icon: "plus", Keys: "mod+n", OnSelect: run("New note")},
		{Label: "Search notes", Icon: "search", Keywords: "find, lookup", OnSelect: run("Search notes")},
		{Label: "Archive", Icon: "folder", Disabled: true},
		{Label: "Profile", Icon: "user", Group: "Settings", Keys: "mod+p", OnSelect: run("Profile")},
		{Label: "Notifications", Icon: "bell", Group: "Settings", Keywords: "alerts", OnSelect: run("Notifications")},
		{Label: "Inbox", Icon: "inbox", Group: "Settings", OnSelect: run("Inbox")},
	}
}

func init() {
	show := func(f func(*overlayState) templ.Component) func() templ.Component {
		return func() templ.Component { return f(&overlayState{width: "100%"}) }
	}
	add(Story{ID: "popover/default", Doc: "A popover with a small form; Enter on its trigger opens it",
		View: show(popoverDefault), Props: func() (any, templ.Component) {
			p := &bookPopoverProps{Trigger: "Open popover", Width: "100%"}
			return p, bookPopover(p)
		}, Keys: []string{"tab", "enter"}, Want: "Dimensions"})
	add(Story{ID: "popover/sides", Doc: "A popover for each side, the top one open; Enter on the bottom one's trigger opens it and closes the top one (one popup is open at a time)",
		View: func() templ.Component {
			s := &overlayState{}
			s.sides[0].Open()
			return popoverSides(s)
		}, Keys: []string{"tab", "tab", "enter"}, Want: "Opens to the bottom"})
	add(Story{ID: "popover/with-command", Doc: "A popover holding a command menu",
		View: func() templ.Component {
			s := &overlayState{}
			s.pop.Open()
			return popoverCommand(s)
		}, Keys: []string{"tab", "tab", "arrow_down", "enter"}, Want: "ran: Search notes"})
	add(Story{ID: "command/default", Doc: "A command menu: the arrows move over what isn't disabled, Enter chooses",
		View: show(commandDefault), Keys: []string{"tab", "arrow_down", "arrow_down", "enter"}, Want: "ran: Profile."})
	add(Story{ID: "command/empty", Doc: "A command menu whose search matches nothing",
		View: func() templ.Component {
			s := &overlayState{}
			s.cmd.Search("zzz")
			return commandDefault(s)
		}, Keys: []string{"tab", "enter"}, Want: "ran: ."})
	add(Story{ID: "command/dialog", Doc: "A command palette its button opens; choosing an item closes it",
		View: show(commandDialog), Keys: []string{"tab", "enter", "end", "enter"}, Want: "ran: Inbox"})
	add(Story{ID: "combobox/default", Doc: "Searchable single (grouped), clearable, and multiple-chip comboboxes",
		View: func() templ.Component { return comboboxShowcase(&overlayState{clearVal: "a"}) },
		Keys: []string{"tab", "b", "a", "arrow_down", "enter"}, Want: "fruit: b"})
	for _, side := range []string{"bottom", "top", "left", "right"} {
		add(Story{ID: "drawer/"+side, Doc: "A modal drawer at the "+side,
			View: show(func(s *overlayState) templ.Component { return drawerStory(s, side) }),
			Keys: []string{"tab", "enter", "escape"}, Want: "drawer: off"})
	}
	add(Story{ID: "dialog/with-alert", Doc: "A modal confirmation with two actions",
		View: show(alertDialogStory), Keys: []string{"tab", "enter", "escape"}, Want: "alert: off"})
	add(Story{ID: "tooltip/default", Doc: "Tooltips on all four sides",
		View: func() templ.Component { return tooltipStory(true) }})
	add(Story{ID: "range/default", Doc: "A slider with a single thumb",
		View: func() templ.Component { return sliderStory(&overlayState{high:20}, false) }, Keys: []string{"tab", "arrow_right"}, Want: "value: 25"})
	add(Story{ID: "range/two-thumbs", Doc: "A range with independently adjustable ends",
		View: func() templ.Component { return sliderStory(&overlayState{low:20, high:70}, true) }, Keys: []string{"tab", "arrow_right", "tab", "arrow_left"}, Want: "range: 25–65"})
}

templ sliderStory(s *overlayState, ranged bool) {
	<div class="flex flex-col gap-3 p-4">
		if ranged {
			@ui.RangeSlider(ui.RangeSliderProps{ID:"price", StartAttrs:templ.Attributes{"aria-label":"Price, start"}, EndAttrs:templ.Attributes{"aria-label":"Price, end"}, Min:0, Max:100, Step:5, Start:s.low, End:s.high, OnChange:func(a,b float64){s.low,s.high=a,b}})
			<p>range: { strconv.FormatFloat(s.low,'f',-1,64) }–{ strconv.FormatFloat(s.high,'f',-1,64) }</p>
		} else {
			@ui.Slider(ui.SliderProps{ID:"volume", Attrs:templ.Attributes{"aria-label":"Volume"}, Min:0, Max:100, Step:5, Value:s.high, OnChange:func(v float64){s.high=v}})
			<p>value: { strconv.FormatFloat(s.high,'f',-1,64) }</p>
		}
	</div>
}

templ tooltipStory(sides bool) {
	<div class="flex gap-3 p-4">
		@tooltip.View(tooltip.Props{Text: "Add to library"}) {
			@button.View(button.Props{}) { Add }
		}
		if sides {
			@tooltip.View(tooltip.Props{Text: "Below", Side: tooltip.Bottom, Arrow: true}) {
				@button.View(button.Props{}) { Bottom }
			}
			@tooltip.View(tooltip.Props{Text: "Left", Side: tooltip.Left}) {
				@button.View(button.Props{}) { Left }
			}
			@tooltip.View(tooltip.Props{Text: "Right", Side: tooltip.Right}) {
				@button.View(button.Props{}) { Right }
			}
		}
	</div>
}

templ alertDialogStory(s *overlayState) {
	<div class="flex flex-col gap-3 p-4">
		@ui.Button(ui.ButtonProps{Attrs: surf.On(ctx, "open-alert", surf.Click(func() { s.open = true }))}) { Delete }
		@ui.AlertDialog(ui.AlertDialogProps{ID: "alert", Open: s.open, Title: "Delete item?", Description: "This cannot be undone.", OnClose: func() { s.open = false }}) {
			<footer>
				@ui.Button(ui.ButtonProps{Attrs: surf.On(ctx, "cancel-alert", surf.Click(func() { s.open = false }))}) { Cancel }
				@ui.Button(ui.ButtonProps{Attrs: surf.On(ctx, "confirm-alert", surf.Click(func() { s.open = false }))}) { Delete }
			</footer>
		}
		<p>alert: { onoff(s.open) }</p>
	</div>
}

templ drawerStory(s *overlayState, side string) {
	<div class="p-4">
		@ui.Button(ui.ButtonProps{Attrs: surf.On(ctx, "open-drawer", surf.Click(func() { s.open=true }))}) { Open drawer }
		@ui.Drawer(&s.drawer, ui.DrawerProps{ID:"drawer", Side:side, Open:s.open, OnClose:func(){s.open=false}}) {
			<header><h2>Drawer</h2><p>Content for this side.</p></header>
			<section><p>Choose an action.</p></section>
			<footer>
				@ui.Button(ui.ButtonProps{Attrs:surf.On(ctx,"close-drawer",surf.Click(func(){s.open=false}))}) { Done }
			</footer>
		}
		<p>drawer: { onoff(s.open) }</p>
	</div>
}

var comboboxFruitItems = []combobox.Item{
	{Value: "a", Label: "Apple"},
	{Value: "b", Label: "Banana"},
	{Value: "c", Label: "Cherry", Group: "More"},
	{Value: "d", Label: "Date", Group: "More", Disabled: true},
}

templ comboboxShowcase(s *overlayState) {
	<div class="p-4 flex flex-col gap-4">
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted-foreground">Default (grouped + disabled)</span>
			@combobox.View(&s.box, combobox.Props{ID: "fruit", Placeholder: "Choose fruit", Value: s.value, Items: comboboxFruitItems, OnChange: func(v string) { s.value = v }})
			<p class="text-sm text-muted-foreground">fruit: { fruitValue(s.value) }</p>
		</div>
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted-foreground">Clearable</span>
			@combobox.View(&s.boxClear, combobox.Props{ID: "fruit-clear", Placeholder: "Choose fruit", Clear: true, Value: s.clearVal, Items: comboboxFruitItems, OnChange: func(v string) { s.clearVal = v }})
			<p class="text-sm text-muted-foreground">clear: { fruitValue(s.clearVal) }</p>
		</div>
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted-foreground">Multiple (chips)</span>
			@combobox.View(&s.boxMulti, combobox.Props{ID: "fruit-multi", Placeholder: "Choose fruits", Multiple: true, Values: s.values, Items: comboboxFruitItems, OnValuesChange: func(v []string) { s.values = v }})
			<p class="text-sm text-muted-foreground">fruits: { strings.Join(s.values, ", ") }</p>
		</div>
	</div>
}

templ bookPopover(p *bookPopoverProps) {
	<div class="p-4">
		@ui.Popover(&p.pop, ui.PopoverProps{ID: "dimensions", Trigger: templ.Raw(templ.EscapeString(p.Trigger)), Class: "w-80"}) {
			<header><h4>Dimensions</h4><p>Set the dimensions for the layer.</p></header>
			@ui.Field(ui.FieldProps{Orientation: "horizontal"}) {
				@ui.Label(ui.LabelProps{For: "width"}) { Width }
				@ui.Input(ui.InputProps{Value: p.Width, Attrs: surf.On(ctx, "width", surf.Input(func(v string) { p.Width = v }))})
			}
		}
	</div>
}

templ popoverDefault(s *overlayState) {
	<div class="p-4">
		@ui.Popover(&s.pop, ui.PopoverProps{ID: "dimensions", Trigger: templ.Raw("Open popover"), Class: "w-80"}) {
			<header>
				<h4>Dimensions</h4>
				<p>Set the dimensions for the layer.</p>
			</header>
			@ui.Field(ui.FieldProps{Orientation: "horizontal"}) {
				@ui.Label(ui.LabelProps{For: "width"}) {
					Width
				}
				@ui.Input(ui.InputProps{Value: s.width, Attrs: surf.On(ctx, "width", surf.Input(func(v string) { s.width = v }))})
			}
		}
	</div>
}

templ popoverSides(s *overlayState) {
	<div class="p-4 grid gap-4" style="padding: 6rem 10rem;">
		for i, side := range []string{"top", "bottom", "left", "right"} {
			@ui.Popover(&s.sides[i], ui.PopoverProps{ID: "side-" + side, Side: side, Trigger: templ.Raw(side)}) {
				<p>Opens to the { side }.</p>
			}
		}
	</div>
}

templ popoverCommand(s *overlayState) {
	<div class="p-4 flex flex-col gap-3">
		@ui.Popover(&s.pop, ui.PopoverProps{ID: "go", Trigger: templ.Raw("Go to…"), Class: "w-80"}) {
			@ui.Command(&s.cmd, ui.CommandProps{ID: "go-command", Items: s.commands()})
		}
		<p class="text-sm text-muted-foreground" style="margin-top: 16rem;">ran: { s.ran }</p>
	</div>
}

templ commandDefault(s *overlayState) {
	<div class="p-4 flex flex-col gap-3">
		<div class="max-w-md" style="border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
			@ui.Command(&s.cmd, ui.CommandProps{Items: s.commands()})
		</div>
		<p class="text-sm text-muted-foreground">ran: { s.ran }.</p>
	</div>
}

templ commandDialog(s *overlayState) {
	<div class="p-4 flex flex-col gap-3">
		<div>
			@ui.Button(ui.ButtonProps{Variant: ui.Outline, Attrs: surf.On(ctx, "palette", surf.Click(func() { s.open = true }))}) {
				Open the palette
			}
		</div>
		@ui.CommandDialog(&s.cmd, ui.CommandDialogProps{Open: s.open, Items: s.commands(), OnClose: func() { s.open = false; s.cmd.Search("") }})
		<p class="text-sm text-muted-foreground">ran: { s.ran }</p>
	</div>
}
