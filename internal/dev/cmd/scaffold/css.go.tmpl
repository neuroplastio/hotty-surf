package main

import (
	_ "embed"

	"github.com/a-h/templ"
	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/surfui"
)

//go:embed style/app.css
var appCSS string

// CSS is the app's own stylesheet (style/app.css), which hotty-surf run
// swaps in as the file is saved. The kit's is linked, not carried
// (newSurface): sent once rather than in every document.
var CSS = appCSS

// newSurface is one of the app's surfaces: view, styled by the kit's sheet,
// linked rather than carried (surfui.Sheet), then by CSS.
func newSurface(name string, view templ.Component) *surf.Surface {
	s := surf.New(name, view, CSS)
	s.Link(surfui.Sheet())
	return s
}
