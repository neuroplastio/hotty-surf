package spikeui

import "neuroplast.io/hotty-surf"

// ListItemProps is a list item's state and slots: what it is called (ID, which names
// its button for the host and for focus), whether it is the selected row or
// the active one, what a click does, and what goes before and after its
// text. The text itself is the component's children (ItemTitle,
// ItemSubtitle, ItemDetail).
type ListItemProps struct {
	ID       string
	Selected bool
	Active   bool
	OnClick  func()
	// Keys hears the keys while the item has the keyboard (the list's
	// arrows, which the app moves the cursor and the keyboard with).
	Keys     func(string) bool
	Leading  templ.Component
	Trailing templ.Component
}

// ListItem is a row of a list: a button with a leading slot, the text, and
// a trailing slot. The selected row is lighter and has an accent bar that
// grows from its middle; the active one is tinted, and so is a hovered one.
// Put it in a List.
templ ListItem(p ListItemProps) {
	<button
		type="button"
		role="option"
		aria-selected={ boolStr(p.Selected) }
		class={ itemClass(p) }
		{ surf.On(ctx, p.ID, surf.Click(p.OnClick), surf.Key(p.Keys))... }
	>
		<span aria-hidden="true" class={ barClass(p.Selected) }></span>
		if p.Leading != nil {
			@p.Leading
		}
		<span class="flex min-w-0 flex-1 flex-col">
			{ children... }
		</span>
		if p.Trailing != nil {
			<span class="ml-1.5 self-center">
				@p.Trailing
			</span>
		}
	</button>
}

// List is a listbox of ListItems.
templ List(label string) {
	<div role="listbox" aria-label={ label } class="flex flex-col gap-0.5 px-1.5">
		{ children... }
	</div>
}

// ItemTitle, ItemSubtitle and ItemDetail are a list item's lines: bold, muted
// and plain. A long line is cut with an ellipsis.
templ ItemTitle() {
	<span class="truncate text-base leading-4 font-bold text-sidebar-foreground">{ children... }</span>
}

templ ItemSubtitle() {
	<span class="truncate text-xs leading-5">{ children... }</span>
}

templ ItemDetail() {
	<span class="truncate text-xs leading-5 text-sidebar-foreground">{ children... }</span>
}
