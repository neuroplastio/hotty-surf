package spikeui

// BusyBadge is the mark of work in progress: an arc turning on a dark disc,
// sized and placed by class (it is absolutely positioned, so put it in a
// relative box).
templ BusyBadge(class string) {
	<span aria-hidden="true" class={ join("block", class) }>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" class="absolute inset-0 size-full fill-badge">
			<circle cx="7" cy="7" r="7"></circle>
		</svg>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" class="absolute inset-0 size-full animate-spin">
			<path d="M10.5 4.2A4.4 4.4 0 1 0 11.4 7" fill="none" class="stroke-busy" stroke-width="1.4" stroke-linecap="round"></path>
		</svg>
	</span>
}
