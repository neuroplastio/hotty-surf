package spikeui

// LayoutThumb draws a tree of splits as a small box: each split divides its
// box along its direction, in the shares its kids ask for, and each pane
// holds a terminal glyph, tinted and badged while an agent works in it. What
// a split's kids don't fit is cut off by the box.
templ LayoutThumb(l *PaneLayout) {
	<div role="img" aria-label={ describe(l) } class="size-9.5 shrink-0 overflow-hidden rounded-sm border border-sidebar-border">
		@split(l)
	</div>
}

templ split(l *PaneLayout) {
	if len(l.Kids) == 0 {
		<div class={ join("flex size-full items-center justify-center", when(l.Busy, "bg-busy-tint")) }>
			<span class="relative flex">
				@Symbol(ShapeTerminal, "size-2.5")
				if l.Busy {
					@BusyBadge("absolute -right-0.5 -bottom-0.5 size-2")
				}
			</span>
		</div>
	} else {
		<div class={ join("flex size-full", when(l.Dir == SplitCol, "flex-col")) }>
			for i, k := range l.Kids {
				<div class={ kidClass(l.Dir, i, k) } style={ kidStyle(k) }>
					@split(k)
				</div>
			}
		</div>
	}
}
