<!-- The gallery: its toolbar across the top; the stories at the left,
     under a filter; the picked story drawn live in the middle (or in
     each of its states: States), with the calls its handlers make under
     it; its controls at the right. The canvas is drawn at its width
     whatever the window's; the frame gives way round it (frame.go): the
     toolbar takes as many rows as its groups need, and the side columns
     narrow, then are left out, which the line under the toolbar says.
     The bar's labels are frame.go's barGroups': change them together.
     The stories, the canvas and the controls each scroll by the wheel.
     The stories are a sidebar as an app draws one: a surface of its
     own, Compact, with a search field over a tree (a nav list whose
     groups fold). The tree is its own scroll box, so Tab gives the
     keyboard to it, and the arrows its bindings hear move the story.
     A switch that can do nothing for the story is not drawn, nor the
     controls' column where the story has none. The rest of the page is
     dense whatever the canvas is, until the toolbar is redrawn. -->
<surface density="dense">
  <stack grow key="page">
    <stack key="bar">
      <row :each="(i, r) in bar()" :key="'r' + string(i)" gap="2" pad="1 0">
        <heading :if="r.name" key="name">Gallery</heading>
        <spacer key="sp"/>
        <row :if="r.canvas" gap="1" key="canvas">
          <text muted>Theme</text>
          <select :value="theme" :options="themes()" @change="setTheme($value)" label="Theme" key="theme"/>
          <text muted indent="1">Density</text>
          <select :value="density" :options="densities()" @change="setDensity($value)" label="Density" key="density"/>
          <text muted indent="1">Width</text>
          <cycle :value="string(width)" :options="widths()" @change="setWidth($value)" label="Width" key="width"/>
        </row>
        <row :if="r.views" gap="1" key="views">
          <text :if="hasCells()" muted key="lcells">Cells</text>
          <switch :if="hasCells()" :on="cells" @click="flipCells" label="Cells" key="cells"/>
          <text :if="hasStates()" muted indent="1" key="lstates">States</text>
          <switch :if="hasStates()" :on="states" @click="flipStates" label="States" key="states"/>
          <text :if="hasReference()" muted indent="1" key="lreference">Reference</text>
          <switch :if="hasReference()" :on="reference" @click="flipReference" label="Reference" key="reference"/>
        </row>
        <row :if="r.panes" gap="1" key="panes">
          <text muted>Stories</text>
          <switch :on="showStories()" :disabled="!canShowStories()" @click="flipStories" label="Stories" key="stories"/>
          <text :if="hasControls()" muted indent="1" key="lcontrols">Controls</text>
          <switch :if="hasControls()" :on="showControls()" :disabled="!canShowControls()" @click="flipControls" label="Controls" key="controls"/>
        </row>
      </row>
      <row :if="fit() != ''" top gap="1" pad="1 0" key="fit">
        <chip fill="warn" key="tag">Window too narrow</chip>
        <text tone="warn" wrap grow key="why">{{ fit() }}</text>
      </row>
    </stack>
    <row top gap="1" pad="1 0" grow key="main">
      <stack :if="showStories()" :width="sideWidth()" key="side">
        <surface density="compact" grow key="nav">
          <row search gap="2" key="search">
            <icon name="magnify"/>
            <field bare grow placeholder="Filter the stories" aria-label="Filter the stories" :value="filter" autofocus @input="setFilter($value)" key="filter"/>
          </row>
          <list :if="size(shown()) > 0" nav scroll keys="none" label="Stories" key="list">
            <bind key="arrow_up" label="Previous story" do="move(-1)"/>
            <bind key="arrow_down" label="Next story" do="move(1)"/>
            <story-entry :each="e in shown()" :key="e.id" :e="e"/>
          </list>
          <text :else muted wrap key="none">No story has "{{ filter }}" in its name.</text>
        </surface>
      </stack>
      <stack grow key="mid">
        <heading key="title">{{ title() }}</heading>
        <text :if="about() != ''" muted wrap key="about">{{ about() }}</text>
        <embed :of="canvas()" :key="'c-' + sel"/>
        <row gap="2" key="loghead">
          <text bold grow>Actions</text>
          <text small muted>{{ size(log) }} calls</text>
          <button bare @click="clearLog" key="clear">Clear</button>
        </row>
        <stack height="8" key="log">
          <text :each="(i, l) in tail()" :key="'l' + string(i)" small>{{ l }}</text>
          <text :if="size(log) == 0" small muted wrap key="quiet">{{ quiet() }}</text>
        </stack>
      </stack>
      <stack :if="showControls()" :width="asideWidth()" key="aside">
        <text bold key="head">Controls</text>
        <stack scroll :key="'p-' + sel">
          <control-row :each="(i, c) in controls" :key="c.key" :c="c" :i="i"/>
          <text :if="size(controls) == 0" small muted wrap key="none">{{ uncontrolled() }}</text>
        </stack>
      </stack>
    </row>
  </stack>
</surface>
