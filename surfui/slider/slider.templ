// Package slider is hotty-surf's self-contained Slider and RangeSlider component.
package slider

import (
	"context"
	_ "embed"
	"fmt"
	"math"
	"slices"
	"strconv"
	"strings"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/internal/core/rt"
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/util"
)

//go:embed slider.css
var css string

// Register registers slider's CSS with r.
func Register(r *surfui.Registry) { r.CSS("slider", css) }

// Props configures a single-thumb Slider.
type Props struct {
	ID             string
	Attrs          templ.Attributes
	Min, Max, Step float64
	Value          float64
	Disabled       bool
	OnChange       func(float64)
	Class          string
}

// RangeProps configures a two-thumb Range slider.
type RangeProps struct {
	ID                   string
	StartAttrs, EndAttrs templ.Attributes
	Min, Max, Step       float64
	Start, End           float64
	Disabled             bool
	OnChange             func(start, end float64)
	Class                string
}

// View renders a single-thumb slider.
func View(p Props) templ.Component {
	return sliderMarkup(view{p: p, lo: p.Min, hi: p.Value})
}

// Range renders a two-thumb range slider.
func Range(p RangeProps) templ.Component {
	return sliderMarkup(view{
		p:           Props{ID: p.ID, Attrs: p.EndAttrs, Min: p.Min, Max: p.Max, Step: p.Step, Disabled: p.Disabled, Class: p.Class},
		startAttrs:  p.StartAttrs,
		lo:          p.Start,
		hi:          p.End,
		changeRange: p.OnChange,
		ranged:      true,
	})
}

type memo struct {
	knob    int
	focus   string
	dragged bool
}

type view struct {
	p           Props
	lo, hi      float64
	ranged      bool
	changeRange func(float64, float64)
	startAttrs  templ.Attributes
	memo        *memo
}

func (v *view) init(ctx context.Context) {
	badBounds := v.p.Max <= v.p.Min || math.IsNaN(v.p.Max) || math.IsNaN(v.p.Min) || math.IsInf(v.p.Max, 0) || math.IsInf(v.p.Min, 0)
	if v.p.ID == "" || badBounds || v.p.Step < 0 || math.IsNaN(v.p.Step) || math.IsInf(v.p.Step, 0) {
		rt.Fault(ctx, "slider.View: ID is required, Max must exceed Min, and Step cannot be negative")
	}
	if badBounds {
		v.p.Min, v.p.Max = 0, 100
	}
	if v.p.Step < 0 || math.IsNaN(v.p.Step) || math.IsInf(v.p.Step, 0) {
		v.p.Step = 0
	}
	finite := func(x float64) bool { return !math.IsNaN(x) && !math.IsInf(x, 0) }
	if !v.ranged {
		v.lo = v.p.Min
	}
	if !finite(v.lo) || !finite(v.hi) || v.lo < v.p.Min || v.lo > v.p.Max || v.hi < v.p.Min || v.hi > v.p.Max || v.lo > v.hi {
		rt.Fault(ctx, "slider.View: values must be finite, in bounds and in order")
	}
	if !finite(v.lo) {
		v.lo = v.p.Min
	}
	if !finite(v.hi) {
		if v.ranged {
			v.hi = v.p.Max
		} else {
			v.hi = v.p.Min
		}
	}
	v.lo = math.Max(v.p.Min, math.Min(v.p.Max, v.lo))
	v.hi = math.Max(v.lo, math.Min(v.p.Max, v.hi))
	if f := rt.From(ctx); f != nil {
		k := "surfui.slider:" + v.p.ID
		v.memo, _ = f.Memo()[k].(*memo)
		if v.memo == nil {
			v.memo = &memo{}
			f.Memo()[k] = v.memo
		}
		if v.memo.focus != "" {
			surf.Autofocus(ctx, v.memo.focus)
			v.memo.focus = ""
		}
	}
}

func (v *view) step() float64 {
	if v.p.Step > 0 {
		return v.p.Step
	}
	return (v.p.Max - v.p.Min) / 20
}

func (v *view) snap(x float64) float64 {
	q := v.p.Step
	if q <= 0 {
		q = (v.p.Max - v.p.Min) / 100
	}
	if q <= 0 || math.IsInf(q, 0) {
		return x
	}
	x = math.Max(v.p.Min, math.Min(v.p.Max, x))
	x = v.p.Min + math.Round((x-v.p.Min)/q)*q
	decimals := func(n float64) int {
		s := strconv.FormatFloat(math.Abs(n), 'f', -1, 64)
		if i := strings.IndexByte(s, '.'); i >= 0 {
			return len(s) - i - 1
		}
		return 0
	}
	p := math.Pow(10, float64(min(max(decimals(q), decimals(v.p.Min)), 12)))
	return math.Max(v.p.Min, math.Min(v.p.Max, math.Round(x*p)/p))
}

func (v *view) count() int {
	return int(math.Min(math.Max(math.Round((v.p.Max-v.p.Min)/v.step()), 1), 40))
}

func (v *view) at(i int) float64 {
	return v.p.Min + float64(min(max(i, 0), v.count()))/float64(v.count())*(v.p.Max-v.p.Min)
}

func (v *view) set(knob int, x float64) {
	if v.p.Disabled {
		return
	}
	x = v.snap(x)
	if !v.ranged {
		if v.p.OnChange != nil && x != v.hi {
			v.p.OnChange(x)
		}
		return
	}
	lo, hi := v.lo, v.hi
	if knob == 0 {
		lo = math.Min(x, hi)
	} else {
		hi = math.Max(x, lo)
	}
	if v.changeRange != nil && (lo != v.lo || hi != v.hi) {
		v.changeRange(lo, hi)
	}
}

func (v *view) key(knob int, k string) bool {
	if v.p.Disabled {
		return false
	}
	x := v.hi
	if v.ranged && knob == 0 {
		x = v.lo
	}
	switch k {
	case "arrow_left", "arrow_down":
		x -= v.step()
	case "arrow_right", "arrow_up":
		x += v.step()
	case "page_down":
		x -= 10 * v.step()
	case "page_up":
		x += 10 * v.step()
	case "home":
		x = v.p.Min
	case "end":
		x = v.p.Max
	default:
		return false
	}
	v.set(knob, x)
	return true
}

func (v *view) choose(x float64) int {
	if !v.ranged {
		return 1
	}
	a, b := math.Abs(x-v.lo), math.Abs(x-v.hi)
	if a < b || (a == b && (v.lo < v.hi || x < v.lo)) {
		return 0
	}
	if a == b && x == v.lo {
		return -1
	}
	return 1
}

func (v *view) press(x float64) {
	k := v.choose(x)
	if k < 0 {
		k = 1
		if v.hi >= v.p.Max {
			k = 0
		}
	}
	if v.memo != nil {
		v.memo.knob = v.choose(x)
		v.memo.focus = v.thumbID(k)
	}
	if v.choose(x) >= 0 {
		v.set(k, x)
	}
}

func (v *view) drag(d surf.DragEvent) {
	if v.memo == nil || v.p.Disabled || !d.HasX {
		return
	}
	x := v.at(d.X)
	if d.Start {
		v.memo.dragged = false
		v.press(x)
		return
	}
	k := v.memo.knob
	if k < 0 {
		if x < v.lo {
			k = 0
		} else if x > v.hi {
			k = 1
		} else {
			return
		}
		v.memo.knob = k
		v.memo.focus = v.thumbID(k)
	}
	v.set(k, x)
	if d.End {
		v.memo.dragged = d.Over == v.p.ID || strings.HasPrefix(d.Over, v.p.ID+"-notch-") || d.Over == v.thumbID(0) || d.Over == v.thumbID(1)
	}
}

func (v *view) thumbID(k int) string {
	if !v.ranged {
		return v.p.ID + "-thumb"
	}
	if k == 0 {
		return v.p.ID + "-start"
	}
	return v.p.ID + "-end"
}

func (v *view) track(ctx context.Context) templ.Attributes {
	if v.p.Disabled {
		return surf.On(ctx, v.p.ID)
	}
	a := surf.On(ctx, v.p.ID, surf.Drag(v.drag))
	a["data-steps"] = strconv.Itoa(v.count())
	return a
}

func (v *view) notch(ctx context.Context, i int) templ.Attributes {
	if v.p.Disabled {
		return nil
	}
	return surf.On(ctx, fmt.Sprintf("%s-notch-%d", v.p.ID, i), surf.Click(func() {
		if v.memo != nil && v.memo.dragged {
			v.memo.dragged = false
			return
		}
		v.press(v.at(i))
	}))
}

var sliderKeys = []string{"arrow_left", "arrow_right", "arrow_up", "arrow_down", "page_up", "page_down", "home", "end"}

func (v *view) thumb(ctx context.Context, k int) templ.Attributes {
	attrs := v.p.Attrs
	if v.ranged && k == 0 {
		attrs = v.startAttrs
	}
	owned := []string{"id", "class", "type", "role", "aria-valuemin", "aria-valuemax", "aria-valuenow", "disabled", "style", "data-on"}
	var on templ.Attributes
	if v.p.Disabled {
		on = templ.Attributes{"id": v.thumbID(k)}
	} else {
		on = util.ScopeAttrs(ctx, util.KitOn(ctx, v.thumbID(k), surf.Key(func(s string) bool { return v.key(k, s) }, sliderKeys...)))
	}
	for key, value := range attrs {
		lower := strings.ToLower(key)
		if strings.HasPrefix(lower, "on") {
			rt.Fault(ctx, fmt.Sprintf("slider.View: thumb Attrs cannot install handler %q", key))
			continue
		}
		if strings.HasPrefix(lower, "data-hotty-") {
			rt.Fault(ctx, fmt.Sprintf("slider.View: thumb Attrs cannot replace internal attribute %q", key))
			continue
		}
		if !slices.Contains(owned, lower) {
			on[key] = value
		}
	}
	return on
}

func (v *view) percent(x float64) float64 {
	if v.p.Max <= v.p.Min {
		return 0
	}
	return math.Max(0, math.Min(100, 100*(x-v.p.Min)/(v.p.Max-v.p.Min)))
}

func sliderNum(x float64) string { return strconv.FormatFloat(x, 'f', -1, 64) }

func sliderStyle(left, width float64) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("left:%.3f%%;width:%.3f%%", left, width))
}

func sliderLeft(left float64) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("left:%.3f%%", left))
}

templ sliderMarkup(v view) {
	{{ v.init(ctx) }}
	<div
		data-hotty-slider=""
		if surfui.ModeOf(ctx) != surfui.ModeHotty {
			data-mode="tui"
		}
		if v.p.Class != "" {
			class={ v.p.Class }
		}
		{ v.track(ctx)... }
	>
		<span data-hotty-slider-rail></span>
		<span data-hotty-slider-fill style={ sliderStyle(v.percent(v.lo), v.percent(v.hi)-v.percent(v.lo)) }></span>
		for i := 0; i <= v.count(); i++ {
			{{ lo := max(0.0, (float64(i)-0.5)/float64(v.count())) * 100 }}
			{{ hi := min(1.0, (float64(i)+0.5)/float64(v.count())) * 100 }}
			<span data-hotty-slider-notch style={ sliderStyle(lo, hi-lo) } { v.notch(ctx, i)... }></span>
		}
		if v.ranged {
			@sliderThumb(&v, 0, v.lo, v.p.Min, v.hi)
		}
		@sliderThumb(&v, 1, v.hi, v.lo, v.p.Max)
	</div>
}

templ sliderThumb(v *view, k int, value, low, high float64) {
	<button
		type="button"
		data-hotty-slider-thumb
		role="slider"
		aria-valuemin={ sliderNum(low) }
		aria-valuemax={ sliderNum(high) }
		aria-valuenow={ sliderNum(value) }
		if v.p.Disabled {
			disabled
		}
		style={ sliderLeft(v.percent(value)) }
		{ v.thumb(ctx, k)... }
	></button>
}
