// Package story provides the storybook showcase for ui/empty.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui/icon"
	"neuroplast.io/hotty-surf/surfui/button"
	"neuroplast.io/hotty-surf/surfui/empty"
)

// Register adds empty's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "empty/default",
		Doc:          "Empty states with action button and with icon",
		Consolidated: true,
		View:         func() templ.Component { return showcase() },
	})
}

templ showcase() {
	<div class="p-4 flex flex-col gap-4 max-w-md">
		@empty.View(empty.Props{}) {
			<header>
				<h3>No projects yet</h3>
				<p>Make your first project to start.</p>
			</header>
			<section>
				@button.View(button.Props{ID: "create"}) {
					Create project
				}
			</section>
		}
		@empty.View(empty.Props{}) {
			<header>
				<figure>
					@icon.View("inbox", "")
				</figure>
				<h3>No messages</h3>
				<p>Messages you get show here.</p>
			</header>
		}
	</div>
}
