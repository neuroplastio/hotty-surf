// Package story provides the storybook showcase for ui/iconbutton.
package story

import (
	"context"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui/symbol"
	"neuroplast.io/hotty-surf/surfui/iconbutton"
)

// Props is the editable state for the IconButton storybook controls.
type Props struct {
	Accent string `enum:"Hosts,Screens,Layout,More,Collapse"`
}

var buttons = []struct {
	label string
	shape symbol.Shape
}{
	{"Hosts", symbol.ShapePublic},
	{"Screens", symbol.ShapeDesktopWindows},
	{"Layout", symbol.ShapeGridView},
	{"More", symbol.ShapeMoreHoriz},
	{"Collapse", symbol.ShapeRemove},
}

func attrs(ctx context.Context, p *Props, label string) templ.Attributes {
	a := surf.On(ctx, "ib-"+label, surf.Click(func() { p.Accent = label }))
	a["aria-label"], a["title"] = label, label
	return a
}

func accentClass(p *Props, label string) string {
	if p.Accent == label {
		return "text-sidebar-primary"
	}
	return ""
}

// Register adds iconbutton's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "icon-button/default",
		Doc:          "Shell icon buttons",
		Consolidated: true,
		BookOnly:     true,
		View:         func() templ.Component { return showcase(&Props{Accent: "Hosts"}) },
		Props: func() (any, templ.Component) {
			p := &Props{Accent: "Hosts"}
			return p, showcase(p)
		},
	})
}

templ showcase(p *Props) {
	<div class="p-4">
		<div class="bg-sidebar text-sidebar-foreground flex h-7 w-fit items-stretch rounded-md px-1">
			for _, b := range buttons {
				@iconbutton.View(iconbutton.Props{Shape: b.shape, Class: accentClass(p, b.label), Attrs: attrs(ctx, p, b.label)})
			}
		</div>
	</div>
}
