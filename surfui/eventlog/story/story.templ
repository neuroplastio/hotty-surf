// Package story provides the storybook showcase for ui/eventlog.
package story

import (
	"time"

	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/button"
	"neuroplast.io/hotty-surf/surfui/eventlog"
)

type state struct {
	entries []eventlog.Entry
}

func defaultEntries() []eventlog.Entry {
	return []eventlog.Entry{
		{At: time.Now().Add(-2 * time.Second), Kind: "click", Text: "save"},
		{At: time.Now(), Kind: "state", Text: "Clicks = 1"},
	}
}

// Register adds eventlog's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "event-log/default",
		Doc:          "Chronological event log with clear action",
		Consolidated: true,
		BookOnly:     true,
		View:         func() templ.Component { return showcase(&state{entries: defaultEntries()}) },
	})
}

templ showcase(s *state) {
	<div class="p-4 flex flex-col gap-3 max-w-md">
		<div>
			@button.View(button.Props{ID: "demo-add", Variant: surfui.Outline, Size: surfui.Small, OnClick: func() {
				s.entries = append(s.entries, eventlog.Entry{At: time.Now(), Kind: "click", Text: "add"})
			}}) {
				Add event
			}
		</div>
		@eventlog.View(eventlog.Props{
			ID:      "demo",
			Entries: s.entries,
			OnClear: func() { s.entries = nil },
			Empty:   "Nothing yet: add an event.",
		})
	</div>
}
