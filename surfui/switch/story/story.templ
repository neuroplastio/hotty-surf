// Package story provides the storybook showcase for ui/switch.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/label"
	uiswitch "neuroplast.io/hotty-surf/surfui/switch"
)

type state struct {
	airplane bool
	notify   bool
}

func onoff(b bool) string {
	if b {
		return "on"
	}
	return "off"
}

// Register adds switch's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "switch/default",
		Doc:          "Default, small, and disabled switches with labels",
		Consolidated: true,
		View:         func() templ.Component { return showcase(&state{notify: true}) },
		Keys:         []string{"tab", "space"},
		Want:         "airplane mode: on",
	})
}

templ showcase(s *state) {
	<div class="flex flex-col gap-4 p-4">
		<div class="flex flex-col gap-2">
			@label.View(label.Props{}) {
				@uiswitch.View(uiswitch.Props{ID: "airplane", Checked: s.airplane, OnChange: func(b bool) { s.airplane = b }})
				Airplane mode
			}
			<p class="text-sm text-muted-foreground">airplane mode: { onoff(s.airplane) }</p>
		</div>
		<div class="flex flex-col gap-2">
			@label.View(label.Props{}) {
				@uiswitch.View(uiswitch.Props{ID: "notify", Size: surfui.Small, Checked: s.notify, OnChange: func(b bool) { s.notify = b }})
				Notifications (small)
			}
			<p class="text-sm text-muted-foreground">notifications: { onoff(s.notify) }</p>
		</div>
		@label.View(label.Props{}) {
			@uiswitch.View(uiswitch.Props{ID: "disabled-sw", Disabled: true})
			Disabled switch
		}
	</div>
}
