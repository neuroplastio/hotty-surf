// Package story provides the storybook showcase for ui/icon.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui/icon"
)

// Props is the editable icon gallery state.
type Props struct{ Class string }

var bookIconNames = []string{
	"arrow-down", "arrow-right", "arrow-up", "bell", "check", "chevron-down", "chevron-left", "chevron-right", "chevrons-left", "chevrons-right", "chevrons-up-down", "circle", "circle-alert", "circle-check-big", "circle-help", "circle-off", "circle-plus", "ellipsis", "eye-off", "folder", "hand", "inbox", "plus", "search", "settings-2", "timer", "user", "x",
}

// Register adds icon's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "icons/default",
		Doc:          "Lucide icons, as the kit ships them",
		Consolidated: true,
		BookOnly:     true,
		View:         func() templ.Component { return showcase(&Props{Class: "size-5"}) },
		Props: func() (any, templ.Component) {
			p := &Props{Class: "size-5"}
			return p, showcase(p)
		},
	})
}

templ showcase(p *Props) {
	<div class="book-icon-grid">
		for _, name := range bookIconNames {
			<div class="flex flex-col items-center gap-1 rounded-md border p-2">
				@icon.View(name, p.Class)
				<span class="text-muted-foreground text-xs">{ name }</span>
			</div>
		}
	</div>
}
