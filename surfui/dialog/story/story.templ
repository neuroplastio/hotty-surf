// Package story provides the storybook showcase for ui/dialog.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/button"
	"neuroplast.io/hotty-surf/surfui/dialog"
	"neuroplast.io/hotty-surf/surfui/input"
)

type state struct {
	open        bool
	openNoClose bool
	name        string
}

func onoff(b bool) string {
	if b {
		return "on"
	}
	return "off"
}

// Register adds dialog's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "dialog/default",
		Doc:          "Modal dialogs with form fields, footer actions, and optional close button",
		Consolidated: true,
		View:         func() templ.Component { return showcase(&state{}) },
		Keys:         []string{"tab", "enter", "escape"},
		Want:         "open: off",
	})
}

templ showcase(s *state) {
	<div class="flex flex-col gap-3 p-4">
		<div class="flex flex-wrap gap-2">
			@button.View(button.Props{ID: "open", Variant: surfui.Outline, OnClick: func() { s.open = true }}) {
				Edit profile
			}
			@button.View(button.Props{ID: "open-noclose", Variant: surfui.Outline, OnClick: func() { s.openNoClose = true }}) {
				Without close button
			}
		</div>
		@dialog.View(dialog.Props{ID: "profile", Open: s.open, Title: "Edit profile", Description: "Make changes to your profile here.", OnClose: func() { s.open = false }}) {
			<section>
				@input.View(input.Props{ID: "name", Value: s.name, Placeholder: "Ada Lovelace", OnInput: func(v string) { s.name = v }})
			</section>
			<footer>
				@button.View(button.Props{ID: "cancel", Variant: surfui.Outline, OnClick: func() { s.open = false }}) { Cancel }
				@button.View(button.Props{ID: "save", OnClick: func() { s.open = false }}) { Save changes }
			</footer>
		}
		@dialog.View(dialog.Props{ID: "profile-noclose", Open: s.openNoClose, Title: "Confirm", HideCloseButton: true, OnClose: func() { s.openNoClose = false }}) {
			<section><p>Press Escape or click Done to close.</p></section>
			<footer>
				@button.View(button.Props{ID: "done", OnClick: func() { s.openNoClose = false }}) { Done }
			</footer>
		}
		<p class="text-sm text-muted-foreground">open: { onoff(s.open) }</p>
	</div>
}
