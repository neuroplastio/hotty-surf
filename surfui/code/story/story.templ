// Package story provides the storybook showcase for ui/code.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui/code"
)

// Props is the editable state for the Code storybook controls.
type Props struct {
	Lang  string `enum:"go,templ,html,css,javascript,text"`
	First int
	Src   string `sb:"-"`
}

const goSample = `// Next is the item after current, or the last one.
func (l *NavList) Next(items []NavItem, current int) string {
	if len(items) == 0 {
		return ""
	}
	return items[min(len(items)-1, current+1)].ID // stops at the end
}`

// Register adds code's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "code/default",
		Doc:          "Syntax-highlighted code block with line numbers and wrapping",
		Consolidated: true,
		BookOnly:     true,
		View:         func() templ.Component { return showcase(&Props{Lang: "go", First: 1, Src: goSample}) },
		Props: func() (any, templ.Component) {
			p := &Props{Lang: "go", First: 1, Src: goSample}
			return p, showcase(p)
		},
	})
}

templ showcase(p *Props) {
	<div class="w-full max-w-2xl p-4">
		@code.View(p.Src, p.Lang, p.First)
	</div>
}
