// Package separator is hotty-surf's self-contained Separator component, with
// explicit renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package separator

import (
	_ "embed"

	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/util"
)

//go:embed separator.css
var css string

// Register registers separator's assets with r.
func Register(r *surfui.Registry) { r.CSS("separator", css) }

// Orientation controls whether the separator runs horizontally or vertically.
type Orientation string

const (
	Horizontal Orientation = "horizontal"
	Vertical   Orientation = "vertical"
)

// Props configures a Separator component.
type Props struct {
	Orientation Orientation
	Decorative  bool
	Attrs       templ.Attributes
	Class       string
}

// View dispatches to Hotty or TUI according to surfui.ModeOf(ctx).
templ View(p Props) {
	switch surfui.ModeOf(ctx) {
	case surfui.ModeHotty:
		@Hotty(p)
	default:
		@TUI(p)
	}
}

// Hotty renders a horizontal or vertical hairline divider.
templ Hotty(p Props) {
	{{ ori := p.Orientation; if ori == "" { ori = Horizontal } }}
	<div
		data-slot="separator"
		if p.Decorative {
			role="none"
		} else {
			role="separator"
			aria-orientation={ string(ori) }
		}
		data-orientation={ string(ori) }
		class={ util.JoinClass("separator", p.Class) }
		{ p.Attrs... }
	></div>
}

// TUI renders a horizontal rule (<hr>) or vertical bar (│) for cells.Screen.
templ TUI(p Props) {
	if p.Orientation == Vertical {
		<span
			data-slot="separator"
			data-mode="tui"
			data-orientation="vertical"
			class={ util.JoinClass("text-muted-foreground", p.Class) }
			{ p.Attrs... }
		>│</span>
	} else {
		<hr
			data-slot="separator"
			data-mode="tui"
			role="separator"
			class={ util.JoinClass("border-border", p.Class) }
			{ p.Attrs... }
		/>
	}
}
