// Package story provides the storybook showcase for ui/avatar.
package story

import (
	"bytes"
	"encoding/base64"
	"image"
	"image/color"
	"image/png"
	"sync"

	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/avatar"
)

var (
	imgOnce sync.Once
	img1    string
	img2    string
)

func sampleImages() (string, string) {
	imgOnce.Do(func() {
		img1 = makeAvatarPNG(color.RGBA{244, 114, 182, 255}, color.RGBA{99, 102, 241, 255})
		img2 = makeAvatarPNG(color.RGBA{45, 212, 191, 255}, color.RGBA{59, 130, 246, 255})
	})
	return img1, img2
}

func makeAvatarPNG(c1, c2 color.RGBA) string {
	const sz = 48
	img := image.NewRGBA(image.Rect(0, 0, sz, sz))
	for y := range sz {
		for x := range sz {
			t := float64(x+y) / float64(2*(sz-1))
			r := uint8(float64(c1.R)*(1-t) + float64(c2.R)*t)
			g := uint8(float64(c1.G)*(1-t) + float64(c2.G)*t)
			b := uint8(float64(c1.B)*(1-t) + float64(c2.B)*t)
			dx, dy := float64(x)-24, float64(y)-18
			sdx, sdy := float64(x)-24, float64(y)-44
			if dx*dx+dy*dy <= 7.5*7.5 || (sdx*sdx/(16*16)+sdy*sdy/(14*14)) <= 1 {
				r = uint8(float64(r)*0.25 + 255*0.75)
				g = uint8(float64(g)*0.25 + 255*0.75)
				b = uint8(float64(b)*0.25 + 255*0.75)
			}
			img.SetRGBA(x, y, color.RGBA{r, g, b, 255})
		}
	}
	var buf bytes.Buffer
	_ = png.Encode(&buf, img)
	return "data:image/png;base64," + base64.StdEncoding.EncodeToString(buf.Bytes())
}

// Register adds avatar's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "avatar/default",
		Doc:          "Avatars in all sizes, with status badges, and as an overlapping group",
		Consolidated: true,
		Score:        4,
		View:         func() templ.Component { return showcase() },
	})
}

templ showcase() {
	{{ a1, a2 := sampleImages() }}
	<div class="p-4 flex flex-col gap-4">
		<div class="flex items-center gap-4">
			@avatar.View(avatar.Props{Size: surfui.Small, Src: a1, Alt: "Ada Lovelace", Hue: avatar.HueCoral}) {
				<span>AL</span>
			}
			@avatar.View(avatar.Props{Size: surfui.Medium, Src: a2, Alt: "Grace Hopper", Hue: avatar.HueTeal, Online: true}) {
				<span>GH</span>
			}
			@avatar.View(avatar.Props{Size: surfui.Large, Src: a1, Alt: "Margaret Hamilton", Hue: avatar.HueViolet}) {
				<span>MH</span>
			}
		</div>
		<div class="flex items-center gap-4">
			@avatar.View(avatar.Props{Size: surfui.Small, Hue: avatar.HueCoral}) {
				<span>AL</span>
			}
			@avatar.View(avatar.Props{Size: surfui.Medium, Hue: avatar.HueAmber, Online: true}) {
				<span>MK</span>
			}
			@avatar.View(avatar.Props{Size: surfui.Large, Hue: avatar.HueBlue, Online: true}) {
				<span>RT</span>
			}
		</div>
		<div>
			@avatar.Group(avatar.GroupProps{}) {
				@avatar.View(avatar.Props{Src: a1, Alt: "AL", Hue: avatar.HueCoral}) {
					<span>AL</span>
				}
				@avatar.View(avatar.Props{Src: a2, Alt: "GH", Hue: avatar.HueTeal}) {
					<span>GH</span>
				}
				@avatar.View(avatar.Props{Hue: avatar.HueGold}) {
					<span>MK</span>
				}
				<span data-count>+4</span>
			}
		</div>
	</div>
}
