// Package card is hotty-surf's self-contained Card component, with explicit
// renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package card

import (
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/util"
)

// Register registers card's assets with r.
func Register(r *surfui.Registry) {}

// Props configures a Card component.
type Props struct {
	Size  surfui.Size
	Attrs templ.Attributes
	Class string
}

// View dispatches to Hotty or TUI according to surfui.ModeOf(ctx).
templ View(p Props) {
	switch surfui.ModeOf(ctx) {
	case surfui.ModeHotty:
		@Hotty(p) {
			{ children... }
		}
	default:
		@TUI(p) {
			{ children... }
		}
	}
}

// Hotty renders Basecoat's card for a hotty host.
templ Hotty(p Props) {
	<div
		data-slot="card"
		class={ util.JoinClass("card", p.Class) }
		{ util.MergeAttrs(util.OptAttr("data-size", p.Size), p.Attrs)... }
	>
		{ children... }
	</div>
}

// TUI renders the card for cells.Screen.
templ TUI(p Props) {
	<div
		data-slot="card"
		data-mode="tui"
		class={ util.JoinClass("card", p.Class) }
		{ util.MergeAttrs(util.OptAttr("data-size", p.Size), p.Attrs)... }
	>
		{ children... }
	</div>
}
