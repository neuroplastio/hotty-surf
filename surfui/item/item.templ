// Package item is hotty-surf's self-contained Item & ItemGroup component, with
// explicit renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package item

import (
	_ "embed"
	"strings"

	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/util"
)

//go:embed item.css
var css string

// Register registers item's assets with r.
func Register(r *surfui.Registry) { r.CSS("item", css) }

// Props configures an Item component.
type Props struct {
	Variant surfui.Variant
	Muted   bool
	Size    surfui.Size
	Attrs   templ.Attributes
	Class   string
}

// GroupProps configures an ItemGroup container.
type GroupProps struct {
	Attrs templ.Attributes
	Class string
}

// View dispatches to Hotty or TUI according to surfui.ModeOf(ctx).
templ View(p Props) {
	switch surfui.ModeOf(ctx) {
	case surfui.ModeHotty:
		@Hotty(p) {
			{ children... }
		}
	default:
		@TUI(p) {
			{ children... }
		}
	}
}

// Hotty renders Basecoat's item for a hotty host.
templ Hotty(p Props) {
	@renderItem(p, false) {
		{ children... }
	}
}

// TUI renders the item for cells.Screen.
templ TUI(p Props) {
	@renderItem(p, true) {
		{ children... }
	}
}

templ renderItem(p Props, tui bool) {
	if isLinked(p.Attrs) {
		<a
			data-slot="item"
			if tui {
				data-mode="tui"
			}
			if v := itemVariant(p); v != "" {
				data-variant={ v }
			}
			if p.Size != "" {
				data-size={ string(p.Size) }
			}
			if needsTabIndex(p.Attrs) {
				tabindex="0"
			}
			class={ util.JoinClass("item", p.Class) }
			{ p.Attrs... }
		>
			{ children... }
		</a>
	} else {
		<div
			data-slot="item"
			if tui {
				data-mode="tui"
			}
			if v := itemVariant(p); v != "" {
				data-variant={ v }
			}
			if p.Size != "" {
				data-size={ string(p.Size) }
			}
			class={ util.JoinClass("item", p.Class) }
			{ p.Attrs... }
		>
			{ children... }
		</div>
	}
}

// Group renders a vertical group of Items separated by <hr/>.
templ Group(p GroupProps) {
	<div
		data-slot="item-group"
		if surfui.ModeOf(ctx) != surfui.ModeHotty {
			data-mode="tui"
		}
		class={ util.JoinClass("item-group", p.Class) }
		{ p.Attrs... }
	>
		{ children... }
	</div>
}

func itemVariant(p Props) string {
	if p.Muted {
		return "muted"
	}
	return string(p.Variant)
}

func isLinked(a templ.Attributes) bool {
	if a == nil {
		return false
	}
	if _, ok := a["href"]; ok {
		return true
	}
	if on, ok := a["data-on"].(string); ok {
		for _, tok := range strings.Fields(on) {
			if tok == "click" {
				return true
			}
		}
	}
	return false
}

func needsTabIndex(a templ.Attributes) bool {
	if a == nil {
		return false
	}
	if _, ok := a["href"]; ok {
		return false
	}
	_, hasTab := a["tabindex"]
	return !hasTab
}
