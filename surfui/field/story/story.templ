// Package story provides the storybook showcase for ui/field.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui/checkbox"
	"neuroplast.io/hotty-surf/surfui/field"
	"neuroplast.io/hotty-surf/surfui/input"
	"neuroplast.io/hotty-surf/surfui/label"
	uiswitch "neuroplast.io/hotty-surf/surfui/switch"
)

type state struct {
	username  string
	marketing bool
	street    string
	city      string
	email     string
	phone     string
	hardDisks bool
	external  bool
}

// Register adds field's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "field/default",
		Doc:          "Vertical and horizontal fields, fieldset, checkbox group, and separator",
		Consolidated: true,
		View:         func() templ.Component { return showcase(&state{hardDisks: true}) },
	})
}

templ showcase(s *state) {
	<div class="p-4 max-w-md flex flex-col gap-4">
		@field.View(field.Props{}) {
			@label.View(label.Props{For: "username"}) { Username }
			@input.View(input.Props{ID: "username", Value: s.username, Placeholder: "ada", OnInput: func(v string) { s.username = v }})
			<p>Your public name, shown on your profile.</p>
		}
		@field.View(field.Props{Orientation: field.Horizontal}) {
			<section>
				@label.View(label.Props{For: "marketing"}) { Marketing emails }
				<p>News about products and features.</p>
			</section>
			@uiswitch.View(uiswitch.Props{ID: "marketing", Checked: s.marketing, OnChange: func(b bool) { s.marketing = b }})
		}
		@field.Set(field.SetProps{}) {
			<legend>Show on the desktop</legend>
			<div role="group">
				@field.View(field.Props{Orientation: field.Horizontal}) {
					@checkbox.View(checkbox.Props{ID: "hard-disks", Checked: s.hardDisks, OnChange: func(b bool) { s.hardDisks = b }})
					@label.View(label.Props{For: "hard-disks"}) { Hard disks }
				}
				@field.View(field.Props{Orientation: field.Horizontal}) {
					@checkbox.View(checkbox.Props{ID: "external-disks", Checked: s.external, OnChange: func(b bool) { s.external = b }})
					@label.View(label.Props{For: "external-disks"}) { External disks }
				}
			</div>
		}
		@field.Set(field.SetProps{}) {
			<legend>Contact</legend>
			@field.View(field.Props{}) {
				@label.View(label.Props{For: "email"}) { Email }
				@input.View(input.Props{ID: "email", Type: "email", Value: s.email, OnInput: func(v string) { s.email = v }})
			}
			@field.Separator(field.SeparatorProps{}) { Or }
			@field.View(field.Props{}) {
				@label.View(label.Props{For: "phone"}) { Phone }
				@input.View(input.Props{ID: "phone", Type: "tel", Value: s.phone, OnInput: func(v string) { s.phone = v }})
			}
		}
	</div>
}
