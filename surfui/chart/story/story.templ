// Package story provides the storybook showcase for ui/chart.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui/chart"
)

var (
	months = []string{"Jan", "Feb", "Mar", "Apr", "May", "Jun"}
	visits = []chart.Series{
		{Label: "Desktop", Values: []float64{186, 305, 237, 73, 209, 214}},
		{Label: "Mobile", Values: []float64{80, 200, 120, 190, 130, 140}},
	}
	browser = chart.Props{
		Type:   "pie",
		Labels: []string{"Arc", "Firefox", "Safari", "Edge", "Other"},
		Series: []chart.Series{{Label: "Visitors", Values: []float64{275, 200, 187, 173, 90}}},
		Attrs:  templ.Attributes{"aria-label": "Visitors by browser"},
	}
)

// Register adds chart's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "chart/default",
		Doc:          "Bar, line, and pie charts with legends",
		Consolidated: true,
		View:         func() templ.Component { return showcase() },
	})
}

templ showcase() {
	<div class="p-4 flex flex-col gap-4 max-w-md">
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted-foreground">Bar chart with legend</span>
			@chart.View(chart.Props{Labels: months, Series: visits, Legend: true, Attrs: templ.Attributes{"aria-label": "Visitors by month"}})
		</div>
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted-foreground">Line chart</span>
			@chart.View(chart.Props{Type: "line", Labels: months, Series: visits, Aspect: 3, Attrs: templ.Attributes{"aria-label": "Visitors trend"}})
		</div>
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted-foreground">Pie chart</span>
			@chart.View(browser)
		</div>
	</div>
}
