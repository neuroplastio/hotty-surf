// Package chart is hotty-surf's self-contained SVG Chart component (bar, line, pie).
package chart

import (
	"context"
	"fmt"
	"math"
	"strconv"
	"strings"

	"neuroplast.io/hotty-surf/internal/core/rt"
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/util"
)

// Register registers chart's assets with r.
func Register(r *surfui.Registry) {}

// Series is one data series in a Chart.
type Series struct {
	Label  string
	Values []float64
}

// Props configures a Chart.
type Props struct {
	Type   string
	Labels []string
	Series []Series
	Legend bool
	Aspect float64
	Attrs  templ.Attributes
	Class  string
}

const chartW = 640.0

func chartH(p Props) float64 {
	if p.Aspect > 0 && !math.IsInf(p.Aspect, 0) {
		return chartW / p.Aspect
	}
	return 360
}

func chartBox(p Props) string { return "0 0 " + num(chartW) + " " + num(chartH(p)) }

func chartRatio(p Props) templ.SafeCSS {
	if p.Aspect <= 0 || math.IsInf(p.Aspect, 0) || math.IsNaN(p.Aspect) {
		return "min-width: 0;"
	}
	return templ.SafeCSS("min-width: 0; aspect-ratio: " + num(chartW) + " / " + num(chartH(p)) + ";")
}

func checkChart(ctx context.Context, p Props) string {
	if p.Aspect < 0 || math.IsNaN(p.Aspect) || math.IsInf(p.Aspect, 0) {
		rt.Fault(ctx, fmt.Sprintf("chart.View: Aspect %v", p.Aspect))
	}
	if p.Type == "pie" && len(p.Series) != 1 {
		rt.Fault(ctx, fmt.Sprintf("chart.View: a pie has one series, not %d", len(p.Series)))
	}
	for _, s := range p.Series {
		if len(s.Values) != len(p.Labels) {
			rt.Fault(ctx, fmt.Sprintf("chart.View: series %q has %d values for %d labels", s.Label, len(s.Values), len(p.Labels)))
		}
		for _, v := range s.Values {
			if math.IsNaN(v) || math.IsInf(v, 0) {
				rt.Fault(ctx, fmt.Sprintf("chart.View: series %q has %v", s.Label, v))
			} else if p.Type == "pie" && v < 0 {
				rt.Fault(ctx, fmt.Sprintf("chart.View: a pie's slice is %v, below 0", v))
			}
		}
	}
	return ""
}

func chartColour(i int) string {
	return "var(--chart-" + strconv.Itoa(i%5+1) + ")"
}

type chartKey struct {
	Label string
	Style templ.SafeCSS
}

func chartKeys(p Props) []chartKey {
	var ks []chartKey
	key := func(i int, l string) {
		ks = append(ks, chartKey{l, templ.SafeCSS("--chart-indicator-color: " + chartColour(i) + ";")})
	}
	if p.Type == "pie" {
		for i, l := range p.Labels {
			key(i, l)
		}
		return ks
	}
	for i, s := range p.Series {
		key(i, s.Label)
	}
	return ks
}

func chartPlot(p Props) templ.Component {
	var b strings.Builder
	n := len(p.Labels)
	ok := n > 0
	for _, s := range p.Series {
		for _, v := range s.Values {
			ok = ok && !math.IsNaN(v) && !math.IsInf(v, 0)
		}
		ok = ok && len(s.Values) == n
	}
	if ok {
		switch p.Type {
		case "pie":
			if len(p.Series) > 0 {
				piePlot(&b, p.Series[0].Values, chartH(p))
			}
		default:
			barPlot(&b, p)
		}
	}
	return templ.Raw(b.String())
}

func num(v float64) string { return strconv.FormatFloat(math.Round(v*100)/100, 'f', -1, 64) }

func barPlot(b *strings.Builder, p Props) {
	lo, hi := 0.0, 0.0
	for _, s := range p.Series {
		for _, v := range s.Values {
			lo, hi = min(lo, v), max(hi, v)
		}
	}
	if hi == lo {
		hi = lo + 1
	}
	top, bottom := 8.0, chartH(p)-2
	y := func(v float64) float64 { return bottom - (v-lo)/(hi-lo)*(bottom-top) }
	for i := range 5 {
		gy := top + float64(i)*(bottom-top)/4
		fmt.Fprintf(b, `<line x1="0" x2="%s" y1="%s" y2="%s" style="stroke: var(--border); stroke-width: 2;"/>`, num(chartW), num(gy), num(gy))
	}
	n := len(p.Labels)
	band := chartW / float64(n)
	if p.Type == "line" {
		for si, s := range p.Series {
			var pts, vals []string
			for i, v := range s.Values {
				pts = append(pts, num((float64(i)+0.5)*band)+","+num(y(v)))
				vals = append(vals, num(v))
			}
			fmt.Fprintf(b, `<polyline points="%s" data-values="%s" style="fill: none; stroke: %s; stroke-width: 4; stroke-linejoin: round; stroke-linecap: round;"/>`, strings.Join(pts, " "), strings.Join(vals, " "), chartColour(si))
		}
		return
	}
	k := float64(len(p.Series))
	gap := band * 0.2
	w := (band - 2*gap) / k
	for si, s := range p.Series {
		for i, v := range s.Values {
			y0, y1 := y(max(v, 0)), y(min(v, 0))
			fmt.Fprintf(b, `<rect x="%s" y="%s" width="%s" height="%s" rx="6" data-value="%s" style="fill: %s;"/>`,
				num(float64(i)*band+gap+float64(si)*w+1), num(y0), num(max(w-2, 1)), num(max(y1-y0, 0)), num(v), chartColour(si))
		}
	}
}

func piePlot(b *strings.Builder, vs []float64, h float64) {
	sum := 0.0
	for _, v := range vs {
		sum += v
	}
	if sum <= 0 {
		return
	}
	cx, cy, r := chartW/2, h/2, min(chartW, h)/2-4
	a := -math.Pi / 2
	for i, v := range vs {
		if v <= 0 {
			continue
		}
		if v == sum {
			fmt.Fprintf(b, `<circle cx="%s" cy="%s" r="%s" data-value="%s" style="fill: %s;"/>`, num(cx), num(cy), num(r), num(v), chartColour(i))
			return
		}
		d := v / sum * 2 * math.Pi
		large := 0
		if d > math.Pi {
			large = 1
		}
		fmt.Fprintf(b, `<path d="M%s %sL%s %sA%s %s 0 %d 1 %s %sZ" data-value="%s" style="fill: %s; stroke: var(--background); stroke-width: 2;"/>`,
			num(cx), num(cy), num(cx+r*math.Cos(a)), num(cy+r*math.Sin(a)), num(r), num(r), large,
			num(cx+r*math.Cos(a+d)), num(cy+r*math.Sin(a+d)), num(v), chartColour(i))
		a += d
	}
}

// View renders the chart plot, axis labels, and optional legend.
templ View(p Props) {
	{{ checkChart(ctx, p) }}
	<div
		data-slot="chart"
		if surfui.ModeOf(ctx) != surfui.ModeHotty {
			data-mode="tui"
		}
		role="figure"
		class={ util.JoinClass("grid gap-2", p.Class) }
		{ p.Attrs... }
	>
		<div class="chart" style={ chartRatio(p) }>
			<svg class="size-full" viewBox={ chartBox(p) } aria-hidden="true">
				@chartPlot(p)
			</svg>
		</div>
		if p.Type != "pie" && len(p.Labels) > 0 {
			<div class="flex text-xs text-muted-foreground" style="min-width: 0; overflow: hidden;" aria-hidden="true">
				for _, l := range p.Labels {
					<span class="flex-1 text-center" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{ l }</span>
				}
			</div>
		}
		if p.Legend || p.Type == "pie" {
			<div class="chart-legend">
				for _, k := range chartKeys(p) {
					<span class="chart-legend-item">
						<span class="chart-legend-indicator" style={ k.Style }></span>
						{ k.Label }
					</span>
				}
			</div>
		}
	</div>
}
