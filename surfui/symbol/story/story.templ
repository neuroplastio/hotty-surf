// Package story provides the storybook showcase for ui/symbol.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui/symbol"
)

// Props is the editable symbol gallery state.
type Props struct{ Class string }

// Register adds symbol's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "symbols/default",
		Doc:          "Material Symbols, as the kit draws them",
		Consolidated: true,
		BookOnly:     true,
		View:         func() templ.Component { return showcase(&Props{Class: "size-5"}) },
		Props: func() (any, templ.Component) {
			p := &Props{Class: "size-5"}
			return p, showcase(p)
		},
	})
}

templ showcase(p *Props) {
	<div class="book-symbol-grid">
		for _, s := range symbol.All() {
			<div class="flex flex-col items-center gap-1 rounded-md border p-2">
				@symbol.View(s.Shape, p.Class)
				<span class="text-muted-foreground text-xs">{ s.Name }</span>
			</div>
		}
	</div>
}
