// Package tooltip is hotty-surf's self-contained Tooltip component, with
// explicit renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package tooltip

import (
	"context"
	_ "embed"

	"neuroplast.io/hotty-surf"
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/util"
)

//go:embed tooltip.css
var css string

// Register registers tooltip's assets with r.
func Register(r *surfui.Registry) { r.CSS("tooltip", css) }

// Side is where the tooltip sits beside its target.
type Side string

const (
	Top         Side = "top"
	Bottom      Side = "bottom"
	Left        Side = "left"
	Right       Side = "right"
	InlineStart Side = "inline-start"
	InlineEnd   Side = "inline-end"
)

// Align is how the tooltip aligns along its side.
type Align string

const (
	Center Align = "center"
	Start  Align = "start"
	End    Align = "end"
)

// Props are a Tooltip's attributes.
type Props struct {
	// Text is the tooltip text.
	Text string
	// Side is Top (default), Bottom, Left, Right, InlineStart, or InlineEnd.
	Side Side
	// Align is Center (default), Start, or End.
	Align Align
	// Arrow shows Basecoat's arrow in Hotty mode.
	Arrow bool
	// Attrs are additional wrapper attributes.
	Attrs templ.Attributes
	// Class adds CSS classes to the wrapper.
	Class string
}

// View dispatches to Hotty or TUI according to surfui.ModeOf(ctx).
templ View(p Props) {
	switch surfui.ModeOf(ctx) {
	case surfui.ModeHotty:
		@Hotty(p) {
			{ children... }
		}
	default:
		@TUI(p) {
			{ children... }
		}
	}
}

// Hotty renders Basecoat's CSS tooltip wrapper for a hotty host.
templ Hotty(p Props) {
	<span
		data-slot="tooltip"
		data-tooltip={ p.Text }
		if p.Side != "" {
			data-side={ string(p.Side) }
		}
		if p.Align != "" {
			data-align={ string(p.Align) }
		}
		if p.Arrow {
			data-arrow=""
		}
		if p.Class != "" {
			class={ p.Class }
		}
		{ p.Attrs... }
	>
		{ children... }
	</span>
}

// TUI renders the tooltip wrapper for cells.Screen, which shows the tooltip
// on pointer hover beside the target (flipping sides when near an edge).
templ TUI(p Props) {
	{{ attrs := tuiAttrs(ctx, p) }}
	<span
		data-slot="tooltip"
		data-mode="tui"
		data-tooltip={ p.Text }
		if p.Side != "" {
			data-side={ string(p.Side) }
		}
		if p.Align != "" {
			data-align={ string(p.Align) }
		}
		if p.Arrow {
			data-arrow=""
		}
		if p.Class != "" {
			class={ p.Class }
		}
		{ attrs... }
	>
		{ children... }
	</span>
}

func tuiAttrs(ctx context.Context, p Props) templ.Attributes {
	var on templ.Attributes
	if p.Text != "" && p.Attrs["id"] == nil {
		on = surf.On(ctx, "")
	}
	return util.MergeAttrs(on, p.Attrs)
}
