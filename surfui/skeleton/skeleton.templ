// Package skeleton is hotty-surf's self-contained Skeleton component, with
// explicit renderers for Hotty and TUI modes (ANSI and Plain fall back to TUI).
package skeleton

import (
	"neuroplast.io/hotty-surf/surfui"
	"neuroplast.io/hotty-surf/surfui/util"
)

// Register registers skeleton's assets with r.
func Register(r *surfui.Registry) {}

// Props configures a Skeleton loading placeholder.
type Props struct {
	Attrs templ.Attributes
	Class string
}

// View dispatches to Hotty or TUI according to surfui.ModeOf(ctx).
templ View(p Props) {
	switch surfui.ModeOf(ctx) {
	case surfui.ModeHotty:
		@Hotty(p) {
			{ children... }
		}
	default:
		@TUI(p) {
			{ children... }
		}
	}
}

// Hotty renders Basecoat's skeleton placeholder for a hotty host.
templ Hotty(p Props) {
	<div data-slot="skeleton" class={ util.JoinClass("skeleton", p.Class) } { p.Attrs... }>
		{ children... }
	</div>
}

// TUI renders the skeleton placeholder for cells.Screen (pulsing ░ block in
// TUI/ANSI, static ░ block in Plain).
templ TUI(p Props) {
	if surfui.ModeOf(ctx) == surfui.ModePlain {
		<div data-slot="skeleton" class={ util.JoinClass("skeleton", p.Class) } { p.Attrs... }>
			{ children... }
		</div>
	} else {
		<div data-slot="skeleton" data-mode="tui" class={ util.JoinClass("skeleton", p.Class) } { p.Attrs... }>
			{ children... }
		</div>
	}
}
