// Package story provides the storybook showcase for ui/skeleton.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui/skeleton"
)

// Register adds skeleton's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "skeleton/default",
		Doc:          "A skeleton of a round picture and two lines",
		Consolidated: true,
		Score:        4,
		View:         func() templ.Component { return showcase() },
	})
}

templ showcase() {
	<div class="p-4 flex flex-col gap-4 max-w-sm">
		<div class="card p-4 flex flex-col gap-3">
			<div class="flex items-center gap-3">
				@skeleton.View(skeleton.Props{Attrs: templ.Attributes{"style": "width: 2.5rem; height: 2.5rem; border-radius: 9999px;"}})
				<div class="flex flex-col gap-2 flex-1">
					@skeleton.View(skeleton.Props{Attrs: templ.Attributes{"style": "width: 140px; height: 1rem;"}})
					@skeleton.View(skeleton.Props{Attrs: templ.Attributes{"style": "width: 90px; height: 0.75rem;"}})
				</div>
			</div>
			@skeleton.View(skeleton.Props{Attrs: templ.Attributes{"style": "width: 100%; height: 6rem; border-radius: 0.5rem;"}})
			<div class="flex flex-col gap-2">
				@skeleton.View(skeleton.Props{Attrs: templ.Attributes{"style": "width: 100%; height: 0.875rem;"}})
				@skeleton.View(skeleton.Props{Attrs: templ.Attributes{"style": "width: 85%; height: 0.875rem;"}})
				@skeleton.View(skeleton.Props{Attrs: templ.Attributes{"style": "width: 60%; height: 0.875rem;"}})
			</div>
			<div class="flex items-center gap-2">
				@skeleton.View(skeleton.Props{Attrs: templ.Attributes{"style": "width: 5rem; height: 2rem; border-radius: 0.375rem;"}})
				@skeleton.View(skeleton.Props{Attrs: templ.Attributes{"style": "width: 4rem; height: 2rem; border-radius: 0.375rem;"}})
			</div>
		</div>
	</div>
}
