// Package story provides the storybook showcase for ui/label.
package story

import (
	"neuroplast.io/hotty-surf/internal/book/story"
	"neuroplast.io/hotty-surf/surfui/icon"
	"neuroplast.io/hotty-surf/surfui/field"
	"neuroplast.io/hotty-surf/surfui/input"
	"neuroplast.io/hotty-surf/surfui/label"
	"neuroplast.io/hotty-surf/surfui/tooltip"
)

type state struct {
	text string
}

// Register adds label's stories to r.
func Register(r *story.Registry) {
	r.Add(story.Story{
		ID:           "label/default",
		Doc:          "Labels paired with enabled and disabled inputs",
		Consolidated: true,
		Score:        5,
		View:         func() templ.Component { return showcase(&state{}) },
	})
}

templ showcase(s *state) {
	<div class="flex flex-col gap-4 p-4 max-w-sm">
		<div class="flex flex-col gap-2">
			<div class="flex items-center gap-2">
				@label.View(label.Props{For: "username"}) {
					Username
				}
				@tooltip.View(tooltip.Props{Text: "Lowercase letters, numbers, and hyphens only", Side: tooltip.Right}) {
					<span class="text-muted-foreground">
						@icon.View("circle-help", "size-4")
					</span>
				}
			</div>
			@input.View(input.Props{ID: "username", Value: s.text, OnInput: func(v string) { s.text = v }})
		</div>
		@field.View(field.Props{Disabled: true}) {
			@label.View(label.Props{For: "username-disabled"}) {
				Disabled username
			}
			@input.View(input.Props{ID: "username-disabled", Value: "ada", Disabled: true})
		}
	</div>
}
