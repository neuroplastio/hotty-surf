<!-- A palette: the colours this template's data may name. Hex is written
     here and nowhere else. cells is the terminal colour the cells draw a
     hue in; teal's is its own, coral's and plum's are the nearest by hue. -->
<palette>
  <hue name="coral" dark="#ff8e7a" light="#b4321f" cells="9"/>
  <hue name="teal" dark="#4fd1c5" light="#0f766e" cells="6"/>
  <hue name="plum" dark="#c9a0ff" light="#6b3fa0"/>
</palette>
<surface>
  <heading>{{ title }}</heading>
  <row gap="1" key="lit">
    <dot hue="coral"/>
    <text hue="coral">a literal hue</text>
  </row>
  <row :each="h in hands" :key="h.name" gap="1" @click="recolour(h.name)">
    <dot :hue="h.colour"/>
    <text :hue="h.colour">{{ h.name }}</text>
  </row>
</surface>
