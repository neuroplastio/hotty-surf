<box key="panel" :popover="open">
  <row gap="1">
    <switch :on="open" @click="toggle" label="Open"/>
    <text>{{ open ? title : 'closed' }}</text>
    <icon svg="mark"/>
    <button label="Toggle" @click="toggle" key="toggle"><icon :svg="open ? 'mark' : 'ring'"/></button>
    <dot key="busy" tone="ok" :pulse="open"/>
  </row>
</box>
