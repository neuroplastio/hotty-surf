<!-- A component chosen as the frame runs, drawn by its own Render: shown
     keyed, and gone while hidden. -->
<surface>
  <row gap="1" key="head">
    <heading>{{ title }}</heading>
    <button @click="hide" key="hide" :count="hidden ? 0 : count" :count-dot="hidden" count-tone="warn"><icon :name="hidden ? 'eye-outline' : 'eye-off-outline'"/>{{ hidden ? 'Show' : 'Hide' }}</button>
  </row>
  <embed :of="inset()" key="inset"/>
  <embed :if="hidden" :of="inset()" key="never"/>
  <frame-tab key="tab" :on="hidden" label="Tab"/>
  <frame-tab key="notab" :on="false" label=""/>
  <text muted key="count">{{ count }} added</text>
</surface>
