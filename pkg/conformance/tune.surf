<surface>
  <row key="replicas" gap="1">
    <text key="label">Replicas</text>
    <slider key="slider" min="1" max="12" :value="replicas" @input="input($value)" @change="commit($value)"/>
    <text key="shown" muted>{{ replicas }}</text>
  </row>
  <row key="filters" chips gap="1">
    <button key="errors" :selected="isPicked('errors')" @click="toggle('errors')">Errors</button>
    <button key="warnings" :selected="isPicked('warnings')" @click="toggle('warnings')">Warnings</button>
    <button key="slow" :selected="isPicked('slow')" @click="toggle('slow')">Slow</button>
  </row>
  <row key="layout" justify="between" align="end">
    <text key="bare" grow>a</text>
    <text key="three" grow="3">b</text>
    <text key="off" :grow="replicas > 99">c</text>
    <text key="on" :grow="replicas > 0">d</text>
    <text key="by" :grow="replicas">e</text>
    <grow-part key="dyn" :w="replicas"/>
  </row>
  <stack key="side" justify="end" :align="'center'">
    <text key="f">f</text>
  </stack>
</surface>
