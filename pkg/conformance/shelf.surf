<surface>
  <row gap="1" key="head">
    <heading>{{ title }}</heading>
    <spacer/>
    <face key="load" icon="layers-outline" :value="string(size(panels))" unit="panels" :meter="size(panels) * 25" :stale="size(panels) == 0" tone="ok"/>
    <face key="own" @click="add"><dot tone="ok"/><text>{{ size(panels) }} live</text></face>
    <button key="add" @click="add">Add</button>
    <button key="drop" @click="drop">Drop</button>
  </row>
  <info-panel key="main" :state="dyn(panel)"/>
  <info-panel :each="p in panels" :key="p.title" :state="dyn(p)"/>
  <info-panel key="wrong" :state="dyn(title)"/>
  <text muted key="status">{{ size(panels) }} panels</text>
</surface>
